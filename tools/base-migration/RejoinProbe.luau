local Http=game:GetService('HttpService')
local CS=game:GetService('CollectionService')
local Server=game.ServerScriptService.Server
local PB=require(Server.Systems.PlayerBaseSystem)
local BS=require(Server.Systems.BaseStorageSystem)
local Income=require(Server.Systems.BrainrotIncomeSystem)
local Plaques=require(Server.Systems.BaseIncomePlaqueSystem)
local Lifecycle=require(Server.Services.PlayerWorldLifecycle)
local Profile=require(Server.Services.PlayerDataService)
local Carts=require(Server.Services.CartService)
local Shield=require(Server.Services.CartShieldService)
local Team=require(Server.Services.ChariotTeamService)
local Boundary=require(Server.Utility.CartShieldBaseBoundary)
local out={passed=true,checks=0,failures={},bases={},players={},counts={registeredBases=0,platforms=0,placementMarkers=0,plaques=0,ownershipSigns=0,artMeshes=0,hiddenAnchors=0}}
local function check(ok,msg) out.checks+=1 if not ok then out.passed=false table.insert(out.failures,msg) end end
local folder=workspace.MapBlockout.PlayerBasePatches
local bases=PB:GetRegisteredBases()
out.counts.registeredBases=#bases
check(#bases==12,'expected 12 registered bases')
local ids={}
for _,base in bases do
 local id=base:GetAttribute('BaseId') ids[id]=true
 check(base.Parent==folder and base.Name==id and base:GetAttribute('AuthoredBaseLayout')==true,id..': sole authored base')
 local slots=BS:GetRegisteredPlatforms(base) or {}
 local plaques=Plaques:GetPlaques(base)
 check(#slots==12,id..':12 registered storage slots') check(#plaques==12,id..':12 owner-bound counter records')
 local foundation=base:FindFirstChild('Foundation')
 check(foundation and foundation.CanCollide and foundation.CanQuery,id..':Foundation support')
 local byIndex={} for _,plaque in plaques do byIndex[plaque:GetAttribute('PlatformId')]=plaque end
 local row={id=id,platforms=#slots,plaques=#plaques,owner=base:GetAttribute('OwnerUserId') or 0}
 for _,slot in slots do
  local platform,marker=slot.Platform,slot.Marker
  check(platform.Parent==base and platform.Name==string.format('Slot_%02d',slot.Index),id..':direct stable platform')
  check(marker.Parent==platform and marker.Name=='BrainrotPlacement',id..':direct placement marker')
  out.counts.platforms+=1 out.counts.placementMarkers+=1
  local plaque=byIndex[slot.Index]
  if plaque then
   out.counts.plaques+=1
   check(plaque:IsDescendantOf(base) and CS:HasTag(plaque,'BrainrotIncomePlaque'),id..':counter belongs to new base')
   check(plaque:GetAttribute('BaseId')==id and plaque:GetAttribute('BaseOwnerUserId')==(row.owner or 0),id..':counter owner binding')
   local gui=plaque:FindFirstChild('AmountSurfaceGui') local label=gui and gui:FindFirstChild('AmountLabel')
   local sensor=plaque:FindFirstChild('TouchSensor')
   check(gui and gui:IsA('SurfaceGui') and label and label:IsA('TextLabel'),id..':counter amount view')
   check(sensor and sensor:IsA('BasePart') and sensor.CanTouch and not sensor.CanCollide and not sensor.CanQuery and sensor.Transparency==1,id..':claim sensor flags')
   local inward=Vector3.new(platform.CFrame.LookVector.X,0,platform.CFrame.LookVector.Z).Unit
