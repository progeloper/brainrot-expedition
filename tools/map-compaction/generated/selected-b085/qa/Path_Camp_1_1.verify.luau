        for i,triangle in ipairs(row.triangles) do
            local x,y,z=0,0,0
            for _,e in ipairs(triangle) do x+=e[1]/3;y+=e[2]/3;z+=e[3]/3 end
            local key=bucket(x,y,z);bins[key]=bins[key] or {};table.insert(bins[key],i)
        end
        local matched,referencedVertices={},{}
