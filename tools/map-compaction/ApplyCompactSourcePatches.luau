local PAYLOAD = HttpService:JSONDecode([[{"patches":[{"path":"ReplicatedStorage.Shared.Config.BaseLayoutConfig","beforeSHA256":"fec81ec990b6f2837150781feaef1f90055adf336b2987ae440a22e128cf332e","afterSHA256":"9189c6db7f0d570f9f6de286c52f34ff8c31ba5102da930432b23c21fbcb1159","beforeBytes":1078,"afterBytes":1394,"proposal":"docs/map-compaction/source-patches/proposals/ReplicatedStorage/Shared/Config/BaseLayoutConfig.lua","diff":"docs/map-compaction/source-patches/diffs/ReplicatedStorage/Shared/Config/BaseLayoutConfig.diff","beforeSource":"--!strict\n\n-- The 36-by-32-stud footprint is a project visual estimate derived from the\n-- compact reference layout, not an official published dimension.\nlocal BaseLayoutConfig = {\n\tSTANDARD_ROBLOX_PLAYER_HEIGHT_STUDS = 5.0,\n\tBRAINROT_TARGET_VISIBLE_HEIGHT_STUDS = 3.5,\n\tPLATFORM_DIAGONAL_STUDS = 3.0,\n\tPLATFORM_SIDE_STUDS = 3 / math.sqrt(2),\n\n\tBASE_FOOTPRINT_WIDTH_STUDS = 36,\n\tBASE_FOOTPRINT_DEPTH_STUDS = 32,\n\tBASE_WALL_HEIGHT_STUDS = 10,\n\tBASE_WALL_THICKNESS_STUDS = 1,\n\tPLATFORM_COUNT = 12,\n\tPLATFORMS_PER_SIDE = 6,\n\tPLATFORM_ROW_OFFSET_X = 7.25,\n\tPLATFORM_Z_CENTERS = table.freeze({ -11.25, -6.75, -2.25, 2.25, 6.75, 11.25 }),\n\n\tPLAQUE_INWARD_DEPTH_STUDS = 1.75,\n\tPLAQUE_TANGENTIAL_WIDTH_STUDS = 3.0,\n\tPLAQUE_HEIGHT_STUDS = 0.20,\n\tPLAQUE_PLATFORM_GAP_STUDS = 0.25,\n\tPLAQUE_VISIBLE_RISE_STUDS = 0.03,\n\t-- The visible plaque remains flush and non-colliding. This invisible vertical\n\t-- contact envelope reaches ordinary avatar feet, which rest above the floor.\n\tPLAQUE_TOUCH_HEIGHT_STUDS = 1.0,\n\tPLAQUE_TOUCH_COOLDOWN_SECONDS = 0.5,\n}\n\nreturn table.freeze(BaseLayoutConfig)\n","afterSource":"--!strict\n\nlocal CompactMapGeometry = require(game:GetService(\"ReplicatedStorage\").Shared.Utility.CompactMapGeometry)\n\n-- The 36-by-32-stud footprint is a project visual estimate derived from the\n-- compact reference layout, not an official published dimension.\nlocal BaseLayoutConfig = {\n\tSTANDARD_ROBLOX_PLAYER_HEIGHT_STUDS = 5.0,\n\tBRAINROT_TARGET_VISIBLE_HEIGHT_STUDS = 3.5,\n\tPLATFORM_DIAGONAL_STUDS = 3.0,\n\tPLATFORM_SIDE_STUDS = 3 / math.sqrt(2),\n\n\tBASE_FOOTPRINT_WIDTH_STUDS = 36,\n\tBASE_FOOTPRINT_DEPTH_STUDS = 32,\n\tBASE_WALL_HEIGHT_STUDS = 10,\n\tBASE_WALL_THICKNESS_STUDS = 1,\n\tPLATFORM_COUNT = 12,\n\tPLATFORMS_PER_SIDE = 6,\n\tPLATFORM_ROW_OFFSET_X = 7.25,\n\tPLATFORM_Z_CENTERS = table.freeze({ -11.25, -6.75, -2.25, 2.25, 6.75, 11.25 }),\n\n\tPLAQUE_INWARD_DEPTH_STUDS = 1.75,\n\tPLAQUE_TANGENTIAL_WIDTH_STUDS = 3.0,\n\tPLAQUE_HEIGHT_STUDS = 0.20,\n\tPLAQUE_PLATFORM_GAP_STUDS = 0.25,\n\tPLAQUE_VISIBLE_RISE_STUDS = 0.03,\n\t-- The visible plaque remains flush and non-colliding. This invisible vertical\n\t-- contact envelope reaches ordinary avatar feet, which rest above the floor.\n\tPLAQUE_TOUCH_HEIGHT_STUDS = 1.0,\n\tPLAQUE_TOUCH_COOLDOWN_SECONDS = 0.5,\n}\n\n-- Compact values are final evaluated locals; all original scale/economy constants remain unchanged.\nfunction BaseLayoutConfig.GetGeometry(base: Model): any?\n\treturn CompactMapGeometry.ResolveBase(base)\nend\n\nreturn table.freeze(BaseLayoutConfig)\n"},{"path":"ServerScriptService.Server.Systems.BaseIncomePlaqueSystem","beforeSHA256":"36abfff76ed6d107ae63c7fe0b72882f2de09d1840b784f1fe04153f71320574","afterSHA256":"6b47ba8517d8e4a4db56d6eda6f5ebee5873738bf7d4f35ce8b393108607e266","beforeBytes":32954,"afterBytes":35345,"proposal":"docs/map-compaction/source-patches/proposals/ServerScriptService/Server/Systems/BaseIncomePlaqueSystem.lua","diff":"docs/map-compaction/source-patches/diffs/ServerScriptService/Server/Systems/BaseIncomePlaqueSystem.diff","beforeSource":"--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal CollectionService = game:GetService(\"CollectionService\")\n\nlocal Config = require(ReplicatedStorage.Shared.Config.BaseLayoutConfig)\nlocal CurrencyFormatter = require(ReplicatedStorage.Shared.Utility.CurrencyFormatter)\nlocal Logger = require(ReplicatedStorage.Shared.Utility.Logger)\nlocal StaticMaterial = require(ReplicatedStorage.Shared.Utility.MapArtStaticMaterialPolicy)\nlocal PlayerBaseSystem = require(script.Parent.PlayerBaseSystem)\nlocal BaseStorageSystem = require(script.Parent.BaseStorageSystem)\nlocal BrainrotIncomeSystem = require(script.Parent.BrainrotIncomeSystem)\n\nlocal log = Logger.new(\"BaseIncomePlaqueSystem\")\nlocal PLAQUE_TAG = \"BrainrotIncomePlaque\"\nlocal LAYOUT_CONTAINER_NAME = \"Phase5DInterior\"\nlocal PLAQUE_CONTAINER_NAME = \"IncomePlaques\"\nlocal TOUCH_SENSOR_NAME = \"TouchSensor\"\nlocal AMOUNT_SURFACE_NAME = \"AmountSurfaceGui\"\nlocal AMOUNT_LABEL_NAME = \"AmountLabel\"\nlocal AMOUNT_STROKE_NAME = \"AmountStroke\"\nlocal PLAQUE_WIDTH_STUDS = 3.5\nlocal PLAQUE_THICKNESS_STUDS = 0.18\nlocal PLAQUE_DEPTH_STUDS = 2.25\nlocal PLAQUE_PLATFORM_GAP_STUDS = 0.55\nlocal PLAQUE_FLOOR_CLEARANCE_STUDS = 0.02\nlocal PLAQUE_SNAPSHOT_REFRESH_SECONDS = 1\nlocal PILLAR_MANAGED_BY = \"BaseIncomePlaqueSystem\"\nlocal PILLAR_ORIGINAL_WIDTH_STUDS = 1.25\nlocal PILLAR_ORIGINAL_DEPTH_STUDS = 1.25\nlocal PILLAR_WIDTH_STUDS = PILLAR_ORIGINAL_WIDTH_STUDS * 0.5\nlocal PILLAR_DEPTH_STUDS = PILLAR_ORIGINAL_DEPTH_STUDS * 0.5\nlocal PILLAR_MAX_SPACING_STUDS = 6\nlocal ENTRANCE_CLEAR_WIDTH_STUDS = 10\nlocal LEGACY_WALL_NAMES = table.freeze({ \"LeftWall\", \"RightWall\", \"BackWall\" })\n\nlocal BaseIncomePlaqueSystem = {}\nlocal started = false\nlocal initialDependencies: any? = nil\nlocal assignmentConnection: any? = nil\nlocal unsubscribeStorage: (() -> ())? = nil\nlocal snapshotConnection: RBXScriptConnection? = nil\nlocal snapshotAccumulator = 0\nlocal baseSystem: any = PlayerBaseSystem\nlocal storageSystem: any = BaseStorageSystem\nlocal incomeSystem: any = BrainrotIncomeSystem\nlocal clock = function(): number\n\treturn Workspace:GetServerTimeNow()\nend\nlocal getPlayerFromCharacter = function(character: Model): Player?\n\treturn Players:GetPlayerFromCharacter(character)\nend\nlocal getPlayerByUserId = function(userId: number): Player?\n\treturn Players:GetPlayerByUserId(userId)\nend\nlocal states: { [Model]: any } = {}\nlocal plaqueBindings: { [BasePart]: any } = {}\nlocal touchAttempts: { [Player]: { [string]: number } } = setmetatable({}, { __mode = \"k\" })\n\nlocal function getPlaqueName(platformId: number): string\n\treturn \"IncomePlaque_\" .. tostring(platformId)\nend\n\nlocal function platformIdFromPart(platform: BasePart): number?\n\tlocal attribute = platform:GetAttribute(\"SlotIndex\")\n\tif type(attribute) == \"number\" and attribute % 1 == 0 then\n\t\treturn attribute\n\tend\n\treturn tonumber(platform.Name:match(\"^Slot_(%d+)$\"))\nend\n\nlocal function baseRootCFrame(base: Model): CFrame\n\tlocal saved = base:GetAttribute(\"Phase5DLayoutPivot\")\n\tif typeof(saved) == \"CFrame\" then\n\t\treturn saved\n\tend\n\tlocal root = base:GetPivot()\n\tbase:SetAttribute(\"Phase5DLayoutPivot\", root)\n\treturn root\nend\n\nlocal function ensureFolder(parent: Instance, name: string): Folder\n\tlocal existing = parent:FindFirstChild(name)\n\tif existing then\n\t\tassert(existing:IsA(\"Folder\"), name .. \" must be a Folder\")\n\t\treturn existing\n\tend\n\tlocal folder = Instance.new(\"Folder\")\n\tfolder.Name = name\n\tfolder.Parent = parent\n\treturn folder\nend\n\nlocal function ensurePart(base: Model, container: Folder, name: string): (BasePart, boolean)\n\tlocal existing = base:FindFirstChild(name) or container:FindFirstChild(name)\n\tif existing then\n\t\tassert(existing:IsA(\"BasePart\"), name .. \" must be a BasePart\")\n\t\treturn existing, false\n\tend\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = name\n\tpart.Parent = container\n\treturn part, true\nend\n\nlocal function configureStructuralPart(part: BasePart)\n\tpart.Anchored = true\n\tpart.CanCollide = true\n\tpart.CanTouch = false\n\tpart.CanQuery = true\n\tStaticMaterial.Apply(part, Enum.Material.SmoothPlastic)\n\tpart.Color = Color3.fromRGB(91, 98, 104)\n\tpart.TopSurface = Enum.SurfaceType.Smooth\n\tpart.BottomSurface = Enum.SurfaceType.Smooth\nend\n\nlocal function platformTopLocalY(root: CFrame, platform: BasePart): number\n\treturn root:PointToObjectSpace(platform.Position).Y + platform.Size.Y / 2\nend\n\nlocal function entranceSign(base: Model, root: CFrame): number\n\tfor _, name in { \"CartSpawn\", \"PlayerSpawn\" } do\n\t\tlocal marker = base:FindFirstChild(name)\n\t\tif marker and marker:IsA(\"BasePart\") then\n\t\t\tlocal localZ = root:PointToObjectSpace(marker.Position).Z\n\t\t\tif math.abs(localZ) > 0.01 then\n\t\t\t\treturn if localZ > 0 then 1 else -1\n\t\t\tend\n\t\tend\n\tend\n\treturn -1\nend\n\ntype StructuralStyle = {\n\tColor: Color3,\n\tMaterial: Enum.Material,\n\tMaterialVariant: string,\n\tEffectivePhysicalProperties: PhysicalProperties,\n\tCollisionGroup: string,\n\tCanCollide: boolean,\n\tCanTouch: boolean,\n\tCanQuery: boolean,\n}\n\nlocal function captureStructuralStyle(part: BasePart): StructuralStyle\n\treturn {\n\t\tColor = part.Color,\n\t\tMaterial = part.Material,\n\t\tMaterialVariant = part.MaterialVariant,\n\t\tEffectivePhysicalProperties = part.CurrentPhysicalProperties,\n\t\tCollisionGroup = part.CollisionGroup,\n\t\tCanCollide = part.CanCollide,\n\t\tCanTouch = part.CanTouch,\n\t\tCanQuery = part.CanQuery,\n\t}\nend\n\nlocal function legacyWall(base: Model, container: Folder, name: string): BasePart?\n\tlocal candidate = base:FindFirstChild(name) or container:FindFirstChild(name)\n\treturn if candidate and candidate:IsA(\"BasePart\") then candidate else nil\nend\n\nlocal function removeLegacyWalls(base: Model, container: Folder)\n\tfor _, name in LEGACY_WALL_NAMES do\n\t\tlocal direct = base:FindFirstChild(name)\n\t\tif direct and direct:IsA(\"BasePart\") then\n\t\t\tdirect:Destroy()\n\t\tend\n\t\tlocal generated = container:FindFirstChild(name)\n\t\tif generated and generated:IsA(\"BasePart\") then\n\t\t\tgenerated:Destroy()\n\t\tend\n\tend\nend\n\nlocal function clearManagedPillars(container: Folder)\n\tfor _, child in container:GetChildren() do\n\t\tif child:IsA(\"BasePart\") and child:GetAttribute(\"ManagedBy\") == PILLAR_MANAGED_BY then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\nend\n\nlocal function createPillar(\n\tcontainer: Folder,\n\troot: CFrame,\n\tname: string,\n\tlocalPosition: Vector3,\n\tfloorTopY: number,\n\tpillarHeight: number,\n\tstyle: StructuralStyle\n)\n\tlocal pillar = Instance.new(\"Part\")\n\tpillar.Name = name\n\tpillar:SetAttribute(\"ManagedBy\", PILLAR_MANAGED_BY)\n\tconfigureStructuralPart(pillar)\n\tpillar.Size = Vector3.new(PILLAR_WIDTH_STUDS, pillarHeight, PILLAR_DEPTH_STUDS)\n\tpillar.CFrame = root\n\t\t* CFrame.new(localPosition.X, floorTopY + pillarHeight / 2, localPosition.Z)\n\tpillar.Color = style.Color\n\tpillar.Material = style.Material\n\tpillar.MaterialVariant = style.MaterialVariant\n\tpillar.CustomPhysicalProperties = style.EffectivePhysicalProperties\n\tpillar.CollisionGroup = style.CollisionGroup\n\tpillar.CanCollide = style.CanCollide\n\tpillar.CanTouch = style.CanTouch\n\tpillar.CanQuery = style.CanQuery\n\tStaticMaterial.Apply(pillar)\n\tpillar.Parent = container\nend\n\nlocal function createPillarsAlongEdge(\n\tcontainer: Folder,\n\troot: CFrame,\n\tfloorTopY: number,\n\tpillarHeight: number,\n\tstyle: StructuralStyle,\n\tedgeName: string,\n\tstartLocalPosition: Vector3,\n\tendLocalPosition: Vector3,\n\tshouldSkip: ((Vector3) -> boolean)?\n)\n\tlocal edgeLength = (endLocalPosition - startLocalPosition).Magnitude\n\tlocal intervalCount = math.max(1, math.ceil(edgeLength / PILLAR_MAX_SPACING_STUDS))\n\tlocal placedIndex = 0\n\tfor interval = 1, intervalCount - 1 do\n\t\tlocal localPosition = startLocalPosition:Lerp(endLocalPosition, interval / intervalCount)\n\t\tif not shouldSkip or not shouldSkip(localPosition) then\n\t\t\tplacedIndex += 1\n\t\t\tcreatePillar(\n\t\t\t\tcontainer,\n\t\t\t\troot,\n\t\t\t\tstring.format(\"BasePillar_%s_%02d\", edgeName, placedIndex),\n\t\t\t\tlocalPosition,\n\t\t\t\tfloorTopY,\n\t\t\t\tpillarHeight,\n\t\t\t\tstyle\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function createPerimeterPillars(\n\tbase: Model,\n\tcontainer: Folder,\n\troot: CFrame,\n\tfloorTopY: number,\n\tpillarHeight: number,\n\tstyle: StructuralStyle\n)\n\tclearManagedPillars(container)\n\t-- Preserve the established perimeter centreline while reducing only each\n\t-- pillar's horizontal cross-section.\n\tlocal halfWidth = (Config.BASE_FOOTPRINT_WIDTH_STUDS - PILLAR_ORIGINAL_WIDTH_STUDS) / 2\n\tlocal halfDepth = (Config.BASE_FOOTPRINT_DEPTH_STUDS - PILLAR_ORIGINAL_DEPTH_STUDS) / 2\n\tlocal frontZ = entranceSign(base, root) * halfDepth\n\tlocal backZ = -frontZ\n\tlocal frontLeft = Vector3.new(-halfWidth, 0, frontZ)\n\tlocal frontRight = Vector3.new(halfWidth, 0, frontZ)\n\tlocal backLeft = Vector3.new(-halfWidth, 0, backZ)\n\tlocal backRight = Vector3.new(halfWidth, 0, backZ)\n\n\tfor name, localPosition in\n\t\t{\n\t\t\tBasePillar_Corner_FL = frontLeft,\n\t\t\tBasePillar_Corner_FR = frontRight,\n\t\t\tBasePillar_Corner_BL = backLeft,\n\t\t\tBasePillar_Corner_BR = backRight,\n\t\t}\n\tdo\n\t\tcreatePillar(container, root, name, localPosition, floorTopY, pillarHeight, style)\n\tend\n\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Front\",\n\t\tfrontLeft,\n\t\tfrontRight,\n\t\tfunction(localPosition)\n\t\t\treturn math.abs(localPosition.X) < ENTRANCE_CLEAR_WIDTH_STUDS / 2\n\t\tend\n\t)\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Back\",\n\t\tbackLeft,\n\t\tbackRight,\n\t\tnil\n\t)\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Left\",\n\t\tfrontLeft,\n\t\tbackLeft,\n\t\tnil\n\t)\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Right\",\n\t\tfrontRight,\n\t\tbackRight,\n\t\tnil\n\t)\nend\n\nlocal function ensureInterior(base: Model, root: CFrame, platformFloorY: number): number\n\tlocal container = ensureFolder(base, LAYOUT_CONTAINER_NAME)\n\tlocal floor: BasePart? = nil\n\tfor _, name in { \"BaseFloor\", \"Floor\", \"InteriorFloor\", \"GroundFloor\" } do\n\t\tlocal candidate = base:FindFirstChild(name) or container:FindFirstChild(name)\n\t\tif candidate and candidate:IsA(\"BasePart\") then\n\t\t\tfloor = candidate\n\t\t\tbreak\n\t\tend\n\tend\n\tlocal createdFloor = false\n\tif not floor then\n\t\tfloor, createdFloor = ensurePart(base, container, \"BaseFloor\")\n\tend\n\tlocal resolvedFloor = floor :: BasePart\n\tlocal floorThickness = if createdFloor then 1 else math.max(resolvedFloor.Size.Y, 0.2)\n\tlocal floorTopY = if createdFloor\n\t\tthen platformFloorY\n\t\telse platformTopLocalY(root, resolvedFloor)\n\tconfigureStructuralPart(resolvedFloor)\n\tresolvedFloor.Size = Vector3.new(\n\t\tConfig.BASE_FOOTPRINT_WIDTH_STUDS,\n\t\tfloorThickness,\n\t\tConfig.BASE_FOOTPRINT_DEPTH_STUDS\n\t)\n\tresolvedFloor.CFrame = root * CFrame.new(0, floorTopY - floorThickness / 2, 0)\n\n\tlocal pillarStyle = captureStructuralStyle(resolvedFloor)\n\tlocal pillarHeight = Config.BASE_WALL_HEIGHT_STUDS\n\tfor _, wallName in LEGACY_WALL_NAMES do\n\t\tlocal wall = legacyWall(base, container, wallName)\n\t\tif wall then\n\t\t\tpillarStyle = captureStructuralStyle(wall)\n\t\t\tpillarHeight = wall.Size.Y\n\t\t\tbreak\n\t\tend\n\tend\n\tremoveLegacyWalls(base, container)\n\tcreatePerimeterPillars(base, container, root, floorTopY, pillarHeight, pillarStyle)\n\treturn floorTopY\nend\n\nlocal function setMarkerFacing(slot: any, platformCFrame: CFrame, markerOffset: CFrame)\n\tif slot.Marker:IsA(\"Attachment\") then\n\t\tslot.Marker.CFrame = CFrame.new(markerOffset.Position)\n\telse\n\t\tlocal marker = slot.Marker :: BasePart\n\t\tmarker.CFrame = platformCFrame * CFrame.new(markerOffset.Position)\n\tend\nend\n\nlocal function positionPlatforms(root: CFrame, slots: { any }): (any, number)\n\tlocal ordered = table.clone(slots)\n\ttable.sort(ordered, function(left, right)\n\t\treturn left.Index < right.Index\n\tend)\n\tassert(#ordered == Config.PLATFORM_COUNT, \"Phase 5D requires exactly 12 platforms\")\n\tlocal placementById = {}\n\tlocal floorY = math.huge\n\tfor order, slot in ordered do\n\t\tlocal platform = slot.Platform :: BasePart\n\t\tlocal platformId = platformIdFromPart(platform)\n\t\tassert(platformId == slot.Index, \"Platform stable ID changed during layout\")\n\t\tlocal topY = platformTopLocalY(root, platform)\n\t\tfloorY = math.min(floorY, topY - platform.Size.Y)\n\t\tlocal side = if order <= Config.PLATFORMS_PER_SIDE then -1 else 1\n\t\tlocal row = if side < 0 then order else order - Config.PLATFORMS_PER_SIDE\n\t\tlocal x = side * Config.PLATFORM_ROW_OFFSET_X\n\t\tlocal z = Config.PLATFORM_Z_CENTERS[row]\n\t\tlocal localPosition = Vector3.new(x, topY - platform.Size.Y / 2, z)\n\t\tlocal localFacing = CFrame.lookAt(\n\t\t\tlocalPosition,\n\t\t\tVector3.new(0, localPosition.Y, localPosition.Z),\n\t\t\tVector3.yAxis\n\t\t)\n\t\tlocal markerOffset = if slot.Marker:IsA(\"Attachment\")\n\t\t\tthen slot.Marker.CFrame\n\t\t\telse platform.CFrame:ToObjectSpace((slot.Marker :: BasePart).CFrame)\n\t\tplatform.Size =\n\t\t\tVector3.new(Config.PLATFORM_SIDE_STUDS, platform.Size.Y, Config.PLATFORM_SIDE_STUDS)\n\t\tplatform.CFrame = root * localFacing\n\t\tplatform.Anchored = true\n\t\tsetMarkerFacing(slot, platform.CFrame, markerOffset)\n\t\tplacementById[slot.Index] = {\n\t\t\tSide = side,\n\t\t\tZCenter = z,\n\t\t\tPlatformTopY = topY,\n\t\t}\n\tend\n\tassert(floorY < math.huge, \"Phase 5D platforms have no usable floor datum\")\n\treturn placementById, floorY\nend\n\nlocal function ensureAmountView(plaque: BasePart): (SurfaceGui, TextLabel)\n\tfor _, child in plaque:GetChildren() do\n\t\tif child.Name == \"IncomeSurfaceGui\" or child.Name == \"AmountBillboard\" then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\n\n\tlocal surface: SurfaceGui? = nil\n\tfor _, child in plaque:GetChildren() do\n\t\tif child.Name == AMOUNT_SURFACE_NAME then\n\t\t\tif surface == nil and child:IsA(\"SurfaceGui\") then\n\t\t\t\tsurface = child\n\t\t\telse\n\t\t\t\tchild:Destroy()\n\t\t\tend\n\t\tend\n\tend\n\tif surface == nil then\n\t\tsurface = Instance.new(\"SurfaceGui\")\n\t\tsurface.Name = AMOUNT_SURFACE_NAME\n\t\tsurface.Parent = plaque\n\tend\n\tlocal gui = surface :: SurfaceGui\n\tgui.Adornee = plaque\n\tgui.Face = Enum.NormalId.Top\n\tgui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize\n\t-- Top-face UV axes differ from the pad's forward/right axes. Rotate the\n\t-- label within the swapped canvas so it reads from this platform's front.\n\tgui.CanvasSize = Vector2.new(112, 200)\n\tgui.MaxDistance = 35\n\tgui.AlwaysOnTop = false\n\tgui.LightInfluence = 0\n\tgui.Brightness = 1\n\tgui.ClipsDescendants = true\n\tgui.ZOffset = 0\n\tgui.Active = false\n\tgui.Enabled = false\n\n\tlocal label = gui:FindFirstChild(AMOUNT_LABEL_NAME)\n\tif label and not label:IsA(\"TextLabel\") then\n\t\tlabel:Destroy()\n\t\tlabel = nil\n\tend\n\tfor _, child in gui:GetChildren() do\n\t\tif child:IsA(\"TextLabel\") and child ~= label then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\n\tif not label then\n\t\tlabel = Instance.new(\"TextLabel\")\n\t\tlabel.Name = AMOUNT_LABEL_NAME\n\t\tlabel.Parent = gui\n\tend\n\tlocal amount = label :: TextLabel\n\tamount.AnchorPoint = Vector2.new(0.5, 0.5)\n\tamount.Position = UDim2.fromScale(0.5, 0.5)\n\tamount.Size = UDim2.fromOffset(190, 72)\n\tamount.AutomaticSize = Enum.AutomaticSize.None\n\tamount.BackgroundTransparency = 1\n\tamount.BorderSizePixel = 0\n\tamount.Font = Enum.Font.FredokaOne\n\tamount.TextColor3 = Color3.fromRGB(255, 255, 255)\n\tamount.TextTransparency = 0\n\tamount.TextSize = 36\n\tamount.TextScaled = false\n\tamount.TextWrapped = false\n\tamount.TextTruncate = Enum.TextTruncate.None\n\tamount.TextXAlignment = Enum.TextXAlignment.Center\n\tamount.TextYAlignment = Enum.TextYAlignment.Center\n\tamount.TextStrokeTransparency = 1\n\tamount.RichText = false\n\tamount.Active = false\n\tamount.Selectable = false\n\tamount.Rotation = -90\n\tamount.Text = \"\"\n\n\tfor _, child in amount:GetChildren() do\n\t\tif child:IsA(\"UITextSizeConstraint\") or child:IsA(\"UIScale\") then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\n\tlocal stroke: UIStroke? = nil\n\tfor _, child in amount:GetChildren() do\n\t\tif child:IsA(\"UIStroke\") then\n\t\t\tif stroke == nil and child.Name == AMOUNT_STROKE_NAME then\n\t\t\t\tstroke = child\n\t\t\telse\n\t\t\t\tchild:Destroy()\n\t\t\tend\n\t\tend\n\tend\n\tif not stroke then\n\t\tstroke = Instance.new(\"UIStroke\")\n\t\tstroke.Name = AMOUNT_STROKE_NAME\n\t\tstroke.Parent = amount\n\tend\n\tlocal outline = stroke :: UIStroke\n\toutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual\n\toutline.Color = Color3.fromRGB(8, 8, 10)\n\toutline.Thickness = 2\n\toutline.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize\n\toutline.LineJoinMode = Enum.LineJoinMode.Round\n\toutline.Transparency = 0\n\treturn gui, amount\nend\n\nlocal function formatCashSnapshot(value: any): string\n\tlocal safe = if type(value) == \"number\" and value == value and value >= 0 then value else 0\n\treturn CurrencyFormatter.FormatCompactCash(math.floor(safe))\nend\n\nlocal function applyIncomeSnapshotToPlaque(\n\tplaque: BasePart,\n\tbaseId: string,\n\tplatformId: number,\n\townerUserId: number,\n\tsnapshot: any?\n)\n\tplaque:SetAttribute(\"BaseId\", baseId)\n\tplaque:SetAttribute(\"PlatformId\", platformId)\n\tplaque:SetAttribute(\"BaseOwnerUserId\", ownerUserId)\n\tif snapshot then\n\t\tplaque:SetAttribute(\"IncomeSnapshotReady\", true)\n\t\tplaque:SetAttribute(\"IncomeOccupied\", snapshot.Occupied == true)\n\t\tplaque:SetAttribute(\"IncomeRatePerSecond\", snapshot.RatePerSecond or 0)\n\t\tplaque:SetAttribute(\"UnclaimedCashSnapshot\", snapshot.UnclaimedCashSnapshot or 0)\n\t\tplaque:SetAttribute(\"IncomeSnapshotServerTime\", snapshot.SnapshotServerTime or 0)\n\t\tplaque:SetAttribute(\"IncomeRevision\", snapshot.Revision or 0)\n\telse\n\t\tplaque:SetAttribute(\"IncomeSnapshotReady\", false)\n\t\tplaque:SetAttribute(\"IncomeOccupied\", false)\n\t\tplaque:SetAttribute(\"IncomeRatePerSecond\", 0)\n\t\tplaque:SetAttribute(\"UnclaimedCashSnapshot\", 0)\n\t\tplaque:SetAttribute(\"IncomeSnapshotServerTime\", 0)\n\t\tplaque:SetAttribute(\"IncomeRevision\", 0)\n\tend\n\tlocal gui, label = ensureAmountView(plaque)\n\tlocal cash = plaque:GetAttribute(\"UnclaimedCashSnapshot\")\n\tlocal safeCash = if type(cash) == \"number\" and cash == cash and cash >= 0 then cash else 0\n\tlocal showAmount = plaque:GetAttribute(\"IncomeSnapshotReady\") == true\n\t\tand plaque:GetAttribute(\"IncomeOccupied\") == true\n\tlabel.Text = if showAmount then formatCashSnapshot(safeCash) else \"\"\n\tgui.Enabled = showAmount\nend\n\nlocal function candidatePlaques(base: Model): { BasePart }\n\tlocal result = {}\n\tfor _, descendant in base:GetDescendants() do\n\t\tif\n\t\t\tdescendant:IsA(\"BasePart\")\n\t\t\tand (\n\t\t\t\tCollectionService:HasTag(descendant, PLAQUE_TAG)\n\t\t\t\tor descendant.Name:match(\"^IncomePlaque_\") ~= nil\n\t\t\t)\n\t\tthen\n\t\t\ttable.insert(result, descendant)\n\t\tend\n\tend\n\treturn result\nend\n\nlocal function retirePlaque(plaque: BasePart)\n\tlocal binding = plaqueBindings[plaque]\n\tif binding and binding.TouchedConnection then\n\t\tbinding.TouchedConnection:Disconnect()\n\tend\n\tplaqueBindings[plaque] = nil\n\tCollectionService:RemoveTag(plaque, PLAQUE_TAG)\n\tplaque:Destroy()\nend\n\nlocal function characterFromTouchedPart(part: any): Model?\n\tif typeof(part) ~= \"Instance\" or not part:IsA(\"BasePart\") then\n\t\treturn nil\n\tend\n\tif part:FindFirstAncestorWhichIsA(\"Accessory\") or part:FindFirstAncestorWhichIsA(\"Tool\") then\n\t\treturn nil\n\tend\n\treturn part:FindFirstAncestorOfClass(\"Model\")\nend\n\nfunction BaseIncomePlaqueSystem:HandlePlaqueTouch(plaque: BasePart, touchedPart: any): any\n\tlocal binding = plaqueBindings[plaque]\n\tif not started or not binding or states[binding.Base] ~= binding.State then\n\t\treturn nil\n\tend\n\tlocal character = characterFromTouchedPart(touchedPart)\n\tlocal player = if character then getPlayerFromCharacter(character) else nil\n\tif\n\t\tplayer == nil\n\t\tor player.Parent ~= Players\n\t\tor player.Character ~= character\n\t\tor not touchedPart:IsDescendantOf(character)\n\tthen\n\t\treturn nil\n\tend\n\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid == nil or humanoid.Health <= 0 then\n\t\treturn nil\n\tend\n\t-- Touched is the trigger; TouchEnded is not a reliable lifetime boundary\n\t-- (limbs can be removed or contacts can disappear without the callback).\n\t-- Bound duplicate limb notifications by time, never by a permanent latch.\n\tlocal key = binding.BaseId .. \":\" .. tostring(binding.PlatformId)\n\tlocal attempts = touchAttempts[player]\n\tif not attempts then\n\t\tattempts = {}\n\t\ttouchAttempts[player] = attempts\n\tend\n\tlocal now = clock()\n\tif now < (attempts[key] or 0) then\n\t\treturn { ok = false, code = \"Busy\" }\n\tend\n\tattempts[key] = now + Config.PLAQUE_TOUCH_COOLDOWN_SECONDS\n\tlocal result = incomeSystem:TryClaimPlatform(player, binding.BaseId, binding.PlatformId)\n\tif result and result.ok then\n\t\tlocal snapshot = incomeSystem:GetPlatformIncomeSnapshot(binding.BaseId, binding.PlatformId)\n\t\tif snapshot then\n\t\t\tapplyIncomeSnapshotToPlaque(\n\t\t\t\tplaque,\n\t\t\t\tbinding.BaseId,\n\t\t\t\tbinding.PlatformId,\n\t\t\t\tbinding.OwnerUserId,\n\t\t\t\tsnapshot\n\t\t\t)\n\t\tend\n\t\tplaque:SetAttribute(\"LastClaimUserId\", player.UserId)\n\t\tplaque:SetAttribute(\"LastClaimAmount\", result.paid or 0)\n\t\tplaque:SetAttribute(\"ClaimResetAmount\", result.remainingExact or 0)\n\t\tlocal claimRevision = plaque:GetAttribute(\"ClaimRevision\")\n\t\tplaque:SetAttribute(\n\t\t\t\"ClaimRevision\",\n\t\t\t(if type(claimRevision) == \"number\" then claimRevision else 0) + 1\n\t\t)\n\tend\n\treturn result\nend\n\nlocal function bindPlaqueTouch(\n\tstate: any,\n\tplaque: BasePart,\n\tplatformId: number,\n\tclaimSensorCFrame: CFrame\n)\n\tlocal previous = plaqueBindings[plaque]\n\tif previous and previous.TouchedConnection then\n\t\tprevious.TouchedConnection:Disconnect()\n\tend\n\tlocal binding = {\n\t\tState = state,\n\t\tBase = state.Base,\n\t\tBaseId = state.BaseId,\n\t\tPlatformId = platformId,\n\t\tOwnerUserId = state.OwnerUserId,\n\t}\n\tlocal sensor = plaque:FindFirstChild(TOUCH_SENSOR_NAME)\n\tif sensor and not sensor:IsA(\"BasePart\") then\n\t\tsensor:Destroy()\n\t\tsensor = nil\n\tend\n\tif not sensor then\n\t\tsensor = Instance.new(\"Part\")\n\t\tsensor.Name = TOUCH_SENSOR_NAME\n\t\tsensor.Parent = plaque\n\tend\n\tlocal touchSensor = sensor :: BasePart\n\ttouchSensor.Size =\n\t\tVector3.new(PLAQUE_WIDTH_STUDS, Config.PLAQUE_TOUCH_HEIGHT_STUDS, PLAQUE_DEPTH_STUDS)\n\ttouchSensor.CFrame = claimSensorCFrame\n\ttouchSensor.Anchored = true\n\ttouchSensor.CanCollide = false\n\ttouchSensor.CanTouch = true\n\ttouchSensor.CanQuery = false\n\ttouchSensor.Massless = true\n\ttouchSensor.Transparency = 1\n\ttouchSensor.CastShadow = false\n\tbinding.Sensor = touchSensor\n\tbinding.TouchedConnection = touchSensor.Touched:Connect(function(otherPart)\n\t\tBaseIncomePlaqueSystem:HandlePlaqueTouch(plaque, otherPart)\n\tend)\n\tplaqueBindings[plaque] = binding\n\tstate.Plaques[platformId] = plaque\nend\n\nlocal function configurePlaque(\n\tstate: any,\n\tplaque: BasePart,\n\tplatformId: number,\n\tplacement: any,\n\tfloorTopY: number\n)\n\tplaque.Name = getPlaqueName(platformId)\n\tplaque.Size = Vector3.new(PLAQUE_WIDTH_STUDS, PLAQUE_THICKNESS_STUDS, PLAQUE_DEPTH_STUDS)\n\tplaque.Anchored = true\n\tplaque.CanCollide = false\n\tplaque.CanTouch = false\n\tplaque.CanQuery = true\n\tplaque.Massless = true\n\tplaque.Color = Color3.fromRGB(60, 255, 90)\n\tplaque.Transparency = 0\n\tStaticMaterial.Apply(plaque, Enum.Material.SmoothPlastic)\n\tplaque.TopSurface = Enum.SurfaceType.Smooth\n\tplaque.BottomSurface = Enum.SurfaceType.Smooth\n\tlocal inward = Config.PLATFORM_SIDE_STUDS / 2\n\t\t+ PLAQUE_PLATFORM_GAP_STUDS\n\t\t+ PLAQUE_DEPTH_STUDS / 2\n\tlocal plaqueX = placement.Side * (Config.PLATFORM_ROW_OFFSET_X - inward)\n\tlocal plaqueY = floorTopY + PLAQUE_FLOOR_CLEARANCE_STUDS + PLAQUE_THICKNESS_STUDS / 2\n\tlocal plaquePosition =\n\t\tstate.Root:PointToWorldSpace(Vector3.new(plaqueX, plaqueY, placement.ZCenter))\n\tlocal inwardDirection = state.Root:VectorToWorldSpace(Vector3.new(-placement.Side, 0, 0))\n\tlocal levelInward = Vector3.new(inwardDirection.X, 0, inwardDirection.Z).Unit\n\tplaque.CFrame = CFrame.lookAt(plaquePosition, plaquePosition + levelInward, Vector3.yAxis)\n\n\t-- The contact envelope follows this pad, not a second offset layout.\n\tlocal claimSensorCFrame = plaque.CFrame\n\t\t* CFrame.new(0, PLAQUE_THICKNESS_STUDS / 2 + Config.PLAQUE_TOUCH_HEIGHT_STUDS / 2, 0)\n\tif plaque:GetAttribute(\"ClaimRevision\") == nil then\n\t\tplaque:SetAttribute(\"ClaimRevision\", 0)\n\tend\n\tCollectionService:AddTag(plaque, PLAQUE_TAG)\n\tapplyIncomeSnapshotToPlaque(plaque, state.BaseId, platformId, state.OwnerUserId, nil)\n\tbindPlaqueTouch(state, plaque, platformId, claimSensorCFrame)\nend\n\nlocal function disconnectState(state: any)\n\tfor _, plaque in state.Plaques do\n\t\tlocal binding = plaqueBindings[plaque]\n\t\tif binding and binding.TouchedConnection then\n\t\t\tbinding.TouchedConnection:Disconnect()\n\t\tend\n\t\tplaqueBindings[plaque] = nil\n\tend\n\tif state.DestroyingConnection then\n\t\tstate.DestroyingConnection:Disconnect()\n\t\tstate.DestroyingConnection = nil\n\tend\n\ttable.clear(state.Plaques)\nend\n\nlocal function teardownBase(base: Model, destroyPlaques: boolean)\n\tlocal state = states[base]\n\tif state then\n\t\tdisconnectState(state)\n\t\tstates[base] = nil\n\tend\n\tfor _, plaque in candidatePlaques(base) do\n\t\tif destroyPlaques then\n\t\t\tretirePlaque(plaque)\n\t\telse\n\t\t\tplaque:SetAttribute(\"BaseOwnerUserId\", 0)\n\t\tend\n\tend\n\ttable.clear(touchAttempts)\nend\n\nlocal function applyPendingSnapshots(pending: { any })\n\tif #pending == 0 then\n\t\treturn\n\tend\n\tlocal snapshots = incomeSystem:SyncPlatformSnapshots(pending)\n\tfor index, request in pending do\n\t\tlocal snapshot = snapshots[index]\n\t\tif snapshot then\n\t\t\tapplyIncomeSnapshotToPlaque(\n\t\t\t\trequest.Plaque,\n\t\t\t\trequest.BaseId,\n\t\t\t\trequest.PlatformId,\n\t\t\t\trequest.OwnerUserId,\n\t\t\t\tsnapshot\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function refreshBaseSnapshots(base: Model, storage: any?, forceAll: boolean)\n\tlocal state = states[base]\n\tif not state then\n\t\treturn\n\tend\n\tlocal pending = {}\n\tfor platformId, plaque in state.Plaques do\n\t\tlocal snapshot = incomeSystem:GetPlatformIncomeSnapshot(state.BaseId, platformId)\n\t\tlocal record = if storage then storage:GetPlatformRecord(platformId) else nil\n\t\tlocal changed = forceAll\n\t\t\tor snapshot == nil\n\t\t\tor snapshot.Occupied ~= (record ~= nil)\n\t\t\tor snapshot.IndividualId ~= (if record then record.ItemId else nil)\n\t\t\tor snapshot.CatalogueId ~= (if record then record.BrainrotId else nil)\n\t\tif changed then\n\t\t\ttable.insert(pending, {\n\t\t\t\tBaseId = state.BaseId,\n\t\t\t\tPlatformId = platformId,\n\t\t\t\tPlaque = plaque,\n\t\t\t\tOwnerUserId = state.OwnerUserId,\n\t\t\t})\n\t\t\tcontinue\n\t\tend\n\t\tif snapshot then\n\t\t\tapplyIncomeSnapshotToPlaque(\n\t\t\t\tplaque,\n\t\t\t\tstate.BaseId,\n\t\t\t\tplatformId,\n\t\t\t\tstate.OwnerUserId,\n\t\t\t\tsnapshot\n\t\t\t)\n\t\tend\n\tend\n\tapplyPendingSnapshots(pending)\nend\n\nlocal function refreshAccumulatedPlaques()\n\tlocal pending = {}\n\tfor base, state in states do\n\t\tlocal player = if state.OwnerUserId ~= 0 then getPlayerByUserId(state.OwnerUserId) else nil\n\t\tlocal storage = if player then storageSystem:GetStorageForPlayer(player) else nil\n\t\tif storage and storage.Base == base then\n\t\t\tfor platformId, plaque in state.Plaques do\n\t\t\t\tlocal current = incomeSystem:GetPlatformIncomeSnapshot(state.BaseId, platformId)\n\t\t\t\tif current and current.Occupied then\n\t\t\t\t\ttable.insert(pending, {\n\t\t\t\t\t\tBaseId = state.BaseId,\n\t\t\t\t\t\tPlatformId = platformId,\n\t\t\t\t\t\tPlaque = plaque,\n\t\t\t\t\t\tOwnerUserId = state.OwnerUserId,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tapplyPendingSnapshots(pending)\nend\n\nfunction BaseIncomePlaqueSystem:BuildBase(base: Model, ownerUserId: number?): (boolean, string?)\n\tif typeof(base) ~= \"Instance\" or not base:IsA(\"Model\") or base.Parent == nil then\n\t\treturn false, \"INVALID_BASE\"\n\tend\n\tlocal slots = storageSystem:GetRegisteredPlatforms(base)\n\tif not slots or #slots ~= Config.PLATFORM_COUNT then\n\t\treturn false, \"INVALID_PLATFORMS\"\n\tend\n\tteardownBase(base, false)\n\tlocal root = baseRootCFrame(base)\n\tlocal placementById, platformFloorY = positionPlatforms(root, slots)\n\tlocal floorTopY = ensureInterior(base, root, platformFloorY)\n\tlocal baseId = base:GetAttribute(\"BaseId\")\n\tif type(baseId) ~= \"string\" or baseId == \"\" then\n\t\treturn false, \"INVALID_BASE_ID\"\n\tend\n\tlocal state = {\n\t\tBase = base,\n\t\tBaseId = baseId,\n\t\tRoot = root,\n\t\tOwnerUserId = ownerUserId or 0,\n\t\tPlaques = {},\n\t}\n\tstates[base] = state\n\tlocal container = ensureFolder(base, PLAQUE_CONTAINER_NAME)\n\tlocal candidates = candidatePlaques(base)\n\tlocal used: { [BasePart]: boolean } = {}\n\tfor platformId = 1, Config.PLATFORM_COUNT do\n\t\tlocal expectedName = getPlaqueName(platformId)\n\t\tlocal selected: BasePart? = nil\n\t\tfor _, candidate in candidates do\n\t\t\tif\n\t\t\t\tnot used[candidate]\n\t\t\t\tand candidate.Name == expectedName\n\t\t\t\tand (\n\t\t\t\t\tcandidate:GetAttribute(\"PlatformId\") == nil\n\t\t\t\t\tor candidate:GetAttribute(\"PlatformId\") == platformId\n\t\t\t\t)\n\t\t\tthen\n\t\t\t\tselected = candidate\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif not selected then\n\t\t\tselected = Instance.new(\"Part\")\n\t\t\tselected.Parent = container\n\t\tend\n\t\tselected.Parent = container\n\t\tused[selected] = true\n\t\tconfigurePlaque(state, selected, platformId, placementById[platformId], floorTopY)\n\tend\n\tfor _, candidate in candidates do\n\t\tif not used[candidate] then\n\t\t\tretirePlaque(candidate)\n\t\tend\n\tend\n\tstate.DestroyingConnection = base.Destroying:Connect(function()\n\t\tteardownBase(base, true)\n\tend)\n\tif storageSystem.RefreshPlatformDisplays then\n\t\tstorageSystem:RefreshPlatformDisplays(base)\n\tend\n\treturn true, nil\nend\n\nfunction BaseIncomePlaqueSystem:GetPlaques(base: Model): { BasePart }\n\tlocal state = states[base]\n\tlocal result = {}\n\tif state then\n\t\tfor platformId = 1, Config.PLATFORM_COUNT do\n\t\t\tif state.Plaques[platformId] then\n\t\t\t\ttable.insert(result, state.Plaques[platformId])\n\t\t\tend\n\t\tend\n\tend\n\treturn result\nend\n\nfunction BaseIncomePlaqueSystem:Init(dependencies: any?): boolean\n\tif started then\n\t\treturn false\n\tend\n\tinitialDependencies = dependencies or {}\n\treturn true\nend\n\nfunction BaseIncomePlaqueSystem:Start(dependencies: any?): boolean\n\tif started then\n\t\treturn false\n\tend\n\tlocal deps = dependencies or initialDependencies or {}\n\tbaseSystem = deps.Base or PlayerBaseSystem\n\tstorageSystem = deps.Storage or BaseStorageSystem\n\tincomeSystem = deps.Income or BrainrotIncomeSystem\n\tclock = deps.Now or function(): number\n\t\treturn Workspace:GetServerTimeNow()\n\tend\n\tgetPlayerFromCharacter = deps.GetPlayerFromCharacter\n\t\tor function(character: Model): Player?\n\t\t\treturn Players:GetPlayerFromCharacter(character)\n\t\tend\n\tgetPlayerByUserId = deps.GetPlayerByUserId\n\t\tor function(userId: number): Player?\n\t\t\treturn Players:GetPlayerByUserId(userId)\n\t\tend\n\tstarted = true\n\n\tfor _, base in baseSystem:GetRegisteredBases() do\n\t\tlocal ownerUserId = base:GetAttribute(\"OwnerUserId\")\n\t\tlocal built, reason = self:BuildBase(\n\t\t\tbase,\n\t\t\tif type(ownerUserId) == \"number\" and ownerUserId ~= 0 then ownerUserId else 0\n\t\t)\n\t\tif not built then\n\t\t\tlog:Warn(\"Phase 5D layout unavailable for %s: %s\", base:GetFullName(), tostring(reason))\n\t\telseif type(ownerUserId) == \"number\" and ownerUserId ~= 0 then\n\t\t\tlocal player = getPlayerByUserId(ownerUserId)\n\t\t\tlocal storage = if player then storageSystem:GetStorageForPlayer(player) else nil\n\t\t\tif storage then\n\t\t\t\trefreshBaseSnapshots(base, storage, true)\n\t\t\tend\n\t\tend\n\tend\n\n\tassignmentConnection = baseSystem:SubscribeAssignments(function(player, base)\n\t\tlocal built, reason = self:BuildBase(base, player.UserId)\n\t\tif not built then\n\t\t\tlog:Warn(\"Phase 5D assignment layout failed: %s\", tostring(reason))\n\t\t\treturn\n\t\tend\n\t\tlocal storage = storageSystem:GetStorageForPlayer(player)\n\t\tif storage then\n\t\t\trefreshBaseSnapshots(base, storage, true)\n\t\tend\n\tend, function(_, base)\n\t\tteardownBase(base, false)\n\tend)\n\n\tunsubscribeStorage = storageSystem:ObserveStorage({\n\t\tOnBound = function(player, storage)\n\t\t\tlocal base = storage.Base\n\t\t\tif not states[base] then\n\t\t\t\tself:BuildBase(base, player.UserId)\n\t\t\tend\n\t\t\tlocal state = states[base]\n\t\t\tif state then\n\t\t\t\tstate.OwnerUserId = player.UserId\n\t\t\t\tfor _, binding in plaqueBindings do\n\t\t\t\t\tif binding.State == state then\n\t\t\t\t\t\tbinding.OwnerUserId = player.UserId\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\trefreshBaseSnapshots(base, storage, true)\n\t\t\tend\n\t\tend,\n\t\tOnCommitted = function(_, storage)\n\t\t\trefreshBaseSnapshots(storage.Base, storage, false)\n\t\tend,\n\t\tOnReleasing = function(_, storage)\n\t\t\trefreshBaseSnapshots(storage.Base, storage, false)\n\t\tend,\n\t})\n\tif deps.ConnectSnapshotRefresh ~= false then\n\t\tlocal heartbeat = deps.Heartbeat or RunService.Heartbeat\n\t\tsnapshotAccumulator = 0\n\t\tsnapshotConnection = heartbeat:Connect(function(deltaTime)\n\t\t\tsnapshotAccumulator += deltaTime\n\t\t\tif snapshotAccumulator >= PLAQUE_SNAPSHOT_REFRESH_SECONDS then\n\t\t\t\tsnapshotAccumulator %= PLAQUE_SNAPSHOT_REFRESH_SECONDS\n\t\t\t\trefreshAccumulatedPlaques()\n\t\t\tend\n\t\tend)\n\tend\n\treturn true\nend\n\nfunction BaseIncomePlaqueSystem:Destroy(): boolean\n\tif assignmentConnection then\n\t\tassignmentConnection:Disconnect()\n\t\tassignmentConnection = nil\n\tend\n\tif unsubscribeStorage then\n\t\tunsubscribeStorage()\n\t\tunsubscribeStorage = nil\n\tend\n\tif snapshotConnection then\n\t\tsnapshotConnection:Disconnect()\n\t\tsnapshotConnection = nil\n\tend\n\tsnapshotAccumulator = 0\n\tlocal bases = {}\n\tfor base in states do\n\t\ttable.insert(bases, base)\n\tend\n\tfor _, base in bases do\n\t\tteardownBase(base, false)\n\tend\n\ttable.clear(plaqueBindings)\n\ttable.clear(touchAttempts)\n\tstarted = false\n\tinitialDependencies = nil\n\tbaseSystem, storageSystem, incomeSystem =\n\t\tPlayerBaseSystem, BaseStorageSystem, BrainrotIncomeSystem\n\tclock = function(): number\n\t\treturn Workspace:GetServerTimeNow()\n\tend\n\tgetPlayerFromCharacter = function(character: Model): Player?\n\t\treturn Players:GetPlayerFromCharacter(character)\n\tend\n\tgetPlayerByUserId = function(userId: number): Player?\n\t\treturn Players:GetPlayerByUserId(userId)\n\tend\n\treturn true\nend\n\nreturn BaseIncomePlaqueSystem\n","afterSource":"--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal CollectionService = game:GetService(\"CollectionService\")\n\nlocal Config = require(ReplicatedStorage.Shared.Config.BaseLayoutConfig)\nlocal CurrencyFormatter = require(ReplicatedStorage.Shared.Utility.CurrencyFormatter)\nlocal Logger = require(ReplicatedStorage.Shared.Utility.Logger)\nlocal StaticMaterial = require(ReplicatedStorage.Shared.Utility.MapArtStaticMaterialPolicy)\nlocal PlayerBaseSystem = require(script.Parent.PlayerBaseSystem)\nlocal BaseStorageSystem = require(script.Parent.BaseStorageSystem)\nlocal BrainrotIncomeSystem = require(script.Parent.BrainrotIncomeSystem)\n\nlocal log = Logger.new(\"BaseIncomePlaqueSystem\")\nlocal PLAQUE_TAG = \"BrainrotIncomePlaque\"\nlocal LAYOUT_CONTAINER_NAME = \"Phase5DInterior\"\nlocal PLAQUE_CONTAINER_NAME = \"IncomePlaques\"\nlocal TOUCH_SENSOR_NAME = \"TouchSensor\"\nlocal AMOUNT_SURFACE_NAME = \"AmountSurfaceGui\"\nlocal AMOUNT_LABEL_NAME = \"AmountLabel\"\nlocal AMOUNT_STROKE_NAME = \"AmountStroke\"\nlocal PLAQUE_WIDTH_STUDS = 3.5\nlocal PLAQUE_THICKNESS_STUDS = 0.18\nlocal PLAQUE_DEPTH_STUDS = 2.25\nlocal PLAQUE_PLATFORM_GAP_STUDS = 0.55\nlocal PLAQUE_FLOOR_CLEARANCE_STUDS = 0.02\nlocal PLAQUE_SNAPSHOT_REFRESH_SECONDS = 1\nlocal PILLAR_MANAGED_BY = \"BaseIncomePlaqueSystem\"\nlocal PILLAR_ORIGINAL_WIDTH_STUDS = 1.25\nlocal PILLAR_ORIGINAL_DEPTH_STUDS = 1.25\nlocal PILLAR_WIDTH_STUDS = PILLAR_ORIGINAL_WIDTH_STUDS * 0.5\nlocal PILLAR_DEPTH_STUDS = PILLAR_ORIGINAL_DEPTH_STUDS * 0.5\nlocal PILLAR_MAX_SPACING_STUDS = 6\nlocal ENTRANCE_CLEAR_WIDTH_STUDS = 10\nlocal LEGACY_WALL_NAMES = table.freeze({ \"LeftWall\", \"RightWall\", \"BackWall\" })\n\nlocal BaseIncomePlaqueSystem = {}\nlocal started = false\nlocal initialDependencies: any? = nil\nlocal assignmentConnection: any? = nil\nlocal unsubscribeStorage: (() -> ())? = nil\nlocal snapshotConnection: RBXScriptConnection? = nil\nlocal snapshotAccumulator = 0\nlocal baseSystem: any = PlayerBaseSystem\nlocal storageSystem: any = BaseStorageSystem\nlocal incomeSystem: any = BrainrotIncomeSystem\nlocal clock = function(): number\n\treturn Workspace:GetServerTimeNow()\nend\nlocal getPlayerFromCharacter = function(character: Model): Player?\n\treturn Players:GetPlayerFromCharacter(character)\nend\nlocal getPlayerByUserId = function(userId: number): Player?\n\treturn Players:GetPlayerByUserId(userId)\nend\nlocal states: { [Model]: any } = {}\nlocal plaqueBindings: { [BasePart]: any } = {}\nlocal touchAttempts: { [Player]: { [string]: number } } = setmetatable({}, { __mode = \"k\" })\n\nlocal function getPlaqueName(platformId: number): string\n\treturn \"IncomePlaque_\" .. tostring(platformId)\nend\n\nlocal function platformIdFromPart(platform: BasePart): number?\n\tlocal attribute = platform:GetAttribute(\"SlotIndex\")\n\tif type(attribute) == \"number\" and attribute % 1 == 0 then\n\t\treturn attribute\n\tend\n\treturn tonumber(platform.Name:match(\"^Slot_(%d+)$\"))\nend\n\nlocal function baseRootCFrame(base: Model): CFrame\n\tlocal saved = base:GetAttribute(\"Phase5DLayoutPivot\")\n\tif typeof(saved) == \"CFrame\" then\n\t\treturn saved\n\tend\n\tlocal root = base:GetPivot()\n\tbase:SetAttribute(\"Phase5DLayoutPivot\", root)\n\treturn root\nend\n\nlocal function ensureFolder(parent: Instance, name: string): Folder\n\tlocal existing = parent:FindFirstChild(name)\n\tif existing then\n\t\tassert(existing:IsA(\"Folder\"), name .. \" must be a Folder\")\n\t\treturn existing\n\tend\n\tlocal folder = Instance.new(\"Folder\")\n\tfolder.Name = name\n\tfolder.Parent = parent\n\treturn folder\nend\n\nlocal function ensurePart(base: Model, container: Folder, name: string): (BasePart, boolean)\n\tlocal existing = base:FindFirstChild(name) or container:FindFirstChild(name)\n\tif existing then\n\t\tassert(existing:IsA(\"BasePart\"), name .. \" must be a BasePart\")\n\t\treturn existing, false\n\tend\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = name\n\tpart.Parent = container\n\treturn part, true\nend\n\nlocal function configureStructuralPart(part: BasePart)\n\tpart.Anchored = true\n\tpart.CanCollide = true\n\tpart.CanTouch = false\n\tpart.CanQuery = true\n\tStaticMaterial.Apply(part, Enum.Material.SmoothPlastic)\n\tpart.Color = Color3.fromRGB(91, 98, 104)\n\tpart.TopSurface = Enum.SurfaceType.Smooth\n\tpart.BottomSurface = Enum.SurfaceType.Smooth\nend\n\nlocal function platformTopLocalY(root: CFrame, platform: BasePart): number\n\treturn root:PointToObjectSpace(platform.Position).Y + platform.Size.Y / 2\nend\n\nlocal function entranceSign(base: Model, root: CFrame): number\n\tfor _, name in { \"CartSpawn\", \"PlayerSpawn\" } do\n\t\tlocal marker = base:FindFirstChild(name)\n\t\tif marker and marker:IsA(\"BasePart\") then\n\t\t\tlocal localZ = root:PointToObjectSpace(marker.Position).Z\n\t\t\tif math.abs(localZ) > 0.01 then\n\t\t\t\treturn if localZ > 0 then 1 else -1\n\t\t\tend\n\t\tend\n\tend\n\treturn -1\nend\n\ntype StructuralStyle = {\n\tPostWidth: number?,\n\tPostDepth: number?,\n\tColor: Color3,\n\tMaterial: Enum.Material,\n\tMaterialVariant: string,\n\tEffectivePhysicalProperties: PhysicalProperties,\n\tCollisionGroup: string,\n\tCanCollide: boolean,\n\tCanTouch: boolean,\n\tCanQuery: boolean,\n}\n\nlocal function captureStructuralStyle(part: BasePart): StructuralStyle\n\treturn {\n\t\tColor = part.Color,\n\t\tMaterial = part.Material,\n\t\tMaterialVariant = part.MaterialVariant,\n\t\tEffectivePhysicalProperties = part.CurrentPhysicalProperties,\n\t\tCollisionGroup = part.CollisionGroup,\n\t\tCanCollide = part.CanCollide,\n\t\tCanTouch = part.CanTouch,\n\t\tCanQuery = part.CanQuery,\n\t}\nend\n\nlocal function legacyWall(base: Model, container: Folder, name: string): BasePart?\n\tlocal candidate = base:FindFirstChild(name) or container:FindFirstChild(name)\n\treturn if candidate and candidate:IsA(\"BasePart\") then candidate else nil\nend\n\nlocal function removeLegacyWalls(base: Model, container: Folder)\n\tfor _, name in LEGACY_WALL_NAMES do\n\t\tlocal direct = base:FindFirstChild(name)\n\t\tif direct and direct:IsA(\"BasePart\") then\n\t\t\tdirect:Destroy()\n\t\tend\n\t\tlocal generated = container:FindFirstChild(name)\n\t\tif generated and generated:IsA(\"BasePart\") then\n\t\t\tgenerated:Destroy()\n\t\tend\n\tend\nend\n\nlocal function clearManagedPillars(container: Folder)\n\tfor _, child in container:GetChildren() do\n\t\tif child:IsA(\"BasePart\") and child:GetAttribute(\"ManagedBy\") == PILLAR_MANAGED_BY then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\nend\n\nlocal function createPillar(\n\tcontainer: Folder,\n\troot: CFrame,\n\tname: string,\n\tlocalPosition: Vector3,\n\tfloorTopY: number,\n\tpillarHeight: number,\n\tstyle: StructuralStyle\n)\n\tlocal pillar = Instance.new(\"Part\")\n\tpillar.Name = name\n\tpillar:SetAttribute(\"ManagedBy\", PILLAR_MANAGED_BY)\n\tconfigureStructuralPart(pillar)\n\tpillar.Size = Vector3.new(style.PostWidth or PILLAR_WIDTH_STUDS, pillarHeight, style.PostDepth or PILLAR_DEPTH_STUDS)\n\tpillar.CFrame = root\n\t\t* CFrame.new(localPosition.X, floorTopY + pillarHeight / 2, localPosition.Z)\n\tpillar.Color = style.Color\n\tpillar.Material = style.Material\n\tpillar.MaterialVariant = style.MaterialVariant\n\tpillar.CustomPhysicalProperties = style.EffectivePhysicalProperties\n\tpillar.CollisionGroup = style.CollisionGroup\n\tpillar.CanCollide = style.CanCollide\n\tpillar.CanTouch = style.CanTouch\n\tpillar.CanQuery = style.CanQuery\n\tStaticMaterial.Apply(pillar)\n\tpillar.Parent = container\nend\n\nlocal function createPillarsAlongEdge(\n\tcontainer: Folder,\n\troot: CFrame,\n\tfloorTopY: number,\n\tpillarHeight: number,\n\tstyle: StructuralStyle,\n\tedgeName: string,\n\tstartLocalPosition: Vector3,\n\tendLocalPosition: Vector3,\n\tshouldSkip: ((Vector3) -> boolean)?\n)\n\tlocal edgeLength = (endLocalPosition - startLocalPosition).Magnitude\n\tlocal intervalCount = math.max(1, math.ceil(edgeLength / PILLAR_MAX_SPACING_STUDS))\n\tlocal placedIndex = 0\n\tfor interval = 1, intervalCount - 1 do\n\t\tlocal localPosition = startLocalPosition:Lerp(endLocalPosition, interval / intervalCount)\n\t\tif not shouldSkip or not shouldSkip(localPosition) then\n\t\t\tplacedIndex += 1\n\t\t\tcreatePillar(\n\t\t\t\tcontainer,\n\t\t\t\troot,\n\t\t\t\tstring.format(\"BasePillar_%s_%02d\", edgeName, placedIndex),\n\t\t\t\tlocalPosition,\n\t\t\t\tfloorTopY,\n\t\t\t\tpillarHeight,\n\t\t\t\tstyle\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function createPerimeterPillars(\n\tbase: Model,\n\tcontainer: Folder,\n\troot: CFrame,\n\tfloorTopY: number,\n\tpillarHeight: number,\n\tstyle: StructuralStyle,\n\tgeometry: any?\n)\n\tclearManagedPillars(container)\n\t-- Preserve the established perimeter centreline while reducing only each\n\t-- pillar's horizontal cross-section.\n\tlocal perimeter = if geometry then geometry.perimeter else nil\n\tlocal width = if perimeter then perimeter.width else Config.BASE_FOOTPRINT_WIDTH_STUDS\n\tlocal depth = if perimeter then perimeter.depth else Config.BASE_FOOTPRINT_DEPTH_STUDS\n\tlocal centreX = if perimeter then perimeter.centreX else 0\n\tlocal centreZ = if perimeter then perimeter.centreZ else 0\n\tlocal postWidth = if perimeter then perimeter.postWidth else PILLAR_WIDTH_STUDS\n\tlocal postDepth = if perimeter then perimeter.postDepth else PILLAR_DEPTH_STUDS\n\tstyle = table.clone(style)\n\tstyle.PostWidth = postWidth\n\tstyle.PostDepth = postDepth\n\tlocal halfWidth = (width - (if perimeter then postWidth * 2 else PILLAR_ORIGINAL_WIDTH_STUDS)) / 2\n\tlocal halfDepth = (depth - (if perimeter then postDepth * 2 else PILLAR_ORIGINAL_DEPTH_STUDS)) / 2\n\tlocal frontSign = if perimeter and perimeter.frontSign then perimeter.frontSign else entranceSign(base, root)\n\tlocal frontZ = centreZ + frontSign * halfDepth\n\tlocal backZ = centreZ - frontSign * halfDepth\n\tlocal frontLeft = Vector3.new(centreX - halfWidth, 0, frontZ)\n\tlocal frontRight = Vector3.new(centreX + halfWidth, 0, frontZ)\n\tlocal backLeft = Vector3.new(centreX - halfWidth, 0, backZ)\n\tlocal backRight = Vector3.new(centreX + halfWidth, 0, backZ)\n\n\tfor name, localPosition in\n\t\t{\n\t\t\tBasePillar_Corner_FL = frontLeft,\n\t\t\tBasePillar_Corner_FR = frontRight,\n\t\t\tBasePillar_Corner_BL = backLeft,\n\t\t\tBasePillar_Corner_BR = backRight,\n\t\t}\n\tdo\n\t\tcreatePillar(container, root, name, localPosition, floorTopY, pillarHeight, style)\n\tend\n\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Front\",\n\t\tfrontLeft,\n\t\tfrontRight,\n\t\tfunction(localPosition)\n\t\t\treturn math.abs(localPosition.X - centreX) < ENTRANCE_CLEAR_WIDTH_STUDS / 2\n\t\tend\n\t)\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Back\",\n\t\tbackLeft,\n\t\tbackRight,\n\t\tnil\n\t)\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Left\",\n\t\tfrontLeft,\n\t\tbackLeft,\n\t\tnil\n\t)\n\tcreatePillarsAlongEdge(\n\t\tcontainer,\n\t\troot,\n\t\tfloorTopY,\n\t\tpillarHeight,\n\t\tstyle,\n\t\t\"Right\",\n\t\tfrontRight,\n\t\tbackRight,\n\t\tnil\n\t)\nend\n\nlocal function ensureInterior(base: Model, root: CFrame, platformFloorY: number, geometry: any?): number\n\tlocal container = ensureFolder(base, LAYOUT_CONTAINER_NAME)\n\tlocal floor: BasePart? = nil\n\tif geometry then\n\t\t-- Compact support reuses the migrated authoritative Foundation. No coplanar runtime floor.\n\t\tlocal foundation = base:FindFirstChild(\"Foundation\")\n\t\tassert(foundation and foundation:IsA(\"BasePart\") and foundation:GetAttribute(\"LayoutRole\") == \"Foundation\", \"Compact base Foundation is missing or has changed identity\")\n\t\tfloor = foundation :: BasePart\n\telse\n\t\tfor _, name in { \"BaseFloor\", \"Floor\", \"InteriorFloor\", \"GroundFloor\" } do\n\t\t\tlocal candidate = base:FindFirstChild(name) or container:FindFirstChild(name)\n\t\t\tif candidate and candidate:IsA(\"BasePart\") then\n\t\t\t\tfloor = candidate\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\tlocal createdFloor = false\n\tif not floor then\n\t\tfloor, createdFloor = ensurePart(base, container, \"BaseFloor\")\n\tend\n\tlocal resolvedFloor = floor :: BasePart\n\tlocal floorThickness = if createdFloor then 1 else math.max(resolvedFloor.Size.Y, 0.2)\n\tlocal floorTopY = if createdFloor\n\t\tthen platformFloorY\n\t\telse platformTopLocalY(root, resolvedFloor)\n\tif geometry then\n\t\t-- Retain the authoritative Foundation colour, flags and effective physics.\n\t\tStaticMaterial.Apply(resolvedFloor)\n\telse\n\t\tconfigureStructuralPart(resolvedFloor)\n\tend\n\tlocal support = if geometry then geometry.support else nil\n\tresolvedFloor.Size = Vector3.new(\n\t\tif support then support.width else Config.BASE_FOOTPRINT_WIDTH_STUDS,\n\t\tfloorThickness,\n\t\tif support then support.depth else Config.BASE_FOOTPRINT_DEPTH_STUDS\n\t)\n\tresolvedFloor.CFrame = root * CFrame.new(\n\t\tif support then support.centreX else 0, floorTopY - floorThickness / 2,\n\t\tif support then support.centreZ else 0\n\t)\n\n\tlocal pillarStyle = captureStructuralStyle(resolvedFloor)\n\tlocal pillarHeight = Config.BASE_WALL_HEIGHT_STUDS\n\tfor _, wallName in LEGACY_WALL_NAMES do\n\t\tlocal wall = legacyWall(base, container, wallName)\n\t\tif wall then\n\t\t\tpillarStyle = captureStructuralStyle(wall)\n\t\t\tpillarHeight = wall.Size.Y\n\t\t\tbreak\n\t\tend\n\tend\n\tremoveLegacyWalls(base, container)\n\tcreatePerimeterPillars(base, container, root, floorTopY, pillarHeight, pillarStyle, geometry)\n\treturn floorTopY\nend\n\nlocal function setMarkerFacing(slot: any, platformCFrame: CFrame, markerOffset: CFrame)\n\tif slot.Marker:IsA(\"Attachment\") then\n\t\tslot.Marker.CFrame = CFrame.new(markerOffset.Position)\n\telse\n\t\tlocal marker = slot.Marker :: BasePart\n\t\tmarker.CFrame = platformCFrame * CFrame.new(markerOffset.Position)\n\tend\nend\n\nlocal function positionPlatforms(root: CFrame, slots: { any }, geometry: any?): (any, number)\n\tlocal ordered = table.clone(slots)\n\ttable.sort(ordered, function(left, right)\n\t\treturn left.Index < right.Index\n\tend)\n\tassert(#ordered == Config.PLATFORM_COUNT, \"Phase 5D requires exactly 12 platforms\")\n\tlocal placementById = {}\n\tlocal floorY = math.huge\n\tfor order, slot in ordered do\n\t\tlocal platform = slot.Platform :: BasePart\n\t\tlocal platformId = platformIdFromPart(platform)\n\t\tassert(platformId == slot.Index, \"Platform stable ID changed during layout\")\n\t\tlocal topY = platformTopLocalY(root, platform)\n\t\tfloorY = math.min(floorY, topY - platform.Size.Y)\n\t\tlocal side = if order <= Config.PLATFORMS_PER_SIDE then -1 else 1\n\t\tlocal row = if side < 0 then order else order - Config.PLATFORMS_PER_SIDE\n\t\tlocal canonical = if geometry then geometry.slots[slot.Index] else nil\n\t\tassert(not canonical or (canonical.Index == slot.Index and canonical.Side == side), \"Compact stable slot identity changed\")\n\t\tlocal x = if canonical then canonical.X else side * Config.PLATFORM_ROW_OFFSET_X\n\t\tlocal z = if canonical then canonical.Z else Config.PLATFORM_Z_CENTERS[row]\n\t\tlocal normalSize = if canonical then canonical.PadNormalStuds else Config.PLATFORM_SIDE_STUDS\n\t\tlocal tangentSize = if canonical then canonical.PadTangentialStuds else Config.PLATFORM_SIDE_STUDS\n\t\tlocal aisleX = if geometry then geometry.formationCenterX else 0\n\t\tlocal localPosition = Vector3.new(x, topY - platform.Size.Y / 2, z)\n\t\tlocal localFacing = CFrame.lookAt(\n\t\t\tlocalPosition,\n\t\t\tVector3.new(aisleX, localPosition.Y, localPosition.Z),\n\t\t\tVector3.yAxis\n\t\t)\n\t\tlocal markerOffset = if slot.Marker:IsA(\"Attachment\")\n\t\t\tthen slot.Marker.CFrame\n\t\t\telse platform.CFrame:ToObjectSpace((slot.Marker :: BasePart).CFrame)\n\t\tplatform.Size =\n\t\t\tVector3.new(tangentSize, platform.Size.Y, normalSize)\n\t\tplatform.CFrame = root * localFacing\n\t\tplatform.Anchored = true\n\t\tsetMarkerFacing(slot, platform.CFrame, markerOffset)\n\t\tplacementById[slot.Index] = {\n\t\t\tSide = side,\n\t\t\tXCenter = x,\n\t\t\tZCenter = z,\n\t\t\tPlatformNormalStuds = normalSize,\n\t\t\tPlatformTopY = topY,\n\t\t}\n\tend\n\tassert(floorY < math.huge, \"Phase 5D platforms have no usable floor datum\")\n\treturn placementById, floorY\nend\n\nlocal function ensureAmountView(plaque: BasePart): (SurfaceGui, TextLabel)\n\tfor _, child in plaque:GetChildren() do\n\t\tif child.Name == \"IncomeSurfaceGui\" or child.Name == \"AmountBillboard\" then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\n\n\tlocal surface: SurfaceGui? = nil\n\tfor _, child in plaque:GetChildren() do\n\t\tif child.Name == AMOUNT_SURFACE_NAME then\n\t\t\tif surface == nil and child:IsA(\"SurfaceGui\") then\n\t\t\t\tsurface = child\n\t\t\telse\n\t\t\t\tchild:Destroy()\n\t\t\tend\n\t\tend\n\tend\n\tif surface == nil then\n\t\tsurface = Instance.new(\"SurfaceGui\")\n\t\tsurface.Name = AMOUNT_SURFACE_NAME\n\t\tsurface.Parent = plaque\n\tend\n\tlocal gui = surface :: SurfaceGui\n\tgui.Adornee = plaque\n\tgui.Face = Enum.NormalId.Top\n\tgui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize\n\t-- Top-face UV axes differ from the pad's forward/right axes. Rotate the\n\t-- label within the swapped canvas so it reads from this platform's front.\n\tgui.CanvasSize = Vector2.new(112, 200)\n\tgui.MaxDistance = 35\n\tgui.AlwaysOnTop = false\n\tgui.LightInfluence = 0\n\tgui.Brightness = 1\n\tgui.ClipsDescendants = true\n\tgui.ZOffset = 0\n\tgui.Active = false\n\tgui.Enabled = false\n\n\tlocal label = gui:FindFirstChild(AMOUNT_LABEL_NAME)\n\tif label and not label:IsA(\"TextLabel\") then\n\t\tlabel:Destroy()\n\t\tlabel = nil\n\tend\n\tfor _, child in gui:GetChildren() do\n\t\tif child:IsA(\"TextLabel\") and child ~= label then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\n\tif not label then\n\t\tlabel = Instance.new(\"TextLabel\")\n\t\tlabel.Name = AMOUNT_LABEL_NAME\n\t\tlabel.Parent = gui\n\tend\n\tlocal amount = label :: TextLabel\n\tamount.AnchorPoint = Vector2.new(0.5, 0.5)\n\tamount.Position = UDim2.fromScale(0.5, 0.5)\n\tamount.Size = UDim2.fromOffset(190, 72)\n\tamount.AutomaticSize = Enum.AutomaticSize.None\n\tamount.BackgroundTransparency = 1\n\tamount.BorderSizePixel = 0\n\tamount.Font = Enum.Font.FredokaOne\n\tamount.TextColor3 = Color3.fromRGB(255, 255, 255)\n\tamount.TextTransparency = 0\n\tamount.TextSize = 36\n\tamount.TextScaled = false\n\tamount.TextWrapped = false\n\tamount.TextTruncate = Enum.TextTruncate.None\n\tamount.TextXAlignment = Enum.TextXAlignment.Center\n\tamount.TextYAlignment = Enum.TextYAlignment.Center\n\tamount.TextStrokeTransparency = 1\n\tamount.RichText = false\n\tamount.Active = false\n\tamount.Selectable = false\n\tamount.Rotation = -90\n\tamount.Text = \"\"\n\n\tfor _, child in amount:GetChildren() do\n\t\tif child:IsA(\"UITextSizeConstraint\") or child:IsA(\"UIScale\") then\n\t\t\tchild:Destroy()\n\t\tend\n\tend\n\tlocal stroke: UIStroke? = nil\n\tfor _, child in amount:GetChildren() do\n\t\tif child:IsA(\"UIStroke\") then\n\t\t\tif stroke == nil and child.Name == AMOUNT_STROKE_NAME then\n\t\t\t\tstroke = child\n\t\t\telse\n\t\t\t\tchild:Destroy()\n\t\t\tend\n\t\tend\n\tend\n\tif not stroke then\n\t\tstroke = Instance.new(\"UIStroke\")\n\t\tstroke.Name = AMOUNT_STROKE_NAME\n\t\tstroke.Parent = amount\n\tend\n\tlocal outline = stroke :: UIStroke\n\toutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual\n\toutline.Color = Color3.fromRGB(8, 8, 10)\n\toutline.Thickness = 2\n\toutline.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize\n\toutline.LineJoinMode = Enum.LineJoinMode.Round\n\toutline.Transparency = 0\n\treturn gui, amount\nend\n\nlocal function formatCashSnapshot(value: any): string\n\tlocal safe = if type(value) == \"number\" and value == value and value >= 0 then value else 0\n\treturn CurrencyFormatter.FormatCompactCash(math.floor(safe))\nend\n\nlocal function applyIncomeSnapshotToPlaque(\n\tplaque: BasePart,\n\tbaseId: string,\n\tplatformId: number,\n\townerUserId: number,\n\tsnapshot: any?\n)\n\tplaque:SetAttribute(\"BaseId\", baseId)\n\tplaque:SetAttribute(\"PlatformId\", platformId)\n\tplaque:SetAttribute(\"BaseOwnerUserId\", ownerUserId)\n\tif snapshot then\n\t\tplaque:SetAttribute(\"IncomeSnapshotReady\", true)\n\t\tplaque:SetAttribute(\"IncomeOccupied\", snapshot.Occupied == true)\n\t\tplaque:SetAttribute(\"IncomeRatePerSecond\", snapshot.RatePerSecond or 0)\n\t\tplaque:SetAttribute(\"UnclaimedCashSnapshot\", snapshot.UnclaimedCashSnapshot or 0)\n\t\tplaque:SetAttribute(\"IncomeSnapshotServerTime\", snapshot.SnapshotServerTime or 0)\n\t\tplaque:SetAttribute(\"IncomeRevision\", snapshot.Revision or 0)\n\telse\n\t\tplaque:SetAttribute(\"IncomeSnapshotReady\", false)\n\t\tplaque:SetAttribute(\"IncomeOccupied\", false)\n\t\tplaque:SetAttribute(\"IncomeRatePerSecond\", 0)\n\t\tplaque:SetAttribute(\"UnclaimedCashSnapshot\", 0)\n\t\tplaque:SetAttribute(\"IncomeSnapshotServerTime\", 0)\n\t\tplaque:SetAttribute(\"IncomeRevision\", 0)\n\tend\n\tlocal gui, label = ensureAmountView(plaque)\n\tlocal cash = plaque:GetAttribute(\"UnclaimedCashSnapshot\")\n\tlocal safeCash = if type(cash) == \"number\" and cash == cash and cash >= 0 then cash else 0\n\tlocal showAmount = plaque:GetAttribute(\"IncomeSnapshotReady\") == true\n\t\tand plaque:GetAttribute(\"IncomeOccupied\") == true\n\tlabel.Text = if showAmount then formatCashSnapshot(safeCash) else \"\"\n\tgui.Enabled = showAmount\nend\n\nlocal function candidatePlaques(base: Model): { BasePart }\n\tlocal result = {}\n\tfor _, descendant in base:GetDescendants() do\n\t\tif\n\t\t\tdescendant:IsA(\"BasePart\")\n\t\t\tand (\n\t\t\t\tCollectionService:HasTag(descendant, PLAQUE_TAG)\n\t\t\t\tor descendant.Name:match(\"^IncomePlaque_\") ~= nil\n\t\t\t)\n\t\tthen\n\t\t\ttable.insert(result, descendant)\n\t\tend\n\tend\n\treturn result\nend\n\nlocal function retirePlaque(plaque: BasePart)\n\tlocal binding = plaqueBindings[plaque]\n\tif binding and binding.TouchedConnection then\n\t\tbinding.TouchedConnection:Disconnect()\n\tend\n\tplaqueBindings[plaque] = nil\n\tCollectionService:RemoveTag(plaque, PLAQUE_TAG)\n\tplaque:Destroy()\nend\n\nlocal function characterFromTouchedPart(part: any): Model?\n\tif typeof(part) ~= \"Instance\" or not part:IsA(\"BasePart\") then\n\t\treturn nil\n\tend\n\tif part:FindFirstAncestorWhichIsA(\"Accessory\") or part:FindFirstAncestorWhichIsA(\"Tool\") then\n\t\treturn nil\n\tend\n\treturn part:FindFirstAncestorOfClass(\"Model\")\nend\n\nfunction BaseIncomePlaqueSystem:HandlePlaqueTouch(plaque: BasePart, touchedPart: any): any\n\tlocal binding = plaqueBindings[plaque]\n\tif not started or not binding or states[binding.Base] ~= binding.State then\n\t\treturn nil\n\tend\n\tlocal character = characterFromTouchedPart(touchedPart)\n\tlocal player = if character then getPlayerFromCharacter(character) else nil\n\tif\n\t\tplayer == nil\n\t\tor player.Parent ~= Players\n\t\tor player.Character ~= character\n\t\tor not touchedPart:IsDescendantOf(character)\n\tthen\n\t\treturn nil\n\tend\n\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid == nil or humanoid.Health <= 0 then\n\t\treturn nil\n\tend\n\t-- Touched is the trigger; TouchEnded is not a reliable lifetime boundary\n\t-- (limbs can be removed or contacts can disappear without the callback).\n\t-- Bound duplicate limb notifications by time, never by a permanent latch.\n\tlocal key = binding.BaseId .. \":\" .. tostring(binding.PlatformId)\n\tlocal attempts = touchAttempts[player]\n\tif not attempts then\n\t\tattempts = {}\n\t\ttouchAttempts[player] = attempts\n\tend\n\tlocal now = clock()\n\tif now < (attempts[key] or 0) then\n\t\treturn { ok = false, code = \"Busy\" }\n\tend\n\tattempts[key] = now + Config.PLAQUE_TOUCH_COOLDOWN_SECONDS\n\tlocal result = incomeSystem:TryClaimPlatform(player, binding.BaseId, binding.PlatformId)\n\tif result and result.ok then\n\t\tlocal snapshot = incomeSystem:GetPlatformIncomeSnapshot(binding.BaseId, binding.PlatformId)\n\t\tif snapshot then\n\t\t\tapplyIncomeSnapshotToPlaque(\n\t\t\t\tplaque,\n\t\t\t\tbinding.BaseId,\n\t\t\t\tbinding.PlatformId,\n\t\t\t\tbinding.OwnerUserId,\n\t\t\t\tsnapshot\n\t\t\t)\n\t\tend\n\t\tplaque:SetAttribute(\"LastClaimUserId\", player.UserId)\n\t\tplaque:SetAttribute(\"LastClaimAmount\", result.paid or 0)\n\t\tplaque:SetAttribute(\"ClaimResetAmount\", result.remainingExact or 0)\n\t\tlocal claimRevision = plaque:GetAttribute(\"ClaimRevision\")\n\t\tplaque:SetAttribute(\n\t\t\t\"ClaimRevision\",\n\t\t\t(if type(claimRevision) == \"number\" then claimRevision else 0) + 1\n\t\t)\n\tend\n\treturn result\nend\n\nlocal function bindPlaqueTouch(\n\tstate: any,\n\tplaque: BasePart,\n\tplatformId: number,\n\tclaimSensorCFrame: CFrame\n)\n\tlocal previous = plaqueBindings[plaque]\n\tif previous and previous.TouchedConnection then\n\t\tprevious.TouchedConnection:Disconnect()\n\tend\n\tlocal binding = {\n\t\tState = state,\n\t\tBase = state.Base,\n\t\tBaseId = state.BaseId,\n\t\tPlatformId = platformId,\n\t\tOwnerUserId = state.OwnerUserId,\n\t}\n\tlocal sensor = plaque:FindFirstChild(TOUCH_SENSOR_NAME)\n\tif sensor and not sensor:IsA(\"BasePart\") then\n\t\tsensor:Destroy()\n\t\tsensor = nil\n\tend\n\tif not sensor then\n\t\tsensor = Instance.new(\"Part\")\n\t\tsensor.Name = TOUCH_SENSOR_NAME\n\t\tsensor.Parent = plaque\n\tend\n\tlocal touchSensor = sensor :: BasePart\n\ttouchSensor.Size =\n\t\tVector3.new(PLAQUE_WIDTH_STUDS, Config.PLAQUE_TOUCH_HEIGHT_STUDS, PLAQUE_DEPTH_STUDS)\n\ttouchSensor.CFrame = claimSensorCFrame\n\ttouchSensor.Anchored = true\n\ttouchSensor.CanCollide = false\n\ttouchSensor.CanTouch = true\n\ttouchSensor.CanQuery = false\n\ttouchSensor.Massless = true\n\ttouchSensor.Transparency = 1\n\ttouchSensor.CastShadow = false\n\tbinding.Sensor = touchSensor\n\tbinding.TouchedConnection = touchSensor.Touched:Connect(function(otherPart)\n\t\tBaseIncomePlaqueSystem:HandlePlaqueTouch(plaque, otherPart)\n\tend)\n\tplaqueBindings[plaque] = binding\n\tstate.Plaques[platformId] = plaque\nend\n\nlocal function configurePlaque(\n\tstate: any,\n\tplaque: BasePart,\n\tplatformId: number,\n\tplacement: any,\n\tfloorTopY: number\n)\n\tplaque.Name = getPlaqueName(platformId)\n\tplaque.Size = Vector3.new(PLAQUE_WIDTH_STUDS, PLAQUE_THICKNESS_STUDS, PLAQUE_DEPTH_STUDS)\n\tplaque.Anchored = true\n\tplaque.CanCollide = false\n\tplaque.CanTouch = false\n\tplaque.CanQuery = true\n\tplaque.Massless = true\n\tplaque.Color = Color3.fromRGB(60, 255, 90)\n\tplaque.Transparency = 0\n\tStaticMaterial.Apply(plaque, Enum.Material.SmoothPlastic)\n\tplaque.TopSurface = Enum.SurfaceType.Smooth\n\tplaque.BottomSurface = Enum.SurfaceType.Smooth\n\tlocal inward = placement.PlatformNormalStuds / 2\n\t\t+ PLAQUE_PLATFORM_GAP_STUDS\n\t\t+ PLAQUE_DEPTH_STUDS / 2\n\tlocal plaqueX = placement.XCenter - placement.Side * inward\n\tlocal plaqueY = floorTopY + PLAQUE_FLOOR_CLEARANCE_STUDS + PLAQUE_THICKNESS_STUDS / 2\n\tlocal plaquePosition =\n\t\tstate.Root:PointToWorldSpace(Vector3.new(plaqueX, plaqueY, placement.ZCenter))\n\tlocal inwardDirection = state.Root:VectorToWorldSpace(Vector3.new(-placement.Side, 0, 0))\n\tlocal levelInward = Vector3.new(inwardDirection.X, 0, inwardDirection.Z).Unit\n\tplaque.CFrame = CFrame.lookAt(plaquePosition, plaquePosition + levelInward, Vector3.yAxis)\n\n\t-- The contact envelope follows this pad, not a second offset layout.\n\tlocal claimSensorCFrame = plaque.CFrame\n\t\t* CFrame.new(0, PLAQUE_THICKNESS_STUDS / 2 + Config.PLAQUE_TOUCH_HEIGHT_STUDS / 2, 0)\n\tif plaque:GetAttribute(\"ClaimRevision\") == nil then\n\t\tplaque:SetAttribute(\"ClaimRevision\", 0)\n\tend\n\tCollectionService:AddTag(plaque, PLAQUE_TAG)\n\tapplyIncomeSnapshotToPlaque(plaque, state.BaseId, platformId, state.OwnerUserId, nil)\n\tbindPlaqueTouch(state, plaque, platformId, claimSensorCFrame)\nend\n\nlocal function disconnectState(state: any)\n\tfor _, plaque in state.Plaques do\n\t\tlocal binding = plaqueBindings[plaque]\n\t\tif binding and binding.TouchedConnection then\n\t\t\tbinding.TouchedConnection:Disconnect()\n\t\tend\n\t\tplaqueBindings[plaque] = nil\n\tend\n\tif state.DestroyingConnection then\n\t\tstate.DestroyingConnection:Disconnect()\n\t\tstate.DestroyingConnection = nil\n\tend\n\ttable.clear(state.Plaques)\nend\n\nlocal function teardownBase(base: Model, destroyPlaques: boolean)\n\tlocal state = states[base]\n\tif state then\n\t\tdisconnectState(state)\n\t\tstates[base] = nil\n\tend\n\tfor _, plaque in candidatePlaques(base) do\n\t\tif destroyPlaques then\n\t\t\tretirePlaque(plaque)\n\t\telse\n\t\t\tplaque:SetAttribute(\"BaseOwnerUserId\", 0)\n\t\tend\n\tend\n\ttable.clear(touchAttempts)\nend\n\nlocal function applyPendingSnapshots(pending: { any })\n\tif #pending == 0 then\n\t\treturn\n\tend\n\tlocal snapshots = incomeSystem:SyncPlatformSnapshots(pending)\n\tfor index, request in pending do\n\t\tlocal snapshot = snapshots[index]\n\t\tif snapshot then\n\t\t\tapplyIncomeSnapshotToPlaque(\n\t\t\t\trequest.Plaque,\n\t\t\t\trequest.BaseId,\n\t\t\t\trequest.PlatformId,\n\t\t\t\trequest.OwnerUserId,\n\t\t\t\tsnapshot\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function refreshBaseSnapshots(base: Model, storage: any?, forceAll: boolean)\n\tlocal state = states[base]\n\tif not state then\n\t\treturn\n\tend\n\tlocal pending = {}\n\tfor platformId, plaque in state.Plaques do\n\t\tlocal snapshot = incomeSystem:GetPlatformIncomeSnapshot(state.BaseId, platformId)\n\t\tlocal record = if storage then storage:GetPlatformRecord(platformId) else nil\n\t\tlocal changed = forceAll\n\t\t\tor snapshot == nil\n\t\t\tor snapshot.Occupied ~= (record ~= nil)\n\t\t\tor snapshot.IndividualId ~= (if record then record.ItemId else nil)\n\t\t\tor snapshot.CatalogueId ~= (if record then record.BrainrotId else nil)\n\t\tif changed then\n\t\t\ttable.insert(pending, {\n\t\t\t\tBaseId = state.BaseId,\n\t\t\t\tPlatformId = platformId,\n\t\t\t\tPlaque = plaque,\n\t\t\t\tOwnerUserId = state.OwnerUserId,\n\t\t\t})\n\t\t\tcontinue\n\t\tend\n\t\tif snapshot then\n\t\t\tapplyIncomeSnapshotToPlaque(\n\t\t\t\tplaque,\n\t\t\t\tstate.BaseId,\n\t\t\t\tplatformId,\n\t\t\t\tstate.OwnerUserId,\n\t\t\t\tsnapshot\n\t\t\t)\n\t\tend\n\tend\n\tapplyPendingSnapshots(pending)\nend\n\nlocal function refreshAccumulatedPlaques()\n\tlocal pending = {}\n\tfor base, state in states do\n\t\tlocal player = if state.OwnerUserId ~= 0 then getPlayerByUserId(state.OwnerUserId) else nil\n\t\tlocal storage = if player then storageSystem:GetStorageForPlayer(player) else nil\n\t\tif storage and storage.Base == base then\n\t\t\tfor platformId, plaque in state.Plaques do\n\t\t\t\tlocal current = incomeSystem:GetPlatformIncomeSnapshot(state.BaseId, platformId)\n\t\t\t\tif current and current.Occupied then\n\t\t\t\t\ttable.insert(pending, {\n\t\t\t\t\t\tBaseId = state.BaseId,\n\t\t\t\t\t\tPlatformId = platformId,\n\t\t\t\t\t\tPlaque = plaque,\n\t\t\t\t\t\tOwnerUserId = state.OwnerUserId,\n\t\t\t\t\t})\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tapplyPendingSnapshots(pending)\nend\n\nfunction BaseIncomePlaqueSystem:BuildBase(base: Model, ownerUserId: number?): (boolean, string?)\n\tif typeof(base) ~= \"Instance\" or not base:IsA(\"Model\") or base.Parent == nil then\n\t\treturn false, \"INVALID_BASE\"\n\tend\n\tlocal slots = storageSystem:GetRegisteredPlatforms(base)\n\tif not slots or #slots ~= Config.PLATFORM_COUNT then\n\t\treturn false, \"INVALID_PLATFORMS\"\n\tend\n\t-- Resolve/validate before any teardown: marked compact data must never fall back.\n\tlocal geometry = Config.GetGeometry(base)\n\tteardownBase(base, false)\n\tlocal root = baseRootCFrame(base)\n\tlocal placementById, platformFloorY = positionPlatforms(root, slots, geometry)\n\tlocal floorTopY = ensureInterior(base, root, platformFloorY, geometry)\n\tlocal baseId = base:GetAttribute(\"BaseId\")\n\tif type(baseId) ~= \"string\" or baseId == \"\" then\n\t\treturn false, \"INVALID_BASE_ID\"\n\tend\n\tlocal state = {\n\t\tBase = base,\n\t\tBaseId = baseId,\n\t\tRoot = root,\n\t\tOwnerUserId = ownerUserId or 0,\n\t\tPlaques = {},\n\t}\n\tstates[base] = state\n\tlocal container = ensureFolder(base, PLAQUE_CONTAINER_NAME)\n\tlocal candidates = candidatePlaques(base)\n\tlocal used: { [BasePart]: boolean } = {}\n\tfor platformId = 1, Config.PLATFORM_COUNT do\n\t\tlocal expectedName = getPlaqueName(platformId)\n\t\tlocal selected: BasePart? = nil\n\t\tfor _, candidate in candidates do\n\t\t\tif\n\t\t\t\tnot used[candidate]\n\t\t\t\tand candidate.Name == expectedName\n\t\t\t\tand (\n\t\t\t\t\tcandidate:GetAttribute(\"PlatformId\") == nil\n\t\t\t\t\tor candidate:GetAttribute(\"PlatformId\") == platformId\n\t\t\t\t)\n\t\t\tthen\n\t\t\t\tselected = candidate\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif not selected then\n\t\t\tselected = Instance.new(\"Part\")\n\t\t\tselected.Parent = container\n\t\tend\n\t\tselected.Parent = container\n\t\tused[selected] = true\n\t\tconfigurePlaque(state, selected, platformId, placementById[platformId], floorTopY)\n\tend\n\tfor _, candidate in candidates do\n\t\tif not used[candidate] then\n\t\t\tretirePlaque(candidate)\n\t\tend\n\tend\n\tstate.DestroyingConnection = base.Destroying:Connect(function()\n\t\tteardownBase(base, true)\n\tend)\n\tif storageSystem.RefreshPlatformDisplays then\n\t\tstorageSystem:RefreshPlatformDisplays(base)\n\tend\n\treturn true, nil\nend\n\nfunction BaseIncomePlaqueSystem:GetPlaques(base: Model): { BasePart }\n\tlocal state = states[base]\n\tlocal result = {}\n\tif state then\n\t\tfor platformId = 1, Config.PLATFORM_COUNT do\n\t\t\tif state.Plaques[platformId] then\n\t\t\t\ttable.insert(result, state.Plaques[platformId])\n\t\t\tend\n\t\tend\n\tend\n\treturn result\nend\n\nfunction BaseIncomePlaqueSystem:Init(dependencies: any?): boolean\n\tif started then\n\t\treturn false\n\tend\n\tinitialDependencies = dependencies or {}\n\treturn true\nend\n\nfunction BaseIncomePlaqueSystem:Start(dependencies: any?): boolean\n\tif started then\n\t\treturn false\n\tend\n\tlocal deps = dependencies or initialDependencies or {}\n\tbaseSystem = deps.Base or PlayerBaseSystem\n\tstorageSystem = deps.Storage or BaseStorageSystem\n\tincomeSystem = deps.Income or BrainrotIncomeSystem\n\tclock = deps.Now or function(): number\n\t\treturn Workspace:GetServerTimeNow()\n\tend\n\tgetPlayerFromCharacter = deps.GetPlayerFromCharacter\n\t\tor function(character: Model): Player?\n\t\t\treturn Players:GetPlayerFromCharacter(character)\n\t\tend\n\tgetPlayerByUserId = deps.GetPlayerByUserId\n\t\tor function(userId: number): Player?\n\t\t\treturn Players:GetPlayerByUserId(userId)\n\t\tend\n\tstarted = true\n\n\tfor _, base in baseSystem:GetRegisteredBases() do\n\t\tlocal ownerUserId = base:GetAttribute(\"OwnerUserId\")\n\t\tlocal built, reason = self:BuildBase(\n\t\t\tbase,\n\t\t\tif type(ownerUserId) == \"number\" and ownerUserId ~= 0 then ownerUserId else 0\n\t\t)\n\t\tif not built then\n\t\t\tlog:Warn(\"Phase 5D layout unavailable for %s: %s\", base:GetFullName(), tostring(reason))\n\t\telseif type(ownerUserId) == \"number\" and ownerUserId ~= 0 then\n\t\t\tlocal player = getPlayerByUserId(ownerUserId)\n\t\t\tlocal storage = if player then storageSystem:GetStorageForPlayer(player) else nil\n\t\t\tif storage then\n\t\t\t\trefreshBaseSnapshots(base, storage, true)\n\t\t\tend\n\t\tend\n\tend\n\n\tassignmentConnection = baseSystem:SubscribeAssignments(function(player, base)\n\t\tlocal built, reason = self:BuildBase(base, player.UserId)\n\t\tif not built then\n\t\t\tlog:Warn(\"Phase 5D assignment layout failed: %s\", tostring(reason))\n\t\t\treturn\n\t\tend\n\t\tlocal storage = storageSystem:GetStorageForPlayer(player)\n\t\tif storage then\n\t\t\trefreshBaseSnapshots(base, storage, true)\n\t\tend\n\tend, function(_, base)\n\t\tteardownBase(base, false)\n\tend)\n\n\tunsubscribeStorage = storageSystem:ObserveStorage({\n\t\tOnBound = function(player, storage)\n\t\t\tlocal base = storage.Base\n\t\t\tif not states[base] then\n\t\t\t\tself:BuildBase(base, player.UserId)\n\t\t\tend\n\t\t\tlocal state = states[base]\n\t\t\tif state then\n\t\t\t\tstate.OwnerUserId = player.UserId\n\t\t\t\tfor _, binding in plaqueBindings do\n\t\t\t\t\tif binding.State == state then\n\t\t\t\t\t\tbinding.OwnerUserId = player.UserId\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\trefreshBaseSnapshots(base, storage, true)\n\t\t\tend\n\t\tend,\n\t\tOnCommitted = function(_, storage)\n\t\t\trefreshBaseSnapshots(storage.Base, storage, false)\n\t\tend,\n\t\tOnReleasing = function(_, storage)\n\t\t\trefreshBaseSnapshots(storage.Base, storage, false)\n\t\tend,\n\t})\n\tif deps.ConnectSnapshotRefresh ~= false then\n\t\tlocal heartbeat = deps.Heartbeat or RunService.Heartbeat\n\t\tsnapshotAccumulator = 0\n\t\tsnapshotConnection = heartbeat:Connect(function(deltaTime)\n\t\t\tsnapshotAccumulator += deltaTime\n\t\t\tif snapshotAccumulator >= PLAQUE_SNAPSHOT_REFRESH_SECONDS then\n\t\t\t\tsnapshotAccumulator %= PLAQUE_SNAPSHOT_REFRESH_SECONDS\n\t\t\t\trefreshAccumulatedPlaques()\n\t\t\tend\n\t\tend)\n\tend\n\treturn true\nend\n\nfunction BaseIncomePlaqueSystem:Destroy(): boolean\n\tif assignmentConnection then\n\t\tassignmentConnection:Disconnect()\n\t\tassignmentConnection = nil\n\tend\n\tif unsubscribeStorage then\n\t\tunsubscribeStorage()\n\t\tunsubscribeStorage = nil\n\tend\n\tif snapshotConnection then\n\t\tsnapshotConnection:Disconnect()\n\t\tsnapshotConnection = nil\n\tend\n\tsnapshotAccumulator = 0\n\tlocal bases = {}\n\tfor base in states do\n\t\ttable.insert(bases, base)\n\tend\n\tfor _, base in bases do\n\t\tteardownBase(base, false)\n\tend\n\ttable.clear(plaqueBindings)\n\ttable.clear(touchAttempts)\n\tstarted = false\n\tinitialDependencies = nil\n\tbaseSystem, storageSystem, incomeSystem =\n\t\tPlayerBaseSystem, BaseStorageSystem, BrainrotIncomeSystem\n\tclock = function(): number\n\t\treturn Workspace:GetServerTimeNow()\n\tend\n\tgetPlayerFromCharacter = function(character: Model): Player?\n\t\treturn Players:GetPlayerFromCharacter(character)\n\tend\n\tgetPlayerByUserId = function(userId: number): Player?\n\t\treturn Players:GetPlayerByUserId(userId)\n\tend\n\treturn true\nend\n\nreturn BaseIncomePlaqueSystem\n"},{"path":"ServerScriptService.Server.Systems.RegionSpawnCatalog","beforeSHA256":"9d0952524437e03e5591f66d0fe7919a7c356a7537e95324b56c70dc585af598","afterSHA256":"9987435c3ef3d014865cae29fb635ac52bd5275eadb3412d047631c90cc195cd","beforeBytes":50376,"afterBytes":52087,"proposal":"docs/map-compaction/source-patches/proposals/ServerScriptService/Server/Systems/RegionSpawnCatalog.lua","diff":"docs/map-compaction/source-patches/diffs/ServerScriptService/Server/Systems/RegionSpawnCatalog.diff","beforeSource":"--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal BrainrotCatalog = require(ReplicatedStorage.Shared.Config.BrainrotCatalog)\nlocal BrainrotTerritory = require(ReplicatedStorage.Shared.Config.BrainrotTerritory)\nlocal Regions = require(ReplicatedStorage.Shared.Config.Regions)\nlocal BrainrotVisualScale = require(ReplicatedStorage.Shared.Utility.BrainrotVisualScale)\nlocal Logger = require(ReplicatedStorage.Shared.Utility.Logger)\n\nexport type ValidationIssue = {\n\tseverity: \"Error\" | \"Warning\",\n\tcode: string,\n\tmessage: string,\n\tspeciesId: string?,\n\tregionId: string?,\n\tareaId: string?,\n}\n\nexport type ValidationReport = {\n\terrors: { ValidationIssue },\n\twarnings: { ValidationIssue },\n}\n\nexport type SpawnArea = {\n\tId: string,\n\tRegionId: string,\n\tKind: \"Point\" | \"Volume\",\n\tReference: string,\n\tPart: BasePart,\n\tEnabled: boolean,\n\tProbeCount: number,\n\tUsableProbeCount: number,\n\tIsFloorSurface: boolean,\n}\n\nexport type SelectionCandidate = {\n\tid: string,\n\ttier: string,\n\tassignmentStatus: string,\n\thomeRegionId: string?,\n\tallowedRegionIds: { string },\n\tspawnEnabled: boolean,\n\tlaunchStatus: string,\n\tnaturalSpawnEligible: boolean,\n\tmodelReady: boolean,\n\tbehaviourReady: boolean,\n\tlocationReady: boolean,\n\tglobalWithinTierWeight: number?,\n\treadinessReasons: { string },\n}\n\ntype MapArtFootprint = {\n\tid: string,\n\tregionId: string,\n\tminX: number,\n\tmaxX: number,\n\tminZ: number,\n\tmaxZ: number,\n}\n\ntype Index = {\n\tregionsById: { [string]: any },\n\tregionOrder: { string },\n\tspeciesById: { [string]: any },\n\tapprovedSpeciesByRegion: { [string]: { string } },\n\tareasByRegion: { [string]: { SpawnArea } },\n\tareasById: { [string]: SpawnArea },\n\tboundariesByRegion: { [string]: { BasePart } },\n\tprotectedInstances: { Instance },\n\tmapArtFootprints: { MapArtFootprint },\n\tmapArtFootprintsValid: boolean,\n\tmapArtEnvelopesByModelRef: { [string]: { LocalFrame: CFrame, Size: Vector3 } },\n\tenvelopesByModelRef: { [string]: { LocalFrame: CFrame, Size: Vector3 } },\n\tcontext: any,\n\treport: ValidationReport,\n}\n\nlocal RegionSpawnCatalog = {}\nlocal log = Logger.new(\"RegionSpawnCatalog\")\nlocal currentIndex: Index? = nil\nlocal started = false\n\nlocal READY_BEHAVIOURS = table.freeze({\n\tWanderer = true,\n\tReactiveRunner = true,\n\tSprinter = true,\n\tZigzag = true,\n\tCamouflage = true,\n\tDecoySplit = true,\n\tLegendaryPursuit = true,\n})\nlocal FLOOR_VERTICAL_TOLERANCE_STUDS = 8\n-- The fixed art schedule is at most 321 scenery + 18 Camp + 6 backdrop rows.\nlocal MAX_MAP_ART_FOOTPRINTS = 345\nlocal MAX_MAP_ART_MANIFEST_BYTES = 262144\n\nlocal function nonEmpty(value: any): boolean\n\treturn type(value) == \"string\" and string.match(value, \"%S\") ~= nil\nend\n\nlocal function finiteVector3(value: any): boolean\n\treturn typeof(value) == \"Vector3\"\n\t\tand value.X == value.X\n\t\tand math.abs(value.X) < math.huge\n\t\tand value.Y == value.Y\n\t\tand math.abs(value.Y) < math.huge\n\t\tand value.Z == value.Z\n\t\tand math.abs(value.Z) < math.huge\nend\n\nlocal function addIssue(\n\treport: ValidationReport,\n\tseverity: \"Error\" | \"Warning\",\n\tcode: string,\n\tmessage: string,\n\tspeciesId: string?,\n\tregionId: string?,\n\tareaId: string?\n)\n\tlocal item: ValidationIssue = {\n\t\tseverity = severity,\n\t\tcode = code,\n\t\tmessage = message,\n\t\tspeciesId = speciesId,\n\t\tregionId = regionId,\n\t\tareaId = areaId,\n\t}\n\ttable.insert(if severity == \"Error\" then report.errors else report.warnings, item)\nend\n\nlocal function cloneReport(report: ValidationReport): ValidationReport\n\treturn {\n\t\terrors = table.clone(report.errors),\n\t\twarnings = table.clone(report.warnings),\n\t}\nend\n\nlocal function resolvePath(root: Instance, reference: string): Instance?\n\tlocal current: Instance? = root\n\tlocal first = true\n\tfor segment in string.gmatch(reference, \"[^%./]+\") do\n\t\tif first and segment == root.Name then\n\t\t\tfirst = false\n\t\t\tcontinue\n\t\tend\n\t\tfirst = false\n\t\tcurrent = if current then current:FindFirstChild(segment) else nil\n\t\tif current == nil then\n\t\t\treturn nil\n\t\tend\n\tend\n\treturn current\nend\n\n-- Read a saved descriptor once while building the index. Never scan placed art\n-- or read the StringValue again on individual placement/roaming attempts.\nlocal function readInstalledMapArtFootprints(map: Instance?): (any, string?)\n\tlocal art = if map then map:FindFirstChild(\"MapArt\") else nil\n\tlocal manifest = if art then art:FindFirstChild(\"InstalledFootprints\") else nil\n\tif manifest == nil then\n\t\treturn {}, nil\n\tend\n\tif not manifest:IsA(\"StringValue\") or #manifest.Value > MAX_MAP_ART_MANIFEST_BYTES then\n\t\treturn nil, \"installed art manifest must be a bounded StringValue\"\n\tend\n\tlocal ok, decoded = pcall(function()\n\t\treturn HttpService:JSONDecode(manifest.Value)\n\tend)\n\tif not ok or decoded == nil then\n\t\treturn nil, \"installed art manifest is not valid JSON\"\n\tend\n\treturn decoded, nil\nend\n\nlocal function copyMapArtFootprints(raw: any): ({ MapArtFootprint }, string?)\n\tif type(raw) ~= \"table\" then\n\t\treturn {}, \"installed art footprints must be an array\"\n\tend\n\tlocal count = 0\n\tfor key in raw do\n\t\tif type(key) ~= \"number\" or key % 1 ~= 0 or key < 1 or key > MAX_MAP_ART_FOOTPRINTS then\n\t\t\treturn {}, \"installed art footprint array exceeds its bounded dense schema\"\n\t\tend\n\t\tcount += 1\n\tend\n\tif count ~= #raw then\n\t\treturn {}, \"installed art footprint array must be dense\"\n\tend\n\tfor key = 1, count do\n\t\tif raw[key] == nil then\n\t\t\treturn {}, \"installed art footprint array must be dense\"\n\t\tend\n\tend\n\tlocal copied: { MapArtFootprint } = {}\n\tlocal ids: { [string]: boolean } = {}\n\tfor _, row in raw do\n\t\tif type(row) ~= \"table\" or not nonEmpty(row.id) or #row.id > 128 or ids[row.id] then\n\t\t\treturn {}, \"installed art footprint IDs must be bounded and unique\"\n\t\tend\n\t\tlocal regionId = Regions.NormalizeId(row.regionId)\n\t\tif regionId == nil or regionId ~= row.regionId then\n\t\t\treturn {}, \"installed art footprint region must be canonical\"\n\t\tend\n\t\tfor _, key in { \"minX\", \"maxX\", \"minZ\", \"maxZ\" } do\n\t\t\tlocal value = row[key]\n\t\t\tif type(value) ~= \"number\" or value ~= value or math.abs(value) == math.huge then\n\t\t\t\treturn {}, \"installed art footprint bounds must be finite numbers\"\n\t\t\tend\n\t\tend\n\t\tif row.minX >= row.maxX or row.minZ >= row.maxZ then\n\t\t\treturn {}, \"installed art footprint bounds must have positive area\"\n\t\tend\n\t\tids[row.id] = true\n\t\ttable.insert(\n\t\t\tcopied,\n\t\t\ttable.freeze({\n\t\t\t\tid = row.id,\n\t\t\t\tregionId = regionId,\n\t\t\t\tminX = row.minX,\n\t\t\t\tmaxX = row.maxX,\n\t\t\t\tminZ = row.minZ,\n\t\t\t\tmaxZ = row.maxZ,\n\t\t\t})\n\t\t)\n\tend\n\treturn table.freeze(copied), nil\nend\n\n-- Pure bounded XZ test of the dedicated native art-clearance envelope. Include\n-- all three rotated half-axis projections so an outside centre or a rotated\n-- long model cannot hide an overlap. Edge-only contact has no positive area.\nlocal function overlapsMapArtFootprint(\n\tfootprints: { MapArtFootprint },\n\tregionId: string,\n\tframe: CFrame,\n\tsize: Vector3\n): boolean\n\tlocal half = size * 0.5\n\tlocal extentX = math.abs(frame.RightVector.X) * half.X\n\t\t+ math.abs(frame.UpVector.X) * half.Y\n\t\t+ math.abs(frame.LookVector.X) * half.Z\n\tlocal extentZ = math.abs(frame.RightVector.Z) * half.X\n\t\t+ math.abs(frame.UpVector.Z) * half.Y\n\t\t+ math.abs(frame.LookVector.Z) * half.Z\n\tlocal minX, maxX = frame.Position.X - extentX, frame.Position.X + extentX\n\tlocal minZ, maxZ = frame.Position.Z - extentZ, frame.Position.Z + extentZ\n\tfor _, row in footprints do\n\t\tif\n\t\t\trow.regionId == regionId\n\t\t\tand minX < row.maxX\n\t\t\tand maxX > row.minX\n\t\t\tand minZ < row.maxZ\n\t\t\tand maxZ > row.minZ\n\t\tthen\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function defaultContext(): any\n\tlocal studioAssets = ReplicatedStorage:FindFirstChild(\"StudioAssets\")\n\tlocal map = Workspace:FindFirstChild(\"MapBlockout\")\n\tlocal mapArtFootprints, mapArtFootprintsError = readInstalledMapArtFootprints(map)\n\tlocal protectedInstances: { Instance } = {}\n\tfor _, instance in\n\t\t{\n\t\t\tif map then map:FindFirstChild(\"PlayerBasePatches\") else nil,\n\t\t\tif map then map:FindFirstChild(\"ServiceStallPatches\") else nil,\n\t\t\tWorkspace:FindFirstChild(\"CartSpawns\"),\n\t\t}\n\tdo\n\t\tif instance then\n\t\t\ttable.insert(protectedInstances, instance)\n\t\tend\n\tend\n\treturn {\n\t\tRoot = Workspace,\n\t\tAssetFolder = if studioAssets then studioAssets:FindFirstChild(\"Brainrots\") else nil,\n\t\tProtectedInstances = protectedInstances,\n\t\tMapArtFootprints = mapArtFootprints,\n\t\tMapArtFootprintsError = mapArtFootprintsError,\n\t}\nend\n\nlocal function resolveReference(context: any, reference: string): Instance?\n\tif type(context.ResolveReference) == \"function\" then\n\t\treturn context.ResolveReference(reference)\n\tend\n\treturn resolvePath(context.Root or Workspace, reference)\nend\n\nlocal function isAuthoredFloor(part: BasePart): boolean\n\treturn part:GetAttribute(\"LayoutRole\") == \"Floor\"\n\t\tand nonEmpty(part:GetAttribute(\"CellId\"))\n\t\tand part:GetAttribute(\"GeneratedBy\") == \"CreateBasicMap_v1\"\nend\n\nlocal function collectBoundaryParts(instance: Instance): { BasePart }\n\tlocal parts: { BasePart } = {}\n\tif instance:IsA(\"BasePart\") then\n\t\ttable.insert(parts, instance)\n\tend\n\tfor _, descendant in instance:GetDescendants() do\n\t\tif\n\t\t\tdescendant:IsA(\"BasePart\")\n\t\t\tand (descendant:GetAttribute(\"RegionBoundary\") == true or isAuthoredFloor(descendant))\n\t\tthen\n\t\t\ttable.insert(parts, descendant)\n\t\tend\n\tend\n\treturn parts\nend\n\nlocal function collectAreaParts(instance: Instance): { BasePart }\n\tlocal parts: { BasePart } = {}\n\tif instance:IsA(\"BasePart\") then\n\t\ttable.insert(parts, instance)\n\tend\n\tfor _, descendant in instance:GetDescendants() do\n\t\tif\n\t\t\tdescendant:IsA(\"BasePart\")\n\t\t\tand (descendant:GetAttribute(\"SpawnAreaId\") ~= nil or isAuthoredFloor(descendant))\n\t\tthen\n\t\t\ttable.insert(parts, descendant)\n\t\tend\n\tend\n\treturn parts\nend\n\nlocal function probePositions(part: BasePart, kind: \"Point\" | \"Volume\"): { Vector3 }\n\tif kind == \"Point\" then\n\t\treturn { part.Position }\n\tend\n\tlocal points = {}\n\tfor _, x in { -0.35, 0, 0.35 } do\n\t\tfor _, z in { -0.35, 0, 0.35 } do\n\t\t\ttable.insert(\n\t\t\t\tpoints,\n\t\t\t\tpart.CFrame:PointToWorldSpace(\n\t\t\t\t\tVector3.new(\n\t\t\t\t\t\tpart.Size.X * x,\n\t\t\t\t\t\tif isAuthoredFloor(part) then part.Size.Y * 0.5 else -part.Size.Y * 0.5,\n\t\t\t\t\t\tpart.Size.Z * z\n\t\t\t\t\t)\n\t\t\t\t)\n\t\t\t)\n\t\tend\n\tend\n\treturn points\nend\n\nlocal function defaultProbeGround(point: Vector3, area: SpawnArea): boolean\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = if area.IsFloorSurface then {} else { area.Part }\n\tparams.RespectCanCollide = true\n\tparams.IgnoreWater = false\n\tlocal result = Workspace:Raycast(point + Vector3.yAxis * 4, -Vector3.yAxis * 8, params)\n\treturn result ~= nil\n\t\tand result.Material ~= Enum.Material.Water\n\t\tand result.Normal.Y >= BrainrotTerritory.MinWalkableNormalY\n\t\tand math.abs(result.Position.Y - point.Y) <= 2\nend\n\nlocal function countUsableProbes(area: SpawnArea, context: any): (number, number)\n\tlocal positions = probePositions(area.Part, area.Kind)\n\tlocal usable = 0\n\tfor _, point in positions do\n\t\tlocal accepted = if type(context.ProbeGround) == \"function\"\n\t\t\tthen context.ProbeGround(point, area)\n\t\t\telse defaultProbeGround(point, area)\n\t\tif accepted then\n\t\t\tusable += 1\n\t\tend\n\tend\n\treturn #positions, usable\nend\n\nlocal function containsPoint(part: BasePart, point: Vector3, margin: Vector3?): boolean\n\tlocal localPoint = part.CFrame:PointToObjectSpace(point)\n\tlocal half = part.Size * 0.5\n\tlocal inset = margin or Vector3.zero\n\treturn math.abs(localPoint.X) <= math.max(0, half.X - inset.X)\n\t\tand math.abs(localPoint.Y) <= math.max(0, half.Y - inset.Y)\n\t\tand math.abs(localPoint.Z) <= math.max(0, half.Z - inset.Z)\nend\n\nlocal function containsSurfacePoint(part: BasePart, point: Vector3, margin: Vector3?): boolean\n\tlocal localPoint = part.CFrame:PointToObjectSpace(point)\n\tlocal half = part.Size * 0.5\n\tlocal inset = margin or Vector3.zero\n\treturn math.abs(localPoint.X) <= math.max(0, half.X - inset.X)\n\t\tand math.abs(localPoint.Z) <= math.max(0, half.Z - inset.Z)\nend\n\nlocal function boxCorners(frame: CFrame, size: Vector3): { Vector3 }\n\tlocal corners = {}\n\tlocal half = size * 0.5\n\tfor _, x in { -1, 1 } do\n\t\tfor _, y in { -1, 1 } do\n\t\t\tfor _, z in { -1, 1 } do\n\t\t\t\ttable.insert(corners, frame:PointToWorldSpace(half * Vector3.new(x, y, z)))\n\t\t\tend\n\t\tend\n\tend\n\treturn corners\nend\n\nlocal function boxFitsPart(\n\tframe: CFrame,\n\tsize: Vector3,\n\tcontainer: BasePart,\n\tboundaryPadding: number?\n): boolean\n\tlocal padding = math.max(0, boundaryPadding or 0)\n\tlocal inset = Vector3.new(padding, 0, padding)\n\tlocal minimumSurfaceY = math.huge\n\tfor _, corner in boxCorners(frame, size) do\n\t\tlocal contains = if isAuthoredFloor(container)\n\t\t\tthen containsSurfacePoint(container, corner, inset)\n\t\t\telse containsPoint(container, corner, inset)\n\t\tif not contains then\n\t\t\treturn false\n\t\tend\n\t\tif isAuthoredFloor(container) then\n\t\t\tminimumSurfaceY =\n\t\t\t\tmath.min(minimumSurfaceY, container.CFrame:PointToObjectSpace(corner).Y)\n\t\tend\n\tend\n\tif isAuthoredFloor(container) then\n\t\tlocal surfaceY = container.Size.Y * 0.5\n\t\treturn minimumSurfaceY >= surfaceY - 2\n\t\t\tand minimumSurfaceY <= surfaceY + FLOOR_VERTICAL_TOLERANCE_STUDS\n\tend\n\treturn true\nend\n\nlocal function boxesOverlapByCorners(leftFrame: CFrame, leftSize: Vector3, right: BasePart): boolean\n\tif isAuthoredFloor(right) then\n\t\tlocal minimumY, maximumY = math.huge, -math.huge\n\t\tfor _, corner in boxCorners(leftFrame, leftSize) do\n\t\t\tlocal localPoint = right.CFrame:PointToObjectSpace(corner)\n\t\t\tminimumY, maximumY = math.min(minimumY, localPoint.Y), math.max(maximumY, localPoint.Y)\n\t\tend\n\t\tlocal surfaceY = right.Size.Y * 0.5\n\t\tif maximumY < surfaceY - 2 or minimumY > surfaceY + FLOOR_VERTICAL_TOLERANCE_STUDS then\n\t\t\treturn false\n\t\tend\n\tend\n\tlocal rightContains = if isAuthoredFloor(right) then containsSurfacePoint else containsPoint\n\tif rightContains(right, leftFrame.Position) then\n\t\treturn true\n\tend\n\tfor _, corner in boxCorners(leftFrame, leftSize) do\n\t\tif rightContains(right, corner) then\n\t\t\treturn true\n\t\tend\n\tend\n\tfor _, corner in boxCorners(right.CFrame, right.Size) do\n\t\tlocal localPoint = leftFrame:PointToObjectSpace(corner)\n\t\tlocal half = leftSize * 0.5\n\t\tif\n\t\t\tmath.abs(localPoint.X) <= half.X\n\t\t\tand (isAuthoredFloor(right) or math.abs(localPoint.Y) <= half.Y)\n\t\t\tand math.abs(localPoint.Z) <= half.Z\n\t\tthen\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function getModel(index: Index, definition: any): Model?\n\tif type(index.context.ResolveModel) == \"function\" then\n\t\tlocal model = index.context.ResolveModel(definition)\n\t\treturn if model and model:IsA(\"Model\") then model else nil\n\tend\n\tlocal folder = index.context.AssetFolder\n\tlocal model = if folder and folder:IsA(\"Instance\")\n\t\tthen folder:FindFirstChild(definition.modelRef)\n\t\telse nil\n\treturn if model and model:IsA(\"Model\") then model else nil\nend\n\nlocal function getEnvelope(index: Index, definition: any): (CFrame?, Vector3?, string?)\n\tlocal cached = index.envelopesByModelRef[definition.modelRef]\n\tif cached then\n\t\treturn cached.LocalFrame, cached.Size, nil\n\tend\n\tlocal model = getModel(index, definition)\n\tif model == nil then\n\t\treturn nil, nil, \"MODEL_MISSING\"\n\tend\n\tlocal body = model:FindFirstChild(\"Body\", true)\n\tif body == nil or not body:IsA(\"BasePart\") or not body.CanQuery then\n\t\treturn nil, nil, \"MODEL_MISSING\"\n\tend\n\t-- Use the same effect-free visible bounds that the existing world factory uses\n\t-- to ground a model. Body remains the required capture identity, while authored\n\t-- limbs and props still have to fit the placement clearance.\n\tlocal localFrame, size, reason = BrainrotVisualScale.GetVisualBounds(model)\n\tif localFrame and size then\n\t\t-- The world factory canonicalizes every source to the shared gameplay height\n\t\t-- before activation. Apply that same pivot-relative scale mathematically here\n\t\t-- so placement checks use the real world envelope without cloning or mutating\n\t\t-- the authored source asset on every candidate attempt.\n\t\tlocal correction = BrainrotVisualScale.TARGET_HEIGHT_STUDS / size.Y\n\t\tif correction ~= correction or correction <= 0 or correction == math.huge then\n\t\t\treturn nil, nil, \"INVALID_VISIBLE_BOUNDS\"\n\t\tend\n\t\tlocalFrame = CFrame.new(localFrame.Position * correction) * localFrame.Rotation\n\t\tsize *= correction\n\t\tindex.envelopesByModelRef[definition.modelRef] = table.freeze({\n\t\t\tLocalFrame = localFrame,\n\t\t\tSize = size,\n\t\t})\n\tend\n\treturn localFrame, size, reason\nend\n\n-- This envelope serves only the new installed-art exclusion. Keep the existing\n-- source proxy, canonical scale, grounding and all other predicates unchanged.\n-- Native unions may have an Extents origin distinct from their main-part CFrame.\nlocal function getMapArtEnvelope(index: Index, definition: any): (CFrame?, Vector3?, string?)\n\tlocal cached = index.mapArtEnvelopesByModelRef[definition.modelRef]\n\tif cached then\n\t\treturn cached.LocalFrame, cached.Size, nil\n\tend\n\tlocal model = getModel(index, definition)\n\tif model == nil then\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\t-- The shared factory derives its factor from the original CFrame/Size bounds.\n\t-- Changing that factor to ExtentsSize here would change accepted model scale.\n\tlocal _, sourceSize = BrainrotVisualScale.GetVisualBounds(model)\n\tif sourceSize == nil then\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\tlocal correction = BrainrotVisualScale.TARGET_HEIGHT_STUDS / sourceSize.Y\n\tif correction ~= correction or correction <= 0 or correction == math.huge then\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\tlocal pivot = model:GetPivot()\n\tlocal low, high = Vector3.one * math.huge, Vector3.one * -math.huge\n\tlocal count = 0\n\tfor _, descendant in model:GetDescendants() do\n\t\tif descendant:IsA(\"BasePart\") and BrainrotVisualScale.IsVisualPart(descendant, model) then\n\t\t\tlocal frame = if descendant:IsA(\"PartOperation\")\n\t\t\t\tthen descendant.ExtentsCFrame\n\t\t\t\telse descendant.CFrame\n\t\t\tlocal size = if descendant:IsA(\"PartOperation\")\n\t\t\t\tthen descendant.ExtentsSize\n\t\t\t\telse descendant.Size\n\t\t\tfor _, corner in boxCorners(frame, size) do\n\t\t\t\tlocal point = pivot:PointToObjectSpace(corner)\n\t\t\t\tlow, high = low:Min(point), high:Max(point)\n\t\t\tend\n\t\t\tcount += 1\n\t\tend\n\tend\n\tlocal size = (high - low) * correction\n\tlocal centre = (low + high) * (0.5 * correction)\n\tif\n\t\tcount == 0\n\t\tor not finiteVector3(centre)\n\t\tor not finiteVector3(size)\n\t\tor size.X <= 0\n\t\tor size.Y <= 0\n\t\tor size.Z <= 0\n\tthen\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\tlocal localFrame = CFrame.new(centre)\n\tindex.mapArtEnvelopesByModelRef[definition.modelRef] = table.freeze({\n\t\tLocalFrame = localFrame,\n\t\tSize = size,\n\t})\n\treturn localFrame, size, nil\nend\n\nlocal function behaviourReady(index: Index, definition: any): boolean\n\tif type(index.context.IsBehaviourReady) == \"function\" then\n\t\treturn index.context.IsBehaviourReady(definition.behaviourId, definition)\n\tend\n\treturn READY_BEHAVIOURS[definition.behaviourId] == true\nend\n\nlocal function current(): Index\n\tif currentIndex == nil then\n\t\tRegionSpawnCatalog.BuildIndex(Regions.GetAll(), BrainrotCatalog.GetAll(), nil)\n\tend\n\treturn currentIndex :: Index\nend\n\nfunction RegionSpawnCatalog.BuildIndex(\n\tregionDefinitions: { any }?,\n\tspeciesDefinitions: { any }?,\n\tmapContext: any?\n): ValidationReport\n\tlocal report: ValidationReport = { errors = {}, warnings = {} }\n\tlocal context = mapContext or defaultContext()\n\tlocal mapArtFootprints, mapArtFootprintsError = copyMapArtFootprints(\n\t\tif context.MapArtFootprints == nil then {} else context.MapArtFootprints\n\t)\n\tmapArtFootprintsError = context.MapArtFootprintsError or mapArtFootprintsError\n\tif mapArtFootprintsError then\n\t\taddIssue(report, \"Error\", \"INVALID_MAP_ART_FOOTPRINTS\", mapArtFootprintsError)\n\tend\n\tlocal index: Index = {\n\t\tregionsById = {},\n\t\tregionOrder = {},\n\t\tspeciesById = {},\n\t\tapprovedSpeciesByRegion = {},\n\t\tareasByRegion = {},\n\t\tareasById = {},\n\t\tboundariesByRegion = {},\n\t\tprotectedInstances = table.clone(context.ProtectedInstances or {}),\n\t\tmapArtFootprints = mapArtFootprints,\n\t\tmapArtFootprintsValid = mapArtFootprintsError == nil,\n\t\tmapArtEnvelopesByModelRef = {},\n\t\tenvelopesByModelRef = {},\n\t\tcontext = context,\n\t\treport = report,\n\t}\n\n\tfor _, definition in regionDefinitions or Regions.GetAll() do\n\t\tlocal regionId = Regions.NormalizeId(definition.id)\n\t\tif regionId == nil or regionId ~= definition.id then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"UNKNOWN_REGION\",\n\t\t\t\t\"region definition has a non-canonical ID\",\n\t\t\t\tnil,\n\t\t\t\tdefinition.id,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tif index.regionsById[regionId] then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"DUPLICATE_REGION_ID\",\n\t\t\t\t\"region ID is declared more than once\",\n\t\t\t\tnil,\n\t\t\t\tregionId,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tindex.regionsById[regionId] = definition\n\t\ttable.insert(index.regionOrder, regionId)\n\t\tindex.approvedSpeciesByRegion[regionId] = {}\n\t\tindex.areasByRegion[regionId] = {}\n\t\tindex.boundariesByRegion[regionId] = {}\n\n\t\tif definition.kind == \"Hub\" and definition.naturalSpawnAllowed == true then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"CAMP_NOT_SPAWNABLE\",\n\t\t\t\t\"hub regions cannot permit natural spawning\",\n\t\t\t\tnil,\n\t\t\t\tregionId,\n\t\t\t\tnil\n\t\t\t)\n\t\tend\n\t\tif regionId == Regions.CampId and #(definition.spawnAreaRefs or {}) > 0 then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"CAMP_NOT_SPAWNABLE\",\n\t\t\t\t\"Camp must not reference natural spawn areas\",\n\t\t\t\tnil,\n\t\t\t\tregionId,\n\t\t\t\tnil\n\t\t\t)\n\t\tend\n\n\t\tfor _, reference in definition.boundaryRefs or {} do\n\t\t\tlocal instance = resolveReference(context, reference)\n\t\t\tif instance == nil then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_REGION_BOUNDARY\",\n\t\t\t\t\t\"boundary reference does not resolve: \" .. reference,\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\telse\n\t\t\t\tfor _, part in collectBoundaryParts(instance) do\n\t\t\t\t\ttable.insert(index.boundariesByRegion[regionId], part)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tfor _, reference in definition.spawnAreaRefs or {} do\n\t\t\tlocal instance = resolveReference(context, reference)\n\t\t\tif instance == nil then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_SPAWN_AREA\",\n\t\t\t\t\t\"spawn-area reference does not resolve: \" .. reference,\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal parts = collectAreaParts(instance)\n\t\t\tif #parts == 0 then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_SPAWN_AREA\",\n\t\t\t\t\t\"spawn-area reference contains no BaseParts: \" .. reference,\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\t\tfor _, part in parts do\n\t\t\t\tlocal floorSurface = isAuthoredFloor(part)\n\t\t\t\tlocal areaId = part:GetAttribute(\"SpawnAreaId\")\n\t\t\t\tif floorSurface and not nonEmpty(areaId) then\n\t\t\t\t\tareaId = regionId .. \":\" .. tostring(part:GetAttribute(\"CellId\"))\n\t\t\t\tend\n\t\t\t\tlocal areaRegionId = Regions.NormalizeId(part:GetAttribute(\"RegionId\"))\n\t\t\t\tif floorSurface and areaRegionId == nil then\n\t\t\t\t\tareaRegionId = regionId\n\t\t\t\tend\n\t\t\t\tlocal kind = part:GetAttribute(\"SpawnAreaKind\")\n\t\t\t\tif floorSurface and kind == nil then\n\t\t\t\t\tkind = \"Volume\"\n\t\t\t\tend\n\t\t\t\tif not nonEmpty(areaId) or (kind ~= \"Point\" and kind ~= \"Volume\") then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"INVALID_SPAWN_AREA\",\n\t\t\t\t\t\t\"spawn area needs SpawnAreaId and Point/Volume kind\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tif type(areaId) == \"string\" then areaId else nil\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif areaRegionId ~= regionId then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"SPAWN_AREA_REGION_MISMATCH\",\n\t\t\t\t\t\t\"spawn area RegionId does not match its configured region\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif index.areasById[areaId] then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"DUPLICATE_SPAWN_AREA_ID\",\n\t\t\t\t\t\t\"SpawnAreaId is declared more than once\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif not part.Anchored then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"INVALID_SPAWN_AREA\",\n\t\t\t\t\t\t\"spawn area must be anchored\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif\n\t\t\t\t\tkind == \"Point\"\n\t\t\t\t\tand (part.CanCollide or part.CanTouch or part.CanQuery or part.CastShadow)\n\t\t\t\tthen\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"INVALID_SPAWN_AREA\",\n\t\t\t\t\t\t\"point helper must not collide, touch, query or cast shadows\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tlocal enabledAttribute = part:GetAttribute(\"Enabled\")\n\t\t\t\tlocal area: SpawnArea = {\n\t\t\t\t\tId = areaId,\n\t\t\t\t\tRegionId = regionId,\n\t\t\t\t\tKind = kind,\n\t\t\t\t\tReference = reference,\n\t\t\t\t\tPart = part,\n\t\t\t\t\tEnabled = if type(enabledAttribute) == \"boolean\"\n\t\t\t\t\t\tthen enabledAttribute\n\t\t\t\t\t\telse true,\n\t\t\t\t\tProbeCount = 0,\n\t\t\t\t\tUsableProbeCount = 0,\n\t\t\t\t\tIsFloorSurface = floorSurface,\n\t\t\t\t}\n\t\t\t\tarea.ProbeCount, area.UsableProbeCount = countUsableProbes(area, context)\n\t\t\t\ttable.freeze(area)\n\t\t\t\tindex.areasById[area.Id] = area\n\t\t\t\ttable.insert(index.areasByRegion[regionId], area)\n\t\t\t\tif area.Enabled and area.UsableProbeCount == 0 then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Warning\",\n\t\t\t\t\t\t\"NO_VALID_GROUND\",\n\t\t\t\t\t\t\"spawn area has no usable deterministic ground probes\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tarea.Id\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif definition.enabled == true and definition.kind == \"Hunting\" then\n\t\t\tif #index.boundariesByRegion[regionId] == 0 then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_REGION_BOUNDARY\",\n\t\t\t\t\t\"enabled hunting region has no resolved boundary\",\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\t\tif definition.naturalSpawnAllowed == true and #index.areasByRegion[regionId] == 0 then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_SPAWN_AREA\",\n\t\t\t\t\t\"enabled hunting region has no registered spawn areas\",\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\tend\n\tend\n\n\tfor _, definition in speciesDefinitions or BrainrotCatalog.GetAll() do\n\t\tlocal speciesId = BrainrotCatalog.NormalizeId(definition.id)\n\t\tif speciesId == nil or speciesId ~= definition.id then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"UNKNOWN_SPECIES\",\n\t\t\t\t\"species definition has a non-canonical ID\",\n\t\t\t\tdefinition.id,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tif index.speciesById[speciesId] then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"DUPLICATE_SPECIES_ID\",\n\t\t\t\t\"species ID is declared more than once\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tindex.speciesById[speciesId] = definition\n\t\tlocal status = definition.regionAssignmentStatus\n\t\tif status == \"Pending\" then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Warning\",\n\t\t\t\t\"REGION_ASSIGNMENT_PENDING\",\n\t\t\t\t\"current-map assignment requires approval\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\telseif status == \"Conflict\" then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Warning\",\n\t\t\t\t\"REGION_ASSIGNMENT_CONFLICT\",\n\t\t\t\t\"approved sources conflict\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\telseif status == \"Approved\" then\n\t\t\tlocal homeRegionId = Regions.NormalizeId(definition.homeRegionId)\n\t\t\tlocal allowedSet: { [string]: boolean } = {}\n\t\t\tfor _, rawRegionId in definition.allowedRegionIds or {} do\n\t\t\t\tlocal regionId = Regions.NormalizeId(rawRegionId)\n\t\t\t\tif regionId == nil or index.regionsById[regionId] == nil then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"UNKNOWN_REGION\",\n\t\t\t\t\t\t\"approved assignment references an unknown region\",\n\t\t\t\t\t\tspeciesId,\n\t\t\t\t\t\trawRegionId,\n\t\t\t\t\t\tnil\n\t\t\t\t\t)\n\t\t\t\telseif regionId == Regions.CampId then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"CAMP_NOT_SPAWNABLE\",\n\t\t\t\t\t\t\"Camp cannot be an allowed natural-spawn region\",\n\t\t\t\t\t\tspeciesId,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tnil\n\t\t\t\t\t)\n\t\t\t\telseif allowedSet[regionId] then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"DUPLICATE_ALLOWED_REGION\",\n\t\t\t\t\t\t\"approved assignment repeats a region\",\n\t\t\t\t\t\tspeciesId,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tnil\n\t\t\t\t\t)\n\t\t\t\telse\n\t\t\t\t\tallowedSet[regionId] = true\n\t\t\t\t\ttable.insert(index.approvedSpeciesByRegion[regionId], speciesId)\n\t\t\t\tend\n\t\t\tend\n\t\t\tif homeRegionId == nil or not allowedSet[homeRegionId] then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"HOME_NOT_ALLOWED\",\n\t\t\t\t\t\"approved home must appear in the allowed list\",\n\t\t\t\t\tspeciesId,\n\t\t\t\t\thomeRegionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\telse\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"INVALID_REGION_ASSIGNMENT_STATUS\",\n\t\t\t\t\"assignment status is invalid\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\tend\n\tend\n\n\tfor _, speciesIds in index.approvedSpeciesByRegion do\n\t\ttable.sort(speciesIds)\n\tend\n\tfor _, areas in index.areasByRegion do\n\t\ttable.sort(areas, function(left, right)\n\t\t\treturn left.Id < right.Id\n\t\tend)\n\tend\n\tfor _, boundary in index.boundariesByRegion[Regions.CampId] or {} do\n\t\ttable.insert(index.protectedInstances, boundary)\n\tend\n\tcurrentIndex = index\n\treturn cloneReport(report)\nend\n\nfunction RegionSpawnCatalog.GetSpeciesAssignment(speciesId: unknown): any?\n\tlocal index = current()\n\tlocal normalized = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal definition = if normalized then index.speciesById[normalized] else nil\n\tif definition == nil then\n\t\treturn nil\n\tend\n\treturn table.freeze({\n\t\thomeRegionId = definition.homeRegionId,\n\t\tallowedRegionIds = table.freeze(table.clone(definition.allowedRegionIds or {})),\n\t\tstatus = definition.regionAssignmentStatus,\n\t})\nend\n\nfunction RegionSpawnCatalog.ResolveHomeRegion(speciesId: unknown): (string?, string?)\n\tlocal assignment = RegionSpawnCatalog.GetSpeciesAssignment(speciesId)\n\tif assignment == nil then\n\t\treturn nil, \"UNKNOWN_SPECIES\"\n\tend\n\tif assignment.status ~= \"Approved\" then\n\t\treturn nil,\n\t\t\tif assignment.status == \"Conflict\"\n\t\t\t\tthen \"REGION_ASSIGNMENT_CONFLICT\"\n\t\t\t\telse \"REGION_ASSIGNMENT_PENDING\"\n\tend\n\tlocal homeRegionId = Regions.NormalizeId(assignment.homeRegionId)\n\tlocal region = if homeRegionId then Regions.Get(homeRegionId) else nil\n\tif region == nil or region.kind ~= \"Hunting\" or region.naturalSpawnAllowed ~= true then\n\t\treturn nil, \"INVALID_HOME_REGION\"\n\tend\n\tfor _, rawRegionId in assignment.allowedRegionIds do\n\t\tif Regions.NormalizeId(rawRegionId) == homeRegionId then\n\t\t\treturn homeRegionId, nil\n\t\tend\n\tend\n\treturn nil, \"HOME_NOT_ALLOWED\"\nend\n\nfunction RegionSpawnCatalog.IsSpeciesAllowedInRegion(speciesId: unknown, regionId: unknown): boolean\n\tlocal index = current()\n\tlocal normalizedSpecies = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal definition = if normalizedSpecies then index.speciesById[normalizedSpecies] else nil\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif\n\t\tdefinition == nil\n\t\tor region == nil\n\t\tor normalizedRegion == Regions.CampId\n\t\tor region.kind ~= \"Hunting\"\n\t\tor not region.naturalSpawnAllowed\n\t\tor definition.regionAssignmentStatus ~= \"Approved\"\n\tthen\n\t\treturn false\n\tend\n\tfor _, allowedRegionId in definition.allowedRegionIds or {} do\n\t\tif allowedRegionId == normalizedRegion then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nfunction RegionSpawnCatalog.GetApprovedSpeciesIds(regionId: unknown): { string }\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil or normalized == Regions.CampId then\n\t\treturn {}\n\tend\n\treturn table.clone(index.approvedSpeciesByRegion[normalized] or {})\nend\n\nfunction RegionSpawnCatalog.GetSpawnAreas(regionId: unknown): { SpawnArea }\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil or normalized == Regions.CampId then\n\t\treturn {}\n\tend\n\treturn table.clone(index.areasByRegion[normalized] or {})\nend\n\nfunction RegionSpawnCatalog.ContainsPosition(\n\tregionId: unknown,\n\tposition: unknown,\n\tverticalTolerance: number?\n): boolean\n\tif not finiteVector3(position) then\n\t\treturn false\n\tend\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil then\n\t\treturn false\n\tend\n\tlocal tolerance = verticalTolerance\n\tif type(tolerance) ~= \"number\" or tolerance ~= tolerance or tolerance < 0 then\n\t\ttolerance = FLOOR_VERTICAL_TOLERANCE_STUDS\n\tend\n\tfor _, boundary in index.boundariesByRegion[normalized] or {} do\n\t\tif isAuthoredFloor(boundary) then\n\t\t\tlocal localPoint = boundary.CFrame:PointToObjectSpace(position :: Vector3)\n\t\t\tif\n\t\t\t\tcontainsSurfacePoint(boundary, position :: Vector3)\n\t\t\t\tand math.abs(localPoint.Y - boundary.Size.Y * 0.5) <= tolerance\n\t\t\tthen\n\t\t\t\treturn true\n\t\t\tend\n\t\telseif containsPoint(boundary, position :: Vector3) then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nfunction RegionSpawnCatalog.GetRegionAtPosition(position: unknown): any?\n\tlocal index = current()\n\tfor _, regionId in index.regionOrder do\n\t\tif RegionSpawnCatalog.ContainsPosition(regionId, position) then\n\t\t\treturn index.regionsById[regionId]\n\t\tend\n\tend\n\treturn nil\nend\n\n-- Supplies static, reference-free selector inputs from the authoritative Phase\n-- 6F-1 relationship. It deliberately returns approved regional members only;\n-- SpawnSelection still validates every field and never owns a second species list.\nfunction RegionSpawnCatalog.GetSelectionCandidates(regionId: unknown): { SelectionCandidate }\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil or normalized == Regions.CampId then\n\t\treturn {}\n\tend\n\tlocal candidates: { SelectionCandidate } = {}\n\tfor _, speciesId in index.approvedSpeciesByRegion[normalized] or {} do\n\t\tlocal definition = index.speciesById[speciesId]\n\t\tif definition == nil then\n\t\t\tcontinue\n\t\tend\n\t\tlocal readiness = RegionSpawnCatalog.EvaluateNaturalSpawnReadiness(speciesId, normalized)\n\t\tlocal reasonSet: { [string]: boolean } = {}\n\t\tfor _, reason in readiness.reasons do\n\t\t\treasonSet[reason] = true\n\t\tend\n\t\tlocal reasons = table.freeze(table.clone(readiness.reasons))\n\t\tlocal allowedRegionIds = table.freeze(table.clone(definition.allowedRegionIds or {}))\n\t\tlocal candidate: SelectionCandidate = {\n\t\t\tid = speciesId,\n\t\t\ttier = definition.tier,\n\t\t\tassignmentStatus = definition.regionAssignmentStatus,\n\t\t\thomeRegionId = definition.homeRegionId,\n\t\t\tallowedRegionIds = allowedRegionIds,\n\t\t\tspawnEnabled = definition.spawnEnabled == true,\n\t\t\tlaunchStatus = definition.launchStatus,\n\t\t\tnaturalSpawnEligible = definition.launchStatus == \"Live\",\n\t\t\tmodelReady = reasonSet.MODEL_MISSING ~= true,\n\t\t\tbehaviourReady = reasonSet.BEHAVIOUR_NOT_READY ~= true,\n\t\t\tlocationReady = reasonSet.MISSING_REGION_BOUNDARY ~= true\n\t\t\t\tand reasonSet.MISSING_SPAWN_AREA ~= true,\n\t\t\t-- No catalogue field currently has verified within-tier-weight semantics.\n\t\t\tglobalWithinTierWeight = nil,\n\t\t\treadinessReasons = reasons,\n\t\t}\n\t\ttable.freeze(candidate)\n\t\ttable.insert(candidates, candidate)\n\tend\n\treturn candidates\nend\n\nfunction RegionSpawnCatalog.EvaluateNaturalSpawnReadiness(\n\tspeciesId: unknown,\n\tregionId: unknown\n): any\n\tlocal index = current()\n\tlocal reasons: { string } = {}\n\tlocal activationReasons: { string } = {}\n\tlocal normalizedSpecies = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal definition = if normalizedSpecies then index.speciesById[normalizedSpecies] else nil\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif definition == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_SPECIES\")\n\telseif definition.regionAssignmentStatus == \"Pending\" then\n\t\ttable.insert(reasons, \"REGION_ASSIGNMENT_PENDING\")\n\telseif definition.regionAssignmentStatus == \"Conflict\" then\n\t\ttable.insert(reasons, \"REGION_ASSIGNMENT_CONFLICT\")\n\tend\n\tif region == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_REGION\")\n\telseif\n\t\tnormalizedRegion == Regions.CampId\n\t\tor region.kind ~= \"Hunting\"\n\t\tor not region.naturalSpawnAllowed\n\tthen\n\t\ttable.insert(reasons, \"CAMP_NOT_SPAWNABLE\")\n\telse\n\t\tif #index.boundariesByRegion[normalizedRegion] == 0 then\n\t\t\ttable.insert(reasons, \"MISSING_REGION_BOUNDARY\")\n\t\tend\n\t\tlocal usable = false\n\t\tfor _, area in index.areasByRegion[normalizedRegion] do\n\t\t\tif area.Enabled and area.UsableProbeCount > 0 then\n\t\t\t\tusable = true\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif not usable then\n\t\t\ttable.insert(reasons, \"MISSING_SPAWN_AREA\")\n\t\tend\n\tend\n\tif\n\t\tdefinition\n\t\tand region\n\t\tand not RegionSpawnCatalog.IsSpeciesAllowedInRegion(definition.id, region.id)\n\tthen\n\t\tif definition.regionAssignmentStatus == \"Approved\" then\n\t\t\ttable.insert(reasons, \"SPECIES_NOT_ALLOWED_IN_REGION\")\n\t\tend\n\tend\n\tif definition then\n\t\tif getModel(index, definition) == nil then\n\t\t\ttable.insert(reasons, \"MODEL_MISSING\")\n\t\tend\n\t\tif not behaviourReady(index, definition) then\n\t\t\ttable.insert(reasons, \"BEHAVIOUR_NOT_READY\")\n\t\tend\n\t\tif definition.launchStatus ~= \"Live\" then\n\t\t\ttable.insert(activationReasons, \"CONTENT_TEASED\")\n\t\tend\n\t\tif definition.spawnEnabled ~= true then\n\t\t\ttable.insert(activationReasons, \"SPAWN_DISABLED\")\n\t\tend\n\tend\n\tlocal ready = #reasons == 0\n\tif not ready then\n\t\ttable.insert(activationReasons, \"NOT_TECHNICALLY_READY\")\n\tend\n\treturn table.freeze({\n\t\tready = ready,\n\t\tactivated = ready and #activationReasons == 0,\n\t\treasons = table.freeze(reasons),\n\t\tactivationReasons = table.freeze(activationReasons),\n\t})\nend\n\nlocal function validateGround(\n\tindex: Index,\n\tcandidate: Vector3,\n\tarea: SpawnArea,\n\tdefinition: any\n): (boolean, Vector3?, string?)\n\tif type(index.context.ValidateGround) == \"function\" then\n\t\treturn index.context.ValidateGround(candidate, area, definition)\n\tend\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = if area.IsFloorSurface then {} else { area.Part }\n\tparams.RespectCanCollide = true\n\tparams.IgnoreWater = false\n\tlocal result = Workspace:Raycast(candidate + Vector3.yAxis * 4, -Vector3.yAxis * 8, params)\n\tif\n\t\tresult == nil\n\t\tor result.Material == Enum.Material.Water\n\t\tor result.Normal.Y < BrainrotTerritory.MinWalkableNormalY\n\tthen\n\t\treturn false, nil, \"NO_VALID_GROUND\"\n\tend\n\tif math.abs(result.Position.Y - candidate.Y) > 2 then\n\t\treturn false, nil, \"NO_VALID_GROUND\"\n\tend\n\treturn true, result.Position, nil\nend\n\nlocal function isProtected(\n\tindex: Index,\n\tframe: CFrame,\n\tsize: Vector3,\n\tignoredRegionId: string?\n): (boolean, string?, string?)\n\tif ignoredRegionId ~= Regions.CampId then\n\t\tfor _, boundary in index.boundariesByRegion[Regions.CampId] or {} do\n\t\t\tif boxesOverlapByCorners(frame, size, boundary) then\n\t\t\t\treturn true, \"PROTECTED_AREA_OVERLAP\", string.sub(boundary:GetFullName(), 1, 512)\n\t\t\tend\n\t\tend\n\tend\n\tif type(index.context.IsProtected) == \"function\" then\n\t\tlocal protected, reason = index.context.IsProtected(frame, size)\n\t\treturn protected, reason, nil\n\tend\n\tif #index.protectedInstances == 0 then\n\t\treturn false, nil, nil\n\tend\n\tlocal protectedInstances = index.protectedInstances\n\tif ignoredRegionId == Regions.CampId then\n\t\tlocal campBoundaries = {}\n\t\tfor _, boundary in index.boundariesByRegion[Regions.CampId] or {} do\n\t\t\tcampBoundaries[boundary] = true\n\t\tend\n\t\tprotectedInstances = {}\n\t\tfor _, instance in index.protectedInstances do\n\t\t\tif not campBoundaries[instance] then\n\t\t\t\ttable.insert(protectedInstances, instance)\n\t\t\tend\n\t\tend\n\t\tif #protectedInstances == 0 then\n\t\t\treturn false, nil, nil\n\t\tend\n\tend\n\tlocal params = OverlapParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = protectedInstances\n\tparams.RespectCanCollide = false\n\tparams.MaxParts = 1\n\tlocal hit = Workspace:GetPartBoundsInBox(frame, size, params)[1]\n\treturn hit ~= nil,\n\t\t\"PROTECTED_AREA_OVERLAP\",\n\t\tif hit then string.sub(hit:GetFullName(), 1, 512) else nil\nend\n\nfunction RegionSpawnCatalog.IsProtectedSpace(\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown\n): (boolean, string?)\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn true, \"INVALID_ENVELOPE\"\n\tend\n\tlocal protected, reason = isProtected(current(), envelopeFrame, envelopeSize)\n\treturn protected, reason\nend\n\n-- The one-time Camp-return lifecycle has already admitted a real world member\n-- inside the protected hub. Ignore only the Camp floor while it exits; bases,\n-- service stalls, and cart-spawn protection remain authoritative.\nfunction RegionSpawnCatalog.IsProtectedForCampReturn(\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown\n): (boolean, string?, string?)\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn true, \"INVALID_ENVELOPE\", nil\n\tend\n\treturn isProtected(current(), envelopeFrame, envelopeSize, Regions.CampId)\nend\n\nfunction RegionSpawnCatalog.IsInsideHuntingSpace(\n\tregionId: unknown,\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown,\n\tboundaryPadding: number?\n): (boolean, string?)\n\tlocal index = current()\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif\n\t\tregion == nil\n\t\tor normalizedRegion == Regions.CampId\n\t\tor region.kind ~= \"Hunting\"\n\t\tor region.enabled ~= true\n\t\tor region.naturalSpawnAllowed ~= true\n\tthen\n\t\treturn false, \"REGION_NOT_SPAWNABLE\"\n\tend\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn false, \"INVALID_ENVELOPE\"\n\tend\n\tlocal padding = boundaryPadding\n\tif type(padding) ~= \"number\" or padding ~= padding or padding < 0 or padding == math.huge then\n\t\tpadding = BrainrotTerritory.BoundaryPaddingStuds\n\tend\n\tlocal inside = false\n\tfor _, boundary in index.boundariesByRegion[normalizedRegion] do\n\t\tif boxFitsPart(envelopeFrame, envelopeSize, boundary, padding) then\n\t\t\tinside = true\n\t\t\tbreak\n\t\tend\n\tend\n\tif not inside then\n\t\treturn false, \"OUTSIDE_REGION\"\n\tend\n\tlocal protected, reason = isProtected(index, envelopeFrame, envelopeSize)\n\tif protected then\n\t\treturn false, reason or \"PROTECTED_AREA_OVERLAP\"\n\tend\n\treturn true, nil\nend\n\n-- Boundary-only query used by the one-time Camp-return lifecycle. Unlike the\n-- natural-placement query it permits the protected Camp hub and does not imply\n-- spawn eligibility.\nfunction RegionSpawnCatalog.IsInsideRegionSpace(\n\tregionId: unknown,\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown,\n\tboundaryPadding: number?\n): (boolean, string?)\n\tlocal index = current()\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif region == nil or region.enabled ~= true then\n\t\treturn false, \"UNKNOWN_REGION\"\n\tend\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn false, \"INVALID_ENVELOPE\"\n\tend\n\tlocal padding = boundaryPadding\n\tif type(padding) ~= \"number\" or padding ~= padding or padding < 0 or padding == math.huge then\n\t\tpadding = BrainrotTerritory.BoundaryPaddingStuds\n\tend\n\tfor _, boundary in index.boundariesByRegion[normalizedRegion] do\n\t\tif boxFitsPart(envelopeFrame, envelopeSize, boundary, padding) then\n\t\t\treturn true, nil\n\t\tend\n\tend\n\treturn false, \"OUTSIDE_REGION\"\nend\n\nlocal function validateClearance(\n\tindex: Index,\n\tframe: CFrame,\n\tsize: Vector3,\n\tarea: SpawnArea,\n\tdefinition: any\n): (boolean, string?)\n\tif type(index.context.ValidateClearance) == \"function\" then\n\t\treturn index.context.ValidateClearance(frame, size, area, definition)\n\tend\n\tlocal params = OverlapParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = { area.Part }\n\tparams.RespectCanCollide = true\n\tparams.MaxParts = 1\n\tlocal padded = size + Vector3.new(0.2, 0, 0.2)\n\treturn #Workspace:GetPartBoundsInBox(frame, padded, params) == 0, \"INSUFFICIENT_CLEARANCE\"\nend\n\nfunction RegionSpawnCatalog.ValidatePlacement(\n\tspeciesId: unknown,\n\tregionId: unknown,\n\tareaId: unknown,\n\tcandidatePosition: unknown\n): any\n\tlocal index = current()\n\tlocal reasons: { string } = {}\n\tif not index.mapArtFootprintsValid then\n\t\ttable.insert(reasons, \"INVALID_MAP_ART_FOOTPRINTS\")\n\tend\n\tlocal normalizedSpecies = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal definition = if normalizedSpecies then index.speciesById[normalizedSpecies] else nil\n\tlocal area = if type(areaId) == \"string\" then index.areasById[areaId] else nil\n\tif definition == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_SPECIES\")\n\tend\n\tif normalizedRegion == nil or index.regionsById[normalizedRegion] == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_REGION\")\n\telseif normalizedRegion == Regions.CampId then\n\t\ttable.insert(reasons, \"CAMP_NOT_SPAWNABLE\")\n\tend\n\tif area == nil then\n\t\ttable.insert(reasons, \"MISSING_SPAWN_AREA\")\n\telseif area.RegionId ~= normalizedRegion then\n\t\ttable.insert(reasons, \"SPAWN_AREA_REGION_MISMATCH\")\n\telseif not area.Enabled then\n\t\ttable.insert(reasons, \"SPAWN_AREA_DISABLED\")\n\tend\n\tif not finiteVector3(candidatePosition) then\n\t\ttable.insert(reasons, \"INVALID_CANDIDATE_POSITION\")\n\tend\n\tif\n\t\tdefinition\n\t\tand normalizedRegion\n\t\tand not RegionSpawnCatalog.IsSpeciesAllowedInRegion(definition.id, normalizedRegion)\n\tthen\n\t\ttable.insert(\n\t\t\treasons,\n\t\t\tif definition.regionAssignmentStatus == \"Pending\"\n\t\t\t\tthen \"REGION_ASSIGNMENT_PENDING\"\n\t\t\t\telseif\n\t\t\t\t\tdefinition.regionAssignmentStatus == \"Conflict\"\n\t\t\t\tthen \"REGION_ASSIGNMENT_CONFLICT\"\n\t\t\t\telse \"SPECIES_NOT_ALLOWED_IN_REGION\"\n\t\t)\n\tend\n\tif #reasons > 0 then\n\t\treturn table.freeze({ valid = false, reasons = table.freeze(reasons) })\n\tend\n\n\tlocal localEnvelopeFrame, envelopeSize, envelopeReason = getEnvelope(index, definition)\n\tif localEnvelopeFrame == nil or envelopeSize == nil then\n\t\ttable.insert(reasons, envelopeReason or \"MODEL_MISSING\")\n\t\treturn table.freeze({ valid = false, reasons = table.freeze(reasons) })\n\tend\n\tlocal candidate = candidatePosition :: Vector3\n\tlocal groundValid, groundPosition, groundReason =\n\t\tvalidateGround(index, candidate, area, definition)\n\tif not groundValid or groundPosition == nil then\n\t\ttable.insert(reasons, groundReason or \"NO_VALID_GROUND\")\n\t\treturn table.freeze({ valid = false, reasons = table.freeze(reasons) })\n\tend\n\n\tlocal basePivot = CFrame.new(groundPosition.X, groundPosition.Y, groundPosition.Z)\n\t\t* area.Part.CFrame.Rotation\n\tlocal initialEnvelopeFrame = basePivot * localEnvelopeFrame\n\tlocal half = envelopeSize * 0.5\n\tlocal verticalHalf = math.abs(initialEnvelopeFrame.RightVector.Y) * half.X\n\t\t+ math.abs(initialEnvelopeFrame.UpVector.Y) * half.Y\n\t\t+ math.abs(initialEnvelopeFrame.LookVector.Y) * half.Z\n\tlocal lift = groundPosition.Y - (initialEnvelopeFrame.Position.Y - verticalHalf) + 0.1\n\tlocal placementPivot = basePivot + Vector3.yAxis * lift\n\tlocal envelopeFrame = placementPivot * localEnvelopeFrame\n\tif area.Kind == \"Point\" then\n\t\tlocal horizontal =\n\t\t\tVector2.new(candidate.X - area.Part.Position.X, candidate.Z - area.Part.Position.Z)\n\t\tif horizontal.Magnitude > 0.75 or math.abs(candidate.Y - area.Part.Position.Y) > 2 then\n\t\t\ttable.insert(reasons, \"CANDIDATE_OUTSIDE_SPAWN_AREA\")\n\t\tend\n\telseif not boxFitsPart(envelopeFrame, envelopeSize, area.Part) then\n\t\ttable.insert(reasons, \"CANDIDATE_OUTSIDE_SPAWN_AREA\")\n\tend\n\n\tlocal boundaries = index.boundariesByRegion[normalizedRegion]\n\tlocal insideBoundary = false\n\tfor _, boundary in boundaries do\n\t\tif\n\t\t\tboxFitsPart(\n\t\t\t\tenvelopeFrame,\n\t\t\t\tenvelopeSize,\n\t\t\t\tboundary,\n\t\t\t\tBrainrotTerritory.BoundaryPaddingStuds\n\t\t\t)\n\t\tthen\n\t\t\tinsideBoundary = true\n\t\t\tbreak\n\t\tend\n\tend\n\tif not insideBoundary then\n\t\ttable.insert(reasons, \"OUTSIDE_REGION_BOUNDARY\")\n\tend\n\tlocal protected, protectedReason = isProtected(index, envelopeFrame, envelopeSize)\n\tif protected then\n\t\ttable.insert(reasons, protectedReason or \"PROTECTED_AREA_OVERLAP\")\n\tend\n\tif #index.mapArtFootprints > 0 then\n\t\tlocal artLocalFrame, artSize, artReason = getMapArtEnvelope(index, definition)\n\t\tif artLocalFrame == nil or artSize == nil then\n\t\t\ttable.insert(reasons, artReason or \"INVALID_MAP_ART_ENVELOPE\")\n\t\telseif\n\t\t\toverlapsMapArtFootprint(\n\t\t\t\tindex.mapArtFootprints,\n\t\t\t\tnormalizedRegion,\n\t\t\t\tplacementPivot * artLocalFrame,\n\t\t\t\tartSize\n\t\t\t)\n\t\tthen\n\t\t\ttable.insert(reasons, \"MAP_ART_FOOTPRINT_OVERLAP\")\n\t\tend\n\tend\n\tlocal clear, clearanceReason =\n\t\tvalidateClearance(index, envelopeFrame, envelopeSize, area, definition)\n\tif not clear then\n\t\ttable.insert(reasons, clearanceReason or \"INSUFFICIENT_CLEARANCE\")\n\tend\n\treturn table.freeze({\n\t\tvalid = #reasons == 0,\n\t\treasons = table.freeze(reasons),\n\t\tgroundPosition = groundPosition,\n\t\tplacementPivot = placementPivot,\n\t\tplacementEnvelope = envelopeFrame,\n\t})\nend\n\nfunction RegionSpawnCatalog.ValidateConfiguration(): ValidationReport\n\treturn cloneReport(current().report)\nend\n\nfunction RegionSpawnCatalog.GetRegionSummary(): { any }\n\tlocal index = current()\n\tlocal summary = {}\n\tfor _, regionId in index.regionOrder do\n\t\tlocal readyCount = 0\n\t\tfor _, speciesId in index.approvedSpeciesByRegion[regionId] do\n\t\t\tif RegionSpawnCatalog.EvaluateNaturalSpawnReadiness(speciesId, regionId).ready then\n\t\t\t\treadyCount += 1\n\t\t\tend\n\t\tend\n\t\tlocal usableAreas = 0\n\t\tfor _, area in index.areasByRegion[regionId] do\n\t\t\tif area.Enabled and area.UsableProbeCount > 0 then\n\t\t\t\tusableAreas += 1\n\t\t\tend\n\t\tend\n\t\ttable.insert(\n\t\t\tsummary,\n\t\t\ttable.freeze({\n\t\t\t\tregionId = regionId,\n\t\t\t\tboundaryCount = #index.boundariesByRegion[regionId],\n\t\t\t\tapprovedSpeciesCount = #index.approvedSpeciesByRegion[regionId],\n\t\t\t\ttechnicallyReadySpeciesCount = readyCount,\n\t\t\t\tspawnAreaCount = #index.areasByRegion[regionId],\n\t\t\t\tusableSpawnAreaCount = usableAreas,\n\t\t\t})\n\t\t)\n\tend\n\treturn summary\nend\n\nfunction RegionSpawnCatalog.Start(): ValidationReport\n\tif started then\n\t\treturn RegionSpawnCatalog.ValidateConfiguration()\n\tend\n\tlocal report = RegionSpawnCatalog.BuildIndex(Regions.GetAll(), BrainrotCatalog.GetAll(), nil)\n\tstarted = true\n\tlocal counts: { [string]: number } = {}\n\tfor _, item in report.errors do\n\t\tcounts[item.code] = (counts[item.code] or 0) + 1\n\tend\n\tfor _, item in report.warnings do\n\t\tcounts[item.code] = (counts[item.code] or 0) + 1\n\tend\n\tlocal summary = {}\n\tfor code, count in counts do\n\t\ttable.insert(summary, string.format(\"%s=%d\", code, count))\n\tend\n\ttable.sort(summary)\n\tlog:Info(\n\t\t\"Regional configuration: %d error(s), %d warning(s), natural spawning unchanged\",\n\t\t#report.errors,\n\t\t#report.warnings\n\t)\n\tif #summary > 0 then\n\t\tlog:Warn(\"Regional readiness issues: %s\", table.concat(summary, \", \"))\n\tend\n\treturn report\nend\n\nreturn RegionSpawnCatalog\n","afterSource":"--!strict\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal BrainrotCatalog = require(ReplicatedStorage.Shared.Config.BrainrotCatalog)\nlocal BrainrotTerritory = require(ReplicatedStorage.Shared.Config.BrainrotTerritory)\nlocal Regions = require(ReplicatedStorage.Shared.Config.Regions)\nlocal BrainrotVisualScale = require(ReplicatedStorage.Shared.Utility.BrainrotVisualScale)\nlocal CompactMapGeometry = require(ReplicatedStorage.Shared.Utility.CompactMapGeometry)\nlocal Logger = require(ReplicatedStorage.Shared.Utility.Logger)\n\nexport type ValidationIssue = {\n\tseverity: \"Error\" | \"Warning\",\n\tcode: string,\n\tmessage: string,\n\tspeciesId: string?,\n\tregionId: string?,\n\tareaId: string?,\n}\n\nexport type ValidationReport = {\n\terrors: { ValidationIssue },\n\twarnings: { ValidationIssue },\n}\n\nexport type SpawnArea = {\n\tId: string,\n\tRegionId: string,\n\tKind: \"Point\" | \"Volume\",\n\tReference: string,\n\tPart: BasePart,\n\tEnabled: boolean,\n\tProbeCount: number,\n\tUsableProbeCount: number,\n\tIsFloorSurface: boolean,\n}\n\nexport type SelectionCandidate = {\n\tid: string,\n\ttier: string,\n\tassignmentStatus: string,\n\thomeRegionId: string?,\n\tallowedRegionIds: { string },\n\tspawnEnabled: boolean,\n\tlaunchStatus: string,\n\tnaturalSpawnEligible: boolean,\n\tmodelReady: boolean,\n\tbehaviourReady: boolean,\n\tlocationReady: boolean,\n\tglobalWithinTierWeight: number?,\n\treadinessReasons: { string },\n}\n\ntype MapArtFootprint = {\n\tid: string,\n\tregionId: string,\n\tminX: number,\n\tmaxX: number,\n\tminZ: number,\n\tmaxZ: number,\n}\n\ntype Index = {\n\tregionsById: { [string]: any },\n\tregionOrder: { string },\n\tspeciesById: { [string]: any },\n\tapprovedSpeciesByRegion: { [string]: { string } },\n\tareasByRegion: { [string]: { SpawnArea } },\n\tareasById: { [string]: SpawnArea },\n\tboundariesByRegion: { [string]: { BasePart } },\n\tprotectedInstances: { Instance },\n\tmapArtFootprints: { MapArtFootprint },\n\tmapArtFootprintsValid: boolean,\n\tstaticWallIndex: any,\n\tstaticWallObstaclesValid: boolean,\n\tmapArtEnvelopesByModelRef: { [string]: { LocalFrame: CFrame, Size: Vector3 } },\n\tenvelopesByModelRef: { [string]: { LocalFrame: CFrame, Size: Vector3 } },\n\tcontext: any,\n\treport: ValidationReport,\n}\n\nlocal RegionSpawnCatalog = {}\nlocal log = Logger.new(\"RegionSpawnCatalog\")\nlocal currentIndex: Index? = nil\nlocal started = false\n\nlocal READY_BEHAVIOURS = table.freeze({\n\tWanderer = true,\n\tReactiveRunner = true,\n\tSprinter = true,\n\tZigzag = true,\n\tCamouflage = true,\n\tDecoySplit = true,\n\tLegendaryPursuit = true,\n})\nlocal FLOOR_VERTICAL_TOLERANCE_STUDS = 8\n-- The fixed art schedule is at most 321 scenery + 18 Camp + 6 backdrop rows.\nlocal MAX_MAP_ART_FOOTPRINTS = 345\nlocal MAX_MAP_ART_MANIFEST_BYTES = 262144\n\nlocal function nonEmpty(value: any): boolean\n\treturn type(value) == \"string\" and string.match(value, \"%S\") ~= nil\nend\n\nlocal function finiteVector3(value: any): boolean\n\treturn typeof(value) == \"Vector3\"\n\t\tand value.X == value.X\n\t\tand math.abs(value.X) < math.huge\n\t\tand value.Y == value.Y\n\t\tand math.abs(value.Y) < math.huge\n\t\tand value.Z == value.Z\n\t\tand math.abs(value.Z) < math.huge\nend\n\nlocal function addIssue(\n\treport: ValidationReport,\n\tseverity: \"Error\" | \"Warning\",\n\tcode: string,\n\tmessage: string,\n\tspeciesId: string?,\n\tregionId: string?,\n\tareaId: string?\n)\n\tlocal item: ValidationIssue = {\n\t\tseverity = severity,\n\t\tcode = code,\n\t\tmessage = message,\n\t\tspeciesId = speciesId,\n\t\tregionId = regionId,\n\t\tareaId = areaId,\n\t}\n\ttable.insert(if severity == \"Error\" then report.errors else report.warnings, item)\nend\n\nlocal function cloneReport(report: ValidationReport): ValidationReport\n\treturn {\n\t\terrors = table.clone(report.errors),\n\t\twarnings = table.clone(report.warnings),\n\t}\nend\n\nlocal function resolvePath(root: Instance, reference: string): Instance?\n\tlocal current: Instance? = root\n\tlocal first = true\n\tfor segment in string.gmatch(reference, \"[^%./]+\") do\n\t\tif first and segment == root.Name then\n\t\t\tfirst = false\n\t\t\tcontinue\n\t\tend\n\t\tfirst = false\n\t\tcurrent = if current then current:FindFirstChild(segment) else nil\n\t\tif current == nil then\n\t\t\treturn nil\n\t\tend\n\tend\n\treturn current\nend\n\n-- Read a saved descriptor once while building the index. Never scan placed art\n-- or read the StringValue again on individual placement/roaming attempts.\nlocal function readInstalledMapArtFootprints(map: Instance?): (any, string?)\n\tlocal art = if map then map:FindFirstChild(\"MapArt\") else nil\n\tlocal manifest = if art then art:FindFirstChild(\"InstalledFootprints\") else nil\n\tif manifest == nil then\n\t\treturn {}, nil\n\tend\n\tif not manifest:IsA(\"StringValue\") or #manifest.Value > MAX_MAP_ART_MANIFEST_BYTES then\n\t\treturn nil, \"installed art manifest must be a bounded StringValue\"\n\tend\n\tlocal ok, decoded = pcall(function()\n\t\treturn HttpService:JSONDecode(manifest.Value)\n\tend)\n\tif not ok or decoded == nil then\n\t\treturn nil, \"installed art manifest is not valid JSON\"\n\tend\n\treturn decoded, nil\nend\n\nlocal function copyMapArtFootprints(raw: any): ({ MapArtFootprint }, string?)\n\tif type(raw) ~= \"table\" then\n\t\treturn {}, \"installed art footprints must be an array\"\n\tend\n\tlocal count = 0\n\tfor key in raw do\n\t\tif type(key) ~= \"number\" or key % 1 ~= 0 or key < 1 or key > MAX_MAP_ART_FOOTPRINTS then\n\t\t\treturn {}, \"installed art footprint array exceeds its bounded dense schema\"\n\t\tend\n\t\tcount += 1\n\tend\n\tif count ~= #raw then\n\t\treturn {}, \"installed art footprint array must be dense\"\n\tend\n\tfor key = 1, count do\n\t\tif raw[key] == nil then\n\t\t\treturn {}, \"installed art footprint array must be dense\"\n\t\tend\n\tend\n\tlocal copied: { MapArtFootprint } = {}\n\tlocal ids: { [string]: boolean } = {}\n\tfor _, row in raw do\n\t\tif type(row) ~= \"table\" or not nonEmpty(row.id) or #row.id > 128 or ids[row.id] then\n\t\t\treturn {}, \"installed art footprint IDs must be bounded and unique\"\n\t\tend\n\t\tlocal regionId = Regions.NormalizeId(row.regionId)\n\t\tif regionId == nil or regionId ~= row.regionId then\n\t\t\treturn {}, \"installed art footprint region must be canonical\"\n\t\tend\n\t\tfor _, key in { \"minX\", \"maxX\", \"minZ\", \"maxZ\" } do\n\t\t\tlocal value = row[key]\n\t\t\tif type(value) ~= \"number\" or value ~= value or math.abs(value) == math.huge then\n\t\t\t\treturn {}, \"installed art footprint bounds must be finite numbers\"\n\t\t\tend\n\t\tend\n\t\tif row.minX >= row.maxX or row.minZ >= row.maxZ then\n\t\t\treturn {}, \"installed art footprint bounds must have positive area\"\n\t\tend\n\t\tids[row.id] = true\n\t\ttable.insert(\n\t\t\tcopied,\n\t\t\ttable.freeze({\n\t\t\t\tid = row.id,\n\t\t\t\tregionId = regionId,\n\t\t\t\tminX = row.minX,\n\t\t\t\tmaxX = row.maxX,\n\t\t\t\tminZ = row.minZ,\n\t\t\t\tmaxZ = row.maxZ,\n\t\t\t})\n\t\t)\n\tend\n\treturn table.freeze(copied), nil\nend\n\n-- Pure bounded XZ test of the dedicated native art-clearance envelope. Include\n-- all three rotated half-axis projections so an outside centre or a rotated\n-- long model cannot hide an overlap. Edge-only contact has no positive area.\nlocal function overlapsMapArtFootprint(\n\tfootprints: { MapArtFootprint },\n\tregionId: string,\n\tframe: CFrame,\n\tsize: Vector3\n): boolean\n\tlocal half = size * 0.5\n\tlocal extentX = math.abs(frame.RightVector.X) * half.X\n\t\t+ math.abs(frame.UpVector.X) * half.Y\n\t\t+ math.abs(frame.LookVector.X) * half.Z\n\tlocal extentZ = math.abs(frame.RightVector.Z) * half.X\n\t\t+ math.abs(frame.UpVector.Z) * half.Y\n\t\t+ math.abs(frame.LookVector.Z) * half.Z\n\tlocal minX, maxX = frame.Position.X - extentX, frame.Position.X + extentX\n\tlocal minZ, maxZ = frame.Position.Z - extentZ, frame.Position.Z + extentZ\n\tfor _, row in footprints do\n\t\tif\n\t\t\trow.regionId == regionId\n\t\t\tand minX < row.maxX\n\t\t\tand maxX > row.minX\n\t\t\tand minZ < row.maxZ\n\t\t\tand maxZ > row.minZ\n\t\tthen\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function defaultContext(): any\n\tlocal studioAssets = ReplicatedStorage:FindFirstChild(\"StudioAssets\")\n\tlocal map = Workspace:FindFirstChild(\"MapBlockout\")\n\tlocal mapArtFootprints, mapArtFootprintsError = readInstalledMapArtFootprints(map)\n\tlocal compact = CompactMapGeometry.Read(map)\n\tlocal protectedInstances: { Instance } = {}\n\tfor _, instance in\n\t\t{\n\t\t\tif map then map:FindFirstChild(\"PlayerBasePatches\") else nil,\n\t\t\tif map then map:FindFirstChild(\"ServiceStallPatches\") else nil,\n\t\t\tWorkspace:FindFirstChild(\"CartSpawns\"),\n\t\t}\n\tdo\n\t\tif instance then\n\t\t\ttable.insert(protectedInstances, instance)\n\t\tend\n\tend\n\treturn {\n\t\tRoot = Workspace,\n\t\tAssetFolder = if studioAssets then studioAssets:FindFirstChild(\"Brainrots\") else nil,\n\t\tProtectedInstances = protectedInstances,\n\t\tMapArtFootprints = mapArtFootprints,\n\t\tMapArtFootprintsError = mapArtFootprintsError,\n\t\tStaticWallObstacles = if compact then compact.staticWallObstacles else {},\n\t}\nend\n\nlocal function resolveReference(context: any, reference: string): Instance?\n\tif type(context.ResolveReference) == \"function\" then\n\t\treturn context.ResolveReference(reference)\n\tend\n\treturn resolvePath(context.Root or Workspace, reference)\nend\n\nlocal function isAuthoredFloor(part: BasePart): boolean\n\treturn part:GetAttribute(\"LayoutRole\") == \"Floor\"\n\t\tand nonEmpty(part:GetAttribute(\"CellId\"))\n\t\tand part:GetAttribute(\"GeneratedBy\") == \"CreateBasicMap_v1\"\nend\n\nlocal function collectBoundaryParts(instance: Instance): { BasePart }\n\tlocal parts: { BasePart } = {}\n\tif instance:IsA(\"BasePart\") then\n\t\ttable.insert(parts, instance)\n\tend\n\tfor _, descendant in instance:GetDescendants() do\n\t\tif\n\t\t\tdescendant:IsA(\"BasePart\")\n\t\t\tand (descendant:GetAttribute(\"RegionBoundary\") == true or isAuthoredFloor(descendant))\n\t\tthen\n\t\t\ttable.insert(parts, descendant)\n\t\tend\n\tend\n\treturn parts\nend\n\nlocal function collectAreaParts(instance: Instance): { BasePart }\n\tlocal parts: { BasePart } = {}\n\tif instance:IsA(\"BasePart\") then\n\t\ttable.insert(parts, instance)\n\tend\n\tfor _, descendant in instance:GetDescendants() do\n\t\tif\n\t\t\tdescendant:IsA(\"BasePart\")\n\t\t\tand (descendant:GetAttribute(\"SpawnAreaId\") ~= nil or isAuthoredFloor(descendant))\n\t\tthen\n\t\t\ttable.insert(parts, descendant)\n\t\tend\n\tend\n\treturn parts\nend\n\nlocal function probePositions(part: BasePart, kind: \"Point\" | \"Volume\"): { Vector3 }\n\tif kind == \"Point\" then\n\t\treturn { part.Position }\n\tend\n\tlocal points = {}\n\tfor _, x in { -0.35, 0, 0.35 } do\n\t\tfor _, z in { -0.35, 0, 0.35 } do\n\t\t\ttable.insert(\n\t\t\t\tpoints,\n\t\t\t\tpart.CFrame:PointToWorldSpace(\n\t\t\t\t\tVector3.new(\n\t\t\t\t\t\tpart.Size.X * x,\n\t\t\t\t\t\tif isAuthoredFloor(part) then part.Size.Y * 0.5 else -part.Size.Y * 0.5,\n\t\t\t\t\t\tpart.Size.Z * z\n\t\t\t\t\t)\n\t\t\t\t)\n\t\t\t)\n\t\tend\n\tend\n\treturn points\nend\n\nlocal function defaultProbeGround(point: Vector3, area: SpawnArea): boolean\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = if area.IsFloorSurface then {} else { area.Part }\n\tparams.RespectCanCollide = true\n\tparams.IgnoreWater = false\n\tlocal result = Workspace:Raycast(point + Vector3.yAxis * 4, -Vector3.yAxis * 8, params)\n\treturn result ~= nil\n\t\tand result.Material ~= Enum.Material.Water\n\t\tand result.Normal.Y >= BrainrotTerritory.MinWalkableNormalY\n\t\tand math.abs(result.Position.Y - point.Y) <= 2\nend\n\nlocal function countUsableProbes(area: SpawnArea, context: any): (number, number)\n\tlocal positions = probePositions(area.Part, area.Kind)\n\tlocal usable = 0\n\tfor _, point in positions do\n\t\tlocal accepted = if type(context.ProbeGround) == \"function\"\n\t\t\tthen context.ProbeGround(point, area)\n\t\t\telse defaultProbeGround(point, area)\n\t\tif accepted then\n\t\t\tusable += 1\n\t\tend\n\tend\n\treturn #positions, usable\nend\n\nlocal function containsPoint(part: BasePart, point: Vector3, margin: Vector3?): boolean\n\tlocal localPoint = part.CFrame:PointToObjectSpace(point)\n\tlocal half = part.Size * 0.5\n\tlocal inset = margin or Vector3.zero\n\treturn math.abs(localPoint.X) <= math.max(0, half.X - inset.X)\n\t\tand math.abs(localPoint.Y) <= math.max(0, half.Y - inset.Y)\n\t\tand math.abs(localPoint.Z) <= math.max(0, half.Z - inset.Z)\nend\n\nlocal function containsSurfacePoint(part: BasePart, point: Vector3, margin: Vector3?): boolean\n\tlocal localPoint = part.CFrame:PointToObjectSpace(point)\n\tlocal half = part.Size * 0.5\n\tlocal inset = margin or Vector3.zero\n\treturn math.abs(localPoint.X) <= math.max(0, half.X - inset.X)\n\t\tand math.abs(localPoint.Z) <= math.max(0, half.Z - inset.Z)\nend\n\nlocal function boxCorners(frame: CFrame, size: Vector3): { Vector3 }\n\tlocal corners = {}\n\tlocal half = size * 0.5\n\tfor _, x in { -1, 1 } do\n\t\tfor _, y in { -1, 1 } do\n\t\t\tfor _, z in { -1, 1 } do\n\t\t\t\ttable.insert(corners, frame:PointToWorldSpace(half * Vector3.new(x, y, z)))\n\t\t\tend\n\t\tend\n\tend\n\treturn corners\nend\n\nlocal function boxFitsPart(\n\tframe: CFrame,\n\tsize: Vector3,\n\tcontainer: BasePart,\n\tboundaryPadding: number?\n): boolean\n\tlocal padding = math.max(0, boundaryPadding or 0)\n\tlocal inset = Vector3.new(padding, 0, padding)\n\tlocal minimumSurfaceY = math.huge\n\tfor _, corner in boxCorners(frame, size) do\n\t\tlocal contains = if isAuthoredFloor(container)\n\t\t\tthen containsSurfacePoint(container, corner, inset)\n\t\t\telse containsPoint(container, corner, inset)\n\t\tif not contains then\n\t\t\treturn false\n\t\tend\n\t\tif isAuthoredFloor(container) then\n\t\t\tminimumSurfaceY =\n\t\t\t\tmath.min(minimumSurfaceY, container.CFrame:PointToObjectSpace(corner).Y)\n\t\tend\n\tend\n\tif isAuthoredFloor(container) then\n\t\tlocal surfaceY = container.Size.Y * 0.5\n\t\treturn minimumSurfaceY >= surfaceY - 2\n\t\t\tand minimumSurfaceY <= surfaceY + FLOOR_VERTICAL_TOLERANCE_STUDS\n\tend\n\treturn true\nend\n\nlocal function boxesOverlapByCorners(leftFrame: CFrame, leftSize: Vector3, right: BasePart): boolean\n\tif isAuthoredFloor(right) then\n\t\tlocal minimumY, maximumY = math.huge, -math.huge\n\t\tfor _, corner in boxCorners(leftFrame, leftSize) do\n\t\t\tlocal localPoint = right.CFrame:PointToObjectSpace(corner)\n\t\t\tminimumY, maximumY = math.min(minimumY, localPoint.Y), math.max(maximumY, localPoint.Y)\n\t\tend\n\t\tlocal surfaceY = right.Size.Y * 0.5\n\t\tif maximumY < surfaceY - 2 or minimumY > surfaceY + FLOOR_VERTICAL_TOLERANCE_STUDS then\n\t\t\treturn false\n\t\tend\n\tend\n\tlocal rightContains = if isAuthoredFloor(right) then containsSurfacePoint else containsPoint\n\tif rightContains(right, leftFrame.Position) then\n\t\treturn true\n\tend\n\tfor _, corner in boxCorners(leftFrame, leftSize) do\n\t\tif rightContains(right, corner) then\n\t\t\treturn true\n\t\tend\n\tend\n\tfor _, corner in boxCorners(right.CFrame, right.Size) do\n\t\tlocal localPoint = leftFrame:PointToObjectSpace(corner)\n\t\tlocal half = leftSize * 0.5\n\t\tif\n\t\t\tmath.abs(localPoint.X) <= half.X\n\t\t\tand (isAuthoredFloor(right) or math.abs(localPoint.Y) <= half.Y)\n\t\t\tand math.abs(localPoint.Z) <= half.Z\n\t\tthen\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function getModel(index: Index, definition: any): Model?\n\tif type(index.context.ResolveModel) == \"function\" then\n\t\tlocal model = index.context.ResolveModel(definition)\n\t\treturn if model and model:IsA(\"Model\") then model else nil\n\tend\n\tlocal folder = index.context.AssetFolder\n\tlocal model = if folder and folder:IsA(\"Instance\")\n\t\tthen folder:FindFirstChild(definition.modelRef)\n\t\telse nil\n\treturn if model and model:IsA(\"Model\") then model else nil\nend\n\nlocal function getEnvelope(index: Index, definition: any): (CFrame?, Vector3?, string?)\n\tlocal cached = index.envelopesByModelRef[definition.modelRef]\n\tif cached then\n\t\treturn cached.LocalFrame, cached.Size, nil\n\tend\n\tlocal model = getModel(index, definition)\n\tif model == nil then\n\t\treturn nil, nil, \"MODEL_MISSING\"\n\tend\n\tlocal body = model:FindFirstChild(\"Body\", true)\n\tif body == nil or not body:IsA(\"BasePart\") or not body.CanQuery then\n\t\treturn nil, nil, \"MODEL_MISSING\"\n\tend\n\t-- Use the same effect-free visible bounds that the existing world factory uses\n\t-- to ground a model. Body remains the required capture identity, while authored\n\t-- limbs and props still have to fit the placement clearance.\n\tlocal localFrame, size, reason = BrainrotVisualScale.GetVisualBounds(model)\n\tif localFrame and size then\n\t\t-- The world factory canonicalizes every source to the shared gameplay height\n\t\t-- before activation. Apply that same pivot-relative scale mathematically here\n\t\t-- so placement checks use the real world envelope without cloning or mutating\n\t\t-- the authored source asset on every candidate attempt.\n\t\tlocal correction = BrainrotVisualScale.TARGET_HEIGHT_STUDS / size.Y\n\t\tif correction ~= correction or correction <= 0 or correction == math.huge then\n\t\t\treturn nil, nil, \"INVALID_VISIBLE_BOUNDS\"\n\t\tend\n\t\tlocalFrame = CFrame.new(localFrame.Position * correction) * localFrame.Rotation\n\t\tsize *= correction\n\t\tindex.envelopesByModelRef[definition.modelRef] = table.freeze({\n\t\t\tLocalFrame = localFrame,\n\t\t\tSize = size,\n\t\t})\n\tend\n\treturn localFrame, size, reason\nend\n\n-- This envelope serves only the new installed-art exclusion. Keep the existing\n-- source proxy, canonical scale, grounding and all other predicates unchanged.\n-- Native unions may have an Extents origin distinct from their main-part CFrame.\nlocal function getMapArtEnvelope(index: Index, definition: any): (CFrame?, Vector3?, string?)\n\tlocal cached = index.mapArtEnvelopesByModelRef[definition.modelRef]\n\tif cached then\n\t\treturn cached.LocalFrame, cached.Size, nil\n\tend\n\tlocal model = getModel(index, definition)\n\tif model == nil then\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\t-- The shared factory derives its factor from the original CFrame/Size bounds.\n\t-- Changing that factor to ExtentsSize here would change accepted model scale.\n\tlocal _, sourceSize = BrainrotVisualScale.GetVisualBounds(model)\n\tif sourceSize == nil then\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\tlocal correction = BrainrotVisualScale.TARGET_HEIGHT_STUDS / sourceSize.Y\n\tif correction ~= correction or correction <= 0 or correction == math.huge then\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\tlocal pivot = model:GetPivot()\n\tlocal low, high = Vector3.one * math.huge, Vector3.one * -math.huge\n\tlocal count = 0\n\tfor _, descendant in model:GetDescendants() do\n\t\tif descendant:IsA(\"BasePart\") and BrainrotVisualScale.IsVisualPart(descendant, model) then\n\t\t\tlocal frame = if descendant:IsA(\"PartOperation\")\n\t\t\t\tthen descendant.ExtentsCFrame\n\t\t\t\telse descendant.CFrame\n\t\t\tlocal size = if descendant:IsA(\"PartOperation\")\n\t\t\t\tthen descendant.ExtentsSize\n\t\t\t\telse descendant.Size\n\t\t\tfor _, corner in boxCorners(frame, size) do\n\t\t\t\tlocal point = pivot:PointToObjectSpace(corner)\n\t\t\t\tlow, high = low:Min(point), high:Max(point)\n\t\t\tend\n\t\t\tcount += 1\n\t\tend\n\tend\n\tlocal size = (high - low) * correction\n\tlocal centre = (low + high) * (0.5 * correction)\n\tif\n\t\tcount == 0\n\t\tor not finiteVector3(centre)\n\t\tor not finiteVector3(size)\n\t\tor size.X <= 0\n\t\tor size.Y <= 0\n\t\tor size.Z <= 0\n\tthen\n\t\treturn nil, nil, \"INVALID_MAP_ART_ENVELOPE\"\n\tend\n\tlocal localFrame = CFrame.new(centre)\n\tindex.mapArtEnvelopesByModelRef[definition.modelRef] = table.freeze({\n\t\tLocalFrame = localFrame,\n\t\tSize = size,\n\t})\n\treturn localFrame, size, nil\nend\n\nlocal function behaviourReady(index: Index, definition: any): boolean\n\tif type(index.context.IsBehaviourReady) == \"function\" then\n\t\treturn index.context.IsBehaviourReady(definition.behaviourId, definition)\n\tend\n\treturn READY_BEHAVIOURS[definition.behaviourId] == true\nend\n\nlocal function current(): Index\n\tif currentIndex == nil then\n\t\tRegionSpawnCatalog.BuildIndex(Regions.GetAll(), BrainrotCatalog.GetAll(), nil)\n\tend\n\treturn currentIndex :: Index\nend\n\nfunction RegionSpawnCatalog.BuildIndex(\n\tregionDefinitions: { any }?,\n\tspeciesDefinitions: { any }?,\n\tmapContext: any?\n): ValidationReport\n\tlocal report: ValidationReport = { errors = {}, warnings = {} }\n\tlocal context = mapContext or defaultContext()\n\tlocal mapArtFootprints, mapArtFootprintsError = copyMapArtFootprints(\n\t\tif context.MapArtFootprints == nil then {} else context.MapArtFootprints\n\t)\n\tmapArtFootprintsError = context.MapArtFootprintsError or mapArtFootprintsError\n\tif mapArtFootprintsError then\n\t\taddIssue(report, \"Error\", \"INVALID_MAP_ART_FOOTPRINTS\", mapArtFootprintsError)\n\tend\n\t-- Separate bounded geometry layer; never append walls to the 343-art-row contract.\n\tlocal wallsValid, wallIndex = pcall(CompactMapGeometry.BuildWallIndex, context.StaticWallObstacles or {})\n\tif not wallsValid then\n\t\taddIssue(report, \"Error\", \"INVALID_STATIC_WALL_OBSTACLES\", tostring(wallIndex))\n\t\twallIndex = CompactMapGeometry.BuildWallIndex({})\n\tend\n\tlocal index: Index = {\n\t\tregionsById = {},\n\t\tregionOrder = {},\n\t\tspeciesById = {},\n\t\tapprovedSpeciesByRegion = {},\n\t\tareasByRegion = {},\n\t\tareasById = {},\n\t\tboundariesByRegion = {},\n\t\tprotectedInstances = table.clone(context.ProtectedInstances or {}),\n\t\tmapArtFootprints = mapArtFootprints,\n\t\tmapArtFootprintsValid = mapArtFootprintsError == nil,\n\t\tstaticWallIndex = wallIndex,\n\t\tstaticWallObstaclesValid = wallsValid,\n\t\tmapArtEnvelopesByModelRef = {},\n\t\tenvelopesByModelRef = {},\n\t\tcontext = context,\n\t\treport = report,\n\t}\n\n\tfor _, definition in regionDefinitions or Regions.GetAll() do\n\t\tlocal regionId = Regions.NormalizeId(definition.id)\n\t\tif regionId == nil or regionId ~= definition.id then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"UNKNOWN_REGION\",\n\t\t\t\t\"region definition has a non-canonical ID\",\n\t\t\t\tnil,\n\t\t\t\tdefinition.id,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tif index.regionsById[regionId] then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"DUPLICATE_REGION_ID\",\n\t\t\t\t\"region ID is declared more than once\",\n\t\t\t\tnil,\n\t\t\t\tregionId,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tindex.regionsById[regionId] = definition\n\t\ttable.insert(index.regionOrder, regionId)\n\t\tindex.approvedSpeciesByRegion[regionId] = {}\n\t\tindex.areasByRegion[regionId] = {}\n\t\tindex.boundariesByRegion[regionId] = {}\n\n\t\tif definition.kind == \"Hub\" and definition.naturalSpawnAllowed == true then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"CAMP_NOT_SPAWNABLE\",\n\t\t\t\t\"hub regions cannot permit natural spawning\",\n\t\t\t\tnil,\n\t\t\t\tregionId,\n\t\t\t\tnil\n\t\t\t)\n\t\tend\n\t\tif regionId == Regions.CampId and #(definition.spawnAreaRefs or {}) > 0 then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"CAMP_NOT_SPAWNABLE\",\n\t\t\t\t\"Camp must not reference natural spawn areas\",\n\t\t\t\tnil,\n\t\t\t\tregionId,\n\t\t\t\tnil\n\t\t\t)\n\t\tend\n\n\t\tfor _, reference in definition.boundaryRefs or {} do\n\t\t\tlocal instance = resolveReference(context, reference)\n\t\t\tif instance == nil then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_REGION_BOUNDARY\",\n\t\t\t\t\t\"boundary reference does not resolve: \" .. reference,\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\telse\n\t\t\t\tfor _, part in collectBoundaryParts(instance) do\n\t\t\t\t\ttable.insert(index.boundariesByRegion[regionId], part)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tfor _, reference in definition.spawnAreaRefs or {} do\n\t\t\tlocal instance = resolveReference(context, reference)\n\t\t\tif instance == nil then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_SPAWN_AREA\",\n\t\t\t\t\t\"spawn-area reference does not resolve: \" .. reference,\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal parts = collectAreaParts(instance)\n\t\t\tif #parts == 0 then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_SPAWN_AREA\",\n\t\t\t\t\t\"spawn-area reference contains no BaseParts: \" .. reference,\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\t\tfor _, part in parts do\n\t\t\t\tlocal floorSurface = isAuthoredFloor(part)\n\t\t\t\tlocal areaId = part:GetAttribute(\"SpawnAreaId\")\n\t\t\t\tif floorSurface and not nonEmpty(areaId) then\n\t\t\t\t\tareaId = regionId .. \":\" .. tostring(part:GetAttribute(\"CellId\"))\n\t\t\t\tend\n\t\t\t\tlocal areaRegionId = Regions.NormalizeId(part:GetAttribute(\"RegionId\"))\n\t\t\t\tif floorSurface and areaRegionId == nil then\n\t\t\t\t\tareaRegionId = regionId\n\t\t\t\tend\n\t\t\t\tlocal kind = part:GetAttribute(\"SpawnAreaKind\")\n\t\t\t\tif floorSurface and kind == nil then\n\t\t\t\t\tkind = \"Volume\"\n\t\t\t\tend\n\t\t\t\tif not nonEmpty(areaId) or (kind ~= \"Point\" and kind ~= \"Volume\") then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"INVALID_SPAWN_AREA\",\n\t\t\t\t\t\t\"spawn area needs SpawnAreaId and Point/Volume kind\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tif type(areaId) == \"string\" then areaId else nil\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif areaRegionId ~= regionId then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"SPAWN_AREA_REGION_MISMATCH\",\n\t\t\t\t\t\t\"spawn area RegionId does not match its configured region\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif index.areasById[areaId] then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"DUPLICATE_SPAWN_AREA_ID\",\n\t\t\t\t\t\t\"SpawnAreaId is declared more than once\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif not part.Anchored then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"INVALID_SPAWN_AREA\",\n\t\t\t\t\t\t\"spawn area must be anchored\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tif\n\t\t\t\t\tkind == \"Point\"\n\t\t\t\t\tand (part.CanCollide or part.CanTouch or part.CanQuery or part.CastShadow)\n\t\t\t\tthen\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"INVALID_SPAWN_AREA\",\n\t\t\t\t\t\t\"point helper must not collide, touch, query or cast shadows\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tareaId\n\t\t\t\t\t)\n\t\t\t\t\tcontinue\n\t\t\t\tend\n\t\t\t\tlocal enabledAttribute = part:GetAttribute(\"Enabled\")\n\t\t\t\tlocal area: SpawnArea = {\n\t\t\t\t\tId = areaId,\n\t\t\t\t\tRegionId = regionId,\n\t\t\t\t\tKind = kind,\n\t\t\t\t\tReference = reference,\n\t\t\t\t\tPart = part,\n\t\t\t\t\tEnabled = if type(enabledAttribute) == \"boolean\"\n\t\t\t\t\t\tthen enabledAttribute\n\t\t\t\t\t\telse true,\n\t\t\t\t\tProbeCount = 0,\n\t\t\t\t\tUsableProbeCount = 0,\n\t\t\t\t\tIsFloorSurface = floorSurface,\n\t\t\t\t}\n\t\t\t\tarea.ProbeCount, area.UsableProbeCount = countUsableProbes(area, context)\n\t\t\t\ttable.freeze(area)\n\t\t\t\tindex.areasById[area.Id] = area\n\t\t\t\ttable.insert(index.areasByRegion[regionId], area)\n\t\t\t\tif area.Enabled and area.UsableProbeCount == 0 then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Warning\",\n\t\t\t\t\t\t\"NO_VALID_GROUND\",\n\t\t\t\t\t\t\"spawn area has no usable deterministic ground probes\",\n\t\t\t\t\t\tnil,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tarea.Id\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif definition.enabled == true and definition.kind == \"Hunting\" then\n\t\t\tif #index.boundariesByRegion[regionId] == 0 then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_REGION_BOUNDARY\",\n\t\t\t\t\t\"enabled hunting region has no resolved boundary\",\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\t\tif definition.naturalSpawnAllowed == true and #index.areasByRegion[regionId] == 0 then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"MISSING_SPAWN_AREA\",\n\t\t\t\t\t\"enabled hunting region has no registered spawn areas\",\n\t\t\t\t\tnil,\n\t\t\t\t\tregionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\tend\n\tend\n\n\tfor _, definition in speciesDefinitions or BrainrotCatalog.GetAll() do\n\t\tlocal speciesId = BrainrotCatalog.NormalizeId(definition.id)\n\t\tif speciesId == nil or speciesId ~= definition.id then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"UNKNOWN_SPECIES\",\n\t\t\t\t\"species definition has a non-canonical ID\",\n\t\t\t\tdefinition.id,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tif index.speciesById[speciesId] then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"DUPLICATE_SPECIES_ID\",\n\t\t\t\t\"species ID is declared more than once\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\t\tcontinue\n\t\tend\n\t\tindex.speciesById[speciesId] = definition\n\t\tlocal status = definition.regionAssignmentStatus\n\t\tif status == \"Pending\" then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Warning\",\n\t\t\t\t\"REGION_ASSIGNMENT_PENDING\",\n\t\t\t\t\"current-map assignment requires approval\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\telseif status == \"Conflict\" then\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Warning\",\n\t\t\t\t\"REGION_ASSIGNMENT_CONFLICT\",\n\t\t\t\t\"approved sources conflict\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\telseif status == \"Approved\" then\n\t\t\tlocal homeRegionId = Regions.NormalizeId(definition.homeRegionId)\n\t\t\tlocal allowedSet: { [string]: boolean } = {}\n\t\t\tfor _, rawRegionId in definition.allowedRegionIds or {} do\n\t\t\t\tlocal regionId = Regions.NormalizeId(rawRegionId)\n\t\t\t\tif regionId == nil or index.regionsById[regionId] == nil then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"UNKNOWN_REGION\",\n\t\t\t\t\t\t\"approved assignment references an unknown region\",\n\t\t\t\t\t\tspeciesId,\n\t\t\t\t\t\trawRegionId,\n\t\t\t\t\t\tnil\n\t\t\t\t\t)\n\t\t\t\telseif regionId == Regions.CampId then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"CAMP_NOT_SPAWNABLE\",\n\t\t\t\t\t\t\"Camp cannot be an allowed natural-spawn region\",\n\t\t\t\t\t\tspeciesId,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tnil\n\t\t\t\t\t)\n\t\t\t\telseif allowedSet[regionId] then\n\t\t\t\t\taddIssue(\n\t\t\t\t\t\treport,\n\t\t\t\t\t\t\"Error\",\n\t\t\t\t\t\t\"DUPLICATE_ALLOWED_REGION\",\n\t\t\t\t\t\t\"approved assignment repeats a region\",\n\t\t\t\t\t\tspeciesId,\n\t\t\t\t\t\tregionId,\n\t\t\t\t\t\tnil\n\t\t\t\t\t)\n\t\t\t\telse\n\t\t\t\t\tallowedSet[regionId] = true\n\t\t\t\t\ttable.insert(index.approvedSpeciesByRegion[regionId], speciesId)\n\t\t\t\tend\n\t\t\tend\n\t\t\tif homeRegionId == nil or not allowedSet[homeRegionId] then\n\t\t\t\taddIssue(\n\t\t\t\t\treport,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"HOME_NOT_ALLOWED\",\n\t\t\t\t\t\"approved home must appear in the allowed list\",\n\t\t\t\t\tspeciesId,\n\t\t\t\t\thomeRegionId,\n\t\t\t\t\tnil\n\t\t\t\t)\n\t\t\tend\n\t\telse\n\t\t\taddIssue(\n\t\t\t\treport,\n\t\t\t\t\"Error\",\n\t\t\t\t\"INVALID_REGION_ASSIGNMENT_STATUS\",\n\t\t\t\t\"assignment status is invalid\",\n\t\t\t\tspeciesId,\n\t\t\t\tnil,\n\t\t\t\tnil\n\t\t\t)\n\t\tend\n\tend\n\n\tfor _, speciesIds in index.approvedSpeciesByRegion do\n\t\ttable.sort(speciesIds)\n\tend\n\tfor _, areas in index.areasByRegion do\n\t\ttable.sort(areas, function(left, right)\n\t\t\treturn left.Id < right.Id\n\t\tend)\n\tend\n\tfor _, boundary in index.boundariesByRegion[Regions.CampId] or {} do\n\t\ttable.insert(index.protectedInstances, boundary)\n\tend\n\tcurrentIndex = index\n\treturn cloneReport(report)\nend\n\nfunction RegionSpawnCatalog.GetSpeciesAssignment(speciesId: unknown): any?\n\tlocal index = current()\n\tlocal normalized = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal definition = if normalized then index.speciesById[normalized] else nil\n\tif definition == nil then\n\t\treturn nil\n\tend\n\treturn table.freeze({\n\t\thomeRegionId = definition.homeRegionId,\n\t\tallowedRegionIds = table.freeze(table.clone(definition.allowedRegionIds or {})),\n\t\tstatus = definition.regionAssignmentStatus,\n\t})\nend\n\nfunction RegionSpawnCatalog.ResolveHomeRegion(speciesId: unknown): (string?, string?)\n\tlocal assignment = RegionSpawnCatalog.GetSpeciesAssignment(speciesId)\n\tif assignment == nil then\n\t\treturn nil, \"UNKNOWN_SPECIES\"\n\tend\n\tif assignment.status ~= \"Approved\" then\n\t\treturn nil,\n\t\t\tif assignment.status == \"Conflict\"\n\t\t\t\tthen \"REGION_ASSIGNMENT_CONFLICT\"\n\t\t\t\telse \"REGION_ASSIGNMENT_PENDING\"\n\tend\n\tlocal homeRegionId = Regions.NormalizeId(assignment.homeRegionId)\n\tlocal region = if homeRegionId then Regions.Get(homeRegionId) else nil\n\tif region == nil or region.kind ~= \"Hunting\" or region.naturalSpawnAllowed ~= true then\n\t\treturn nil, \"INVALID_HOME_REGION\"\n\tend\n\tfor _, rawRegionId in assignment.allowedRegionIds do\n\t\tif Regions.NormalizeId(rawRegionId) == homeRegionId then\n\t\t\treturn homeRegionId, nil\n\t\tend\n\tend\n\treturn nil, \"HOME_NOT_ALLOWED\"\nend\n\nfunction RegionSpawnCatalog.IsSpeciesAllowedInRegion(speciesId: unknown, regionId: unknown): boolean\n\tlocal index = current()\n\tlocal normalizedSpecies = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal definition = if normalizedSpecies then index.speciesById[normalizedSpecies] else nil\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif\n\t\tdefinition == nil\n\t\tor region == nil\n\t\tor normalizedRegion == Regions.CampId\n\t\tor region.kind ~= \"Hunting\"\n\t\tor not region.naturalSpawnAllowed\n\t\tor definition.regionAssignmentStatus ~= \"Approved\"\n\tthen\n\t\treturn false\n\tend\n\tfor _, allowedRegionId in definition.allowedRegionIds or {} do\n\t\tif allowedRegionId == normalizedRegion then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nfunction RegionSpawnCatalog.GetApprovedSpeciesIds(regionId: unknown): { string }\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil or normalized == Regions.CampId then\n\t\treturn {}\n\tend\n\treturn table.clone(index.approvedSpeciesByRegion[normalized] or {})\nend\n\nfunction RegionSpawnCatalog.GetSpawnAreas(regionId: unknown): { SpawnArea }\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil or normalized == Regions.CampId then\n\t\treturn {}\n\tend\n\treturn table.clone(index.areasByRegion[normalized] or {})\nend\n\nfunction RegionSpawnCatalog.ContainsPosition(\n\tregionId: unknown,\n\tposition: unknown,\n\tverticalTolerance: number?\n): boolean\n\tif not finiteVector3(position) then\n\t\treturn false\n\tend\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil then\n\t\treturn false\n\tend\n\tlocal tolerance = verticalTolerance\n\tif type(tolerance) ~= \"number\" or tolerance ~= tolerance or tolerance < 0 then\n\t\ttolerance = FLOOR_VERTICAL_TOLERANCE_STUDS\n\tend\n\tfor _, boundary in index.boundariesByRegion[normalized] or {} do\n\t\tif isAuthoredFloor(boundary) then\n\t\t\tlocal localPoint = boundary.CFrame:PointToObjectSpace(position :: Vector3)\n\t\t\tif\n\t\t\t\tcontainsSurfacePoint(boundary, position :: Vector3)\n\t\t\t\tand math.abs(localPoint.Y - boundary.Size.Y * 0.5) <= tolerance\n\t\t\tthen\n\t\t\t\treturn true\n\t\t\tend\n\t\telseif containsPoint(boundary, position :: Vector3) then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\nfunction RegionSpawnCatalog.GetRegionAtPosition(position: unknown): any?\n\tlocal index = current()\n\tfor _, regionId in index.regionOrder do\n\t\tif RegionSpawnCatalog.ContainsPosition(regionId, position) then\n\t\t\treturn index.regionsById[regionId]\n\t\tend\n\tend\n\treturn nil\nend\n\n-- Supplies static, reference-free selector inputs from the authoritative Phase\n-- 6F-1 relationship. It deliberately returns approved regional members only;\n-- SpawnSelection still validates every field and never owns a second species list.\nfunction RegionSpawnCatalog.GetSelectionCandidates(regionId: unknown): { SelectionCandidate }\n\tlocal index = current()\n\tlocal normalized = Regions.NormalizeId(regionId)\n\tif normalized == nil or normalized == Regions.CampId then\n\t\treturn {}\n\tend\n\tlocal candidates: { SelectionCandidate } = {}\n\tfor _, speciesId in index.approvedSpeciesByRegion[normalized] or {} do\n\t\tlocal definition = index.speciesById[speciesId]\n\t\tif definition == nil then\n\t\t\tcontinue\n\t\tend\n\t\tlocal readiness = RegionSpawnCatalog.EvaluateNaturalSpawnReadiness(speciesId, normalized)\n\t\tlocal reasonSet: { [string]: boolean } = {}\n\t\tfor _, reason in readiness.reasons do\n\t\t\treasonSet[reason] = true\n\t\tend\n\t\tlocal reasons = table.freeze(table.clone(readiness.reasons))\n\t\tlocal allowedRegionIds = table.freeze(table.clone(definition.allowedRegionIds or {}))\n\t\tlocal candidate: SelectionCandidate = {\n\t\t\tid = speciesId,\n\t\t\ttier = definition.tier,\n\t\t\tassignmentStatus = definition.regionAssignmentStatus,\n\t\t\thomeRegionId = definition.homeRegionId,\n\t\t\tallowedRegionIds = allowedRegionIds,\n\t\t\tspawnEnabled = definition.spawnEnabled == true,\n\t\t\tlaunchStatus = definition.launchStatus,\n\t\t\tnaturalSpawnEligible = definition.launchStatus == \"Live\",\n\t\t\tmodelReady = reasonSet.MODEL_MISSING ~= true,\n\t\t\tbehaviourReady = reasonSet.BEHAVIOUR_NOT_READY ~= true,\n\t\t\tlocationReady = reasonSet.MISSING_REGION_BOUNDARY ~= true\n\t\t\t\tand reasonSet.MISSING_SPAWN_AREA ~= true,\n\t\t\t-- No catalogue field currently has verified within-tier-weight semantics.\n\t\t\tglobalWithinTierWeight = nil,\n\t\t\treadinessReasons = reasons,\n\t\t}\n\t\ttable.freeze(candidate)\n\t\ttable.insert(candidates, candidate)\n\tend\n\treturn candidates\nend\n\nfunction RegionSpawnCatalog.EvaluateNaturalSpawnReadiness(\n\tspeciesId: unknown,\n\tregionId: unknown\n): any\n\tlocal index = current()\n\tlocal reasons: { string } = {}\n\tlocal activationReasons: { string } = {}\n\tlocal normalizedSpecies = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal definition = if normalizedSpecies then index.speciesById[normalizedSpecies] else nil\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif definition == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_SPECIES\")\n\telseif definition.regionAssignmentStatus == \"Pending\" then\n\t\ttable.insert(reasons, \"REGION_ASSIGNMENT_PENDING\")\n\telseif definition.regionAssignmentStatus == \"Conflict\" then\n\t\ttable.insert(reasons, \"REGION_ASSIGNMENT_CONFLICT\")\n\tend\n\tif region == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_REGION\")\n\telseif\n\t\tnormalizedRegion == Regions.CampId\n\t\tor region.kind ~= \"Hunting\"\n\t\tor not region.naturalSpawnAllowed\n\tthen\n\t\ttable.insert(reasons, \"CAMP_NOT_SPAWNABLE\")\n\telse\n\t\tif #index.boundariesByRegion[normalizedRegion] == 0 then\n\t\t\ttable.insert(reasons, \"MISSING_REGION_BOUNDARY\")\n\t\tend\n\t\tlocal usable = false\n\t\tfor _, area in index.areasByRegion[normalizedRegion] do\n\t\t\tif area.Enabled and area.UsableProbeCount > 0 then\n\t\t\t\tusable = true\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\t\tif not usable then\n\t\t\ttable.insert(reasons, \"MISSING_SPAWN_AREA\")\n\t\tend\n\tend\n\tif\n\t\tdefinition\n\t\tand region\n\t\tand not RegionSpawnCatalog.IsSpeciesAllowedInRegion(definition.id, region.id)\n\tthen\n\t\tif definition.regionAssignmentStatus == \"Approved\" then\n\t\t\ttable.insert(reasons, \"SPECIES_NOT_ALLOWED_IN_REGION\")\n\t\tend\n\tend\n\tif definition then\n\t\tif getModel(index, definition) == nil then\n\t\t\ttable.insert(reasons, \"MODEL_MISSING\")\n\t\tend\n\t\tif not behaviourReady(index, definition) then\n\t\t\ttable.insert(reasons, \"BEHAVIOUR_NOT_READY\")\n\t\tend\n\t\tif definition.launchStatus ~= \"Live\" then\n\t\t\ttable.insert(activationReasons, \"CONTENT_TEASED\")\n\t\tend\n\t\tif definition.spawnEnabled ~= true then\n\t\t\ttable.insert(activationReasons, \"SPAWN_DISABLED\")\n\t\tend\n\tend\n\tlocal ready = #reasons == 0\n\tif not ready then\n\t\ttable.insert(activationReasons, \"NOT_TECHNICALLY_READY\")\n\tend\n\treturn table.freeze({\n\t\tready = ready,\n\t\tactivated = ready and #activationReasons == 0,\n\t\treasons = table.freeze(reasons),\n\t\tactivationReasons = table.freeze(activationReasons),\n\t})\nend\n\nlocal function validateGround(\n\tindex: Index,\n\tcandidate: Vector3,\n\tarea: SpawnArea,\n\tdefinition: any\n): (boolean, Vector3?, string?)\n\tif type(index.context.ValidateGround) == \"function\" then\n\t\treturn index.context.ValidateGround(candidate, area, definition)\n\tend\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = if area.IsFloorSurface then {} else { area.Part }\n\tparams.RespectCanCollide = true\n\tparams.IgnoreWater = false\n\tlocal result = Workspace:Raycast(candidate + Vector3.yAxis * 4, -Vector3.yAxis * 8, params)\n\tif\n\t\tresult == nil\n\t\tor result.Material == Enum.Material.Water\n\t\tor result.Normal.Y < BrainrotTerritory.MinWalkableNormalY\n\tthen\n\t\treturn false, nil, \"NO_VALID_GROUND\"\n\tend\n\tif math.abs(result.Position.Y - candidate.Y) > 2 then\n\t\treturn false, nil, \"NO_VALID_GROUND\"\n\tend\n\treturn true, result.Position, nil\nend\n\nlocal function isProtected(\n\tindex: Index,\n\tframe: CFrame,\n\tsize: Vector3,\n\tignoredRegionId: string?\n): (boolean, string?, string?)\n\tif not index.staticWallObstaclesValid then return true, \"INVALID_STATIC_WALL_OBSTACLES\", nil end\n\tlocal wallId = CompactMapGeometry.WallHit(index.staticWallIndex, frame, size, 0)\n\tif wallId then return true, \"STATIC_WALL_OBSTACLE_OVERLAP\", wallId end\n\tif ignoredRegionId ~= Regions.CampId then\n\t\tfor _, boundary in index.boundariesByRegion[Regions.CampId] or {} do\n\t\t\tif boxesOverlapByCorners(frame, size, boundary) then\n\t\t\t\treturn true, \"PROTECTED_AREA_OVERLAP\", string.sub(boundary:GetFullName(), 1, 512)\n\t\t\tend\n\t\tend\n\tend\n\tif type(index.context.IsProtected) == \"function\" then\n\t\tlocal protected, reason = index.context.IsProtected(frame, size)\n\t\treturn protected, reason, nil\n\tend\n\tif #index.protectedInstances == 0 then\n\t\treturn false, nil, nil\n\tend\n\tlocal protectedInstances = index.protectedInstances\n\tif ignoredRegionId == Regions.CampId then\n\t\tlocal campBoundaries = {}\n\t\tfor _, boundary in index.boundariesByRegion[Regions.CampId] or {} do\n\t\t\tcampBoundaries[boundary] = true\n\t\tend\n\t\tprotectedInstances = {}\n\t\tfor _, instance in index.protectedInstances do\n\t\t\tif not campBoundaries[instance] then\n\t\t\t\ttable.insert(protectedInstances, instance)\n\t\t\tend\n\t\tend\n\t\tif #protectedInstances == 0 then\n\t\t\treturn false, nil, nil\n\t\tend\n\tend\n\tlocal params = OverlapParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = protectedInstances\n\tparams.RespectCanCollide = false\n\tparams.MaxParts = 1\n\tlocal hit = Workspace:GetPartBoundsInBox(frame, size, params)[1]\n\treturn hit ~= nil,\n\t\t\"PROTECTED_AREA_OVERLAP\",\n\t\tif hit then string.sub(hit:GetFullName(), 1, 512) else nil\nend\n\nfunction RegionSpawnCatalog.IsProtectedSpace(\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown\n): (boolean, string?)\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn true, \"INVALID_ENVELOPE\"\n\tend\n\tlocal protected, reason = isProtected(current(), envelopeFrame, envelopeSize)\n\treturn protected, reason\nend\n\n-- The one-time Camp-return lifecycle has already admitted a real world member\n-- inside the protected hub. Ignore only the Camp floor while it exits; bases,\n-- service stalls, and cart-spawn protection remain authoritative.\nfunction RegionSpawnCatalog.IsProtectedForCampReturn(\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown\n): (boolean, string?, string?)\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn true, \"INVALID_ENVELOPE\", nil\n\tend\n\treturn isProtected(current(), envelopeFrame, envelopeSize, Regions.CampId)\nend\n\nfunction RegionSpawnCatalog.IsInsideHuntingSpace(\n\tregionId: unknown,\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown,\n\tboundaryPadding: number?\n): (boolean, string?)\n\tlocal index = current()\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif\n\t\tregion == nil\n\t\tor normalizedRegion == Regions.CampId\n\t\tor region.kind ~= \"Hunting\"\n\t\tor region.enabled ~= true\n\t\tor region.naturalSpawnAllowed ~= true\n\tthen\n\t\treturn false, \"REGION_NOT_SPAWNABLE\"\n\tend\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn false, \"INVALID_ENVELOPE\"\n\tend\n\tlocal padding = boundaryPadding\n\tif type(padding) ~= \"number\" or padding ~= padding or padding < 0 or padding == math.huge then\n\t\tpadding = BrainrotTerritory.BoundaryPaddingStuds\n\tend\n\tlocal inside = false\n\tfor _, boundary in index.boundariesByRegion[normalizedRegion] do\n\t\tif boxFitsPart(envelopeFrame, envelopeSize, boundary, padding) then\n\t\t\tinside = true\n\t\t\tbreak\n\t\tend\n\tend\n\tif not inside then\n\t\treturn false, \"OUTSIDE_REGION\"\n\tend\n\tlocal protected, reason = isProtected(index, envelopeFrame, envelopeSize)\n\tif protected then\n\t\treturn false, reason or \"PROTECTED_AREA_OVERLAP\"\n\tend\n\treturn true, nil\nend\n\n-- Boundary-only query used by the one-time Camp-return lifecycle. Unlike the\n-- natural-placement query it permits the protected Camp hub and does not imply\n-- spawn eligibility.\nfunction RegionSpawnCatalog.IsInsideRegionSpace(\n\tregionId: unknown,\n\tenvelopeFrame: unknown,\n\tenvelopeSize: unknown,\n\tboundaryPadding: number?\n): (boolean, string?)\n\tlocal index = current()\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal region = if normalizedRegion then index.regionsById[normalizedRegion] else nil\n\tif region == nil or region.enabled ~= true then\n\t\treturn false, \"UNKNOWN_REGION\"\n\tend\n\tif\n\t\ttypeof(envelopeFrame) ~= \"CFrame\"\n\t\tor not finiteVector3(\n\t\t\tif typeof(envelopeFrame) == \"CFrame\" then envelopeFrame.Position else nil\n\t\t)\n\t\tor not finiteVector3(envelopeSize)\n\t\tor envelopeSize.X <= 0\n\t\tor envelopeSize.Y <= 0\n\t\tor envelopeSize.Z <= 0\n\tthen\n\t\treturn false, \"INVALID_ENVELOPE\"\n\tend\n\tlocal padding = boundaryPadding\n\tif type(padding) ~= \"number\" or padding ~= padding or padding < 0 or padding == math.huge then\n\t\tpadding = BrainrotTerritory.BoundaryPaddingStuds\n\tend\n\tif not index.staticWallObstaclesValid then return false, \"INVALID_STATIC_WALL_OBSTACLES\" end\n\tif CompactMapGeometry.WallHit(index.staticWallIndex, envelopeFrame, envelopeSize, 0) then\n\t\treturn false, \"STATIC_WALL_OBSTACLE_OVERLAP\"\n\tend\n\tfor _, boundary in index.boundariesByRegion[normalizedRegion] do\n\t\tif boxFitsPart(envelopeFrame, envelopeSize, boundary, padding) then\n\t\t\treturn true, nil\n\t\tend\n\tend\n\treturn false, \"OUTSIDE_REGION\"\nend\n\nlocal function validateClearance(\n\tindex: Index,\n\tframe: CFrame,\n\tsize: Vector3,\n\tarea: SpawnArea,\n\tdefinition: any\n): (boolean, string?)\n\tif type(index.context.ValidateClearance) == \"function\" then\n\t\treturn index.context.ValidateClearance(frame, size, area, definition)\n\tend\n\tlocal params = OverlapParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = { area.Part }\n\tparams.RespectCanCollide = true\n\tparams.MaxParts = 1\n\tlocal padded = size + Vector3.new(0.2, 0, 0.2)\n\treturn #Workspace:GetPartBoundsInBox(frame, padded, params) == 0, \"INSUFFICIENT_CLEARANCE\"\nend\n\nfunction RegionSpawnCatalog.ValidatePlacement(\n\tspeciesId: unknown,\n\tregionId: unknown,\n\tareaId: unknown,\n\tcandidatePosition: unknown\n): any\n\tlocal index = current()\n\tlocal reasons: { string } = {}\n\tif not index.mapArtFootprintsValid then\n\t\ttable.insert(reasons, \"INVALID_MAP_ART_FOOTPRINTS\")\n\tend\n\tif not index.staticWallObstaclesValid then table.insert(reasons, \"INVALID_STATIC_WALL_OBSTACLES\") end\n\tlocal normalizedSpecies = BrainrotCatalog.NormalizeId(speciesId)\n\tlocal normalizedRegion = Regions.NormalizeId(regionId)\n\tlocal definition = if normalizedSpecies then index.speciesById[normalizedSpecies] else nil\n\tlocal area = if type(areaId) == \"string\" then index.areasById[areaId] else nil\n\tif definition == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_SPECIES\")\n\tend\n\tif normalizedRegion == nil or index.regionsById[normalizedRegion] == nil then\n\t\ttable.insert(reasons, \"UNKNOWN_REGION\")\n\telseif normalizedRegion == Regions.CampId then\n\t\ttable.insert(reasons, \"CAMP_NOT_SPAWNABLE\")\n\tend\n\tif area == nil then\n\t\ttable.insert(reasons, \"MISSING_SPAWN_AREA\")\n\telseif area.RegionId ~= normalizedRegion then\n\t\ttable.insert(reasons, \"SPAWN_AREA_REGION_MISMATCH\")\n\telseif not area.Enabled then\n\t\ttable.insert(reasons, \"SPAWN_AREA_DISABLED\")\n\tend\n\tif not finiteVector3(candidatePosition) then\n\t\ttable.insert(reasons, \"INVALID_CANDIDATE_POSITION\")\n\tend\n\tif\n\t\tdefinition\n\t\tand normalizedRegion\n\t\tand not RegionSpawnCatalog.IsSpeciesAllowedInRegion(definition.id, normalizedRegion)\n\tthen\n\t\ttable.insert(\n\t\t\treasons,\n\t\t\tif definition.regionAssignmentStatus == \"Pending\"\n\t\t\t\tthen \"REGION_ASSIGNMENT_PENDING\"\n\t\t\t\telseif\n\t\t\t\t\tdefinition.regionAssignmentStatus == \"Conflict\"\n\t\t\t\tthen \"REGION_ASSIGNMENT_CONFLICT\"\n\t\t\t\telse \"SPECIES_NOT_ALLOWED_IN_REGION\"\n\t\t)\n\tend\n\tif #reasons > 0 then\n\t\treturn table.freeze({ valid = false, reasons = table.freeze(reasons) })\n\tend\n\n\tlocal localEnvelopeFrame, envelopeSize, envelopeReason = getEnvelope(index, definition)\n\tif localEnvelopeFrame == nil or envelopeSize == nil then\n\t\ttable.insert(reasons, envelopeReason or \"MODEL_MISSING\")\n\t\treturn table.freeze({ valid = false, reasons = table.freeze(reasons) })\n\tend\n\tlocal candidate = candidatePosition :: Vector3\n\tlocal groundValid, groundPosition, groundReason =\n\t\tvalidateGround(index, candidate, area, definition)\n\tif not groundValid or groundPosition == nil then\n\t\ttable.insert(reasons, groundReason or \"NO_VALID_GROUND\")\n\t\treturn table.freeze({ valid = false, reasons = table.freeze(reasons) })\n\tend\n\n\tlocal basePivot = CFrame.new(groundPosition.X, groundPosition.Y, groundPosition.Z)\n\t\t* area.Part.CFrame.Rotation\n\tlocal initialEnvelopeFrame = basePivot * localEnvelopeFrame\n\tlocal half = envelopeSize * 0.5\n\tlocal verticalHalf = math.abs(initialEnvelopeFrame.RightVector.Y) * half.X\n\t\t+ math.abs(initialEnvelopeFrame.UpVector.Y) * half.Y\n\t\t+ math.abs(initialEnvelopeFrame.LookVector.Y) * half.Z\n\tlocal lift = groundPosition.Y - (initialEnvelopeFrame.Position.Y - verticalHalf) + 0.1\n\tlocal placementPivot = basePivot + Vector3.yAxis * lift\n\tlocal envelopeFrame = placementPivot * localEnvelopeFrame\n\tif area.Kind == \"Point\" then\n\t\tlocal horizontal =\n\t\t\tVector2.new(candidate.X - area.Part.Position.X, candidate.Z - area.Part.Position.Z)\n\t\tif horizontal.Magnitude > 0.75 or math.abs(candidate.Y - area.Part.Position.Y) > 2 then\n\t\t\ttable.insert(reasons, \"CANDIDATE_OUTSIDE_SPAWN_AREA\")\n\t\tend\n\telseif not boxFitsPart(envelopeFrame, envelopeSize, area.Part) then\n\t\ttable.insert(reasons, \"CANDIDATE_OUTSIDE_SPAWN_AREA\")\n\tend\n\n\tlocal boundaries = index.boundariesByRegion[normalizedRegion]\n\tlocal insideBoundary = false\n\tfor _, boundary in boundaries do\n\t\tif\n\t\t\tboxFitsPart(\n\t\t\t\tenvelopeFrame,\n\t\t\t\tenvelopeSize,\n\t\t\t\tboundary,\n\t\t\t\tBrainrotTerritory.BoundaryPaddingStuds\n\t\t\t)\n\t\tthen\n\t\t\tinsideBoundary = true\n\t\t\tbreak\n\t\tend\n\tend\n\tif not insideBoundary then\n\t\ttable.insert(reasons, \"OUTSIDE_REGION_BOUNDARY\")\n\tend\n\tlocal protected, protectedReason = isProtected(index, envelopeFrame, envelopeSize)\n\tif protected then\n\t\ttable.insert(reasons, protectedReason or \"PROTECTED_AREA_OVERLAP\")\n\tend\n\tif #index.mapArtFootprints > 0 then\n\t\tlocal artLocalFrame, artSize, artReason = getMapArtEnvelope(index, definition)\n\t\tif artLocalFrame == nil or artSize == nil then\n\t\t\ttable.insert(reasons, artReason or \"INVALID_MAP_ART_ENVELOPE\")\n\t\telseif\n\t\t\toverlapsMapArtFootprint(\n\t\t\t\tindex.mapArtFootprints,\n\t\t\t\tnormalizedRegion,\n\t\t\t\tplacementPivot * artLocalFrame,\n\t\t\t\tartSize\n\t\t\t)\n\t\tthen\n\t\t\ttable.insert(reasons, \"MAP_ART_FOOTPRINT_OVERLAP\")\n\t\tend\n\tend\n\tif #index.staticWallIndex.rows > 0 then\n\t\tlocal nativeFrame, nativeSize, nativeReason = getMapArtEnvelope(index, definition)\n\t\tif nativeFrame == nil or nativeSize == nil then\n\t\t\ttable.insert(reasons, nativeReason or \"INVALID_MAP_ART_ENVELOPE\")\n\t\telseif CompactMapGeometry.WallHit(index.staticWallIndex, placementPivot * nativeFrame, nativeSize, 2) then\n\t\t\ttable.insert(reasons, \"STATIC_WALL_OBSTACLE_OVERLAP\")\n\t\tend\n\tend\n\tlocal clear, clearanceReason =\n\t\tvalidateClearance(index, envelopeFrame, envelopeSize, area, definition)\n\tif not clear then\n\t\ttable.insert(reasons, clearanceReason or \"INSUFFICIENT_CLEARANCE\")\n\tend\n\treturn table.freeze({\n\t\tvalid = #reasons == 0,\n\t\treasons = table.freeze(reasons),\n\t\tgroundPosition = groundPosition,\n\t\tplacementPivot = placementPivot,\n\t\tplacementEnvelope = envelopeFrame,\n\t})\nend\n\nfunction RegionSpawnCatalog.ValidateConfiguration(): ValidationReport\n\treturn cloneReport(current().report)\nend\n\nfunction RegionSpawnCatalog.GetRegionSummary(): { any }\n\tlocal index = current()\n\tlocal summary = {}\n\tfor _, regionId in index.regionOrder do\n\t\tlocal readyCount = 0\n\t\tfor _, speciesId in index.approvedSpeciesByRegion[regionId] do\n\t\t\tif RegionSpawnCatalog.EvaluateNaturalSpawnReadiness(speciesId, regionId).ready then\n\t\t\t\treadyCount += 1\n\t\t\tend\n\t\tend\n\t\tlocal usableAreas = 0\n\t\tfor _, area in index.areasByRegion[regionId] do\n\t\t\tif area.Enabled and area.UsableProbeCount > 0 then\n\t\t\t\tusableAreas += 1\n\t\t\tend\n\t\tend\n\t\ttable.insert(\n\t\t\tsummary,\n\t\t\ttable.freeze({\n\t\t\t\tregionId = regionId,\n\t\t\t\tboundaryCount = #index.boundariesByRegion[regionId],\n\t\t\t\tapprovedSpeciesCount = #index.approvedSpeciesByRegion[regionId],\n\t\t\t\ttechnicallyReadySpeciesCount = readyCount,\n\t\t\t\tspawnAreaCount = #index.areasByRegion[regionId],\n\t\t\t\tusableSpawnAreaCount = usableAreas,\n\t\t\t})\n\t\t)\n\tend\n\treturn summary\nend\n\nfunction RegionSpawnCatalog.Start(): ValidationReport\n\tif started then\n\t\treturn RegionSpawnCatalog.ValidateConfiguration()\n\tend\n\tlocal report = RegionSpawnCatalog.BuildIndex(Regions.GetAll(), BrainrotCatalog.GetAll(), nil)\n\tstarted = true\n\tlocal counts: { [string]: number } = {}\n\tfor _, item in report.errors do\n\t\tcounts[item.code] = (counts[item.code] or 0) + 1\n\tend\n\tfor _, item in report.warnings do\n\t\tcounts[item.code] = (counts[item.code] or 0) + 1\n\tend\n\tlocal summary = {}\n\tfor code, count in counts do\n\t\ttable.insert(summary, string.format(\"%s=%d\", code, count))\n\tend\n\ttable.sort(summary)\n\tlog:Info(\n\t\t\"Regional configuration: %d error(s), %d warning(s), natural spawning unchanged\",\n\t\t#report.errors,\n\t\t#report.warnings\n\t)\n\tif #summary > 0 then\n\t\tlog:Warn(\"Regional readiness issues: %s\", table.concat(summary, \", \"))\n\tend\n\treturn report\nend\n\nreturn RegionSpawnCatalog\n"},{"path":"ServerScriptService.Server.Systems.BrainrotSaleSystem","beforeSHA256":"559c2ffaeca7c871c792b37a5b341c7d5567459f6eeaaa7c1e1d474789dd1a48","afterSHA256":"341201a402ba71ccb72171e0250166e29beafc86fe58f66826bd16d6b3b03ccb","beforeBytes":17989,"afterBytes":18115,"proposal":"docs/map-compaction/source-patches/proposals/ServerScriptService/Server/Systems/BrainrotSaleSystem.lua","diff":"docs/map-compaction/source-patches/diffs/ServerScriptService/Server/Systems/BrainrotSaleSystem.diff","beforeSource":"--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal HttpService = game:GetService(\"HttpService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal InteractionConfig = require(ReplicatedStorage.Shared.Config.BrainrotInteraction)\nlocal RemoteNames = require(ReplicatedStorage.Shared.Constants.RemoteNames)\nlocal PlayerDataService = require(script.Parent.Parent.Services.PlayerDataService)\n\nlocal PREVIEW_LIFETIME_SECONDS = 20\n\ntype Dependencies = {\n\tCarry: any,\n\tCurrency: any,\n\tCatalog: any,\n\tBanked: any?,\n\tResolveSalePoint: (() -> BasePart?)?,\n\tNow: (() -> number)?,\n\tGenerateSessionId: (() -> string)?,\n\tSessionClosingSignal: any?,\n\tBaseReleasingSignal: any?,\n}\n\ntype SaleSession = {\n\tSessionId: string,\n\tIndividualId: string,\n\tCatalogueId: string,\n\tDisplayName: string,\n\tRank: string,\n\tSellValue: number,\n\tCreatedAt: number,\n}\n\nlocal BrainrotSaleSystem = {}\nlocal dependencies: Dependencies? = nil\nlocal started = false\nlocal pendingSales: { [Player]: SaleSession } = {}\nlocal saleInProgress: { [Player]: boolean } = {}\nlocal warnedInvalidCatalogueIds: { [string]: boolean } = {}\nlocal connections: { any } = {}\nlocal playerConnections: { [Player]: { RBXScriptConnection } } = {}\nlocal openRemote: RemoteEvent? = nil\nlocal confirmRemote: RemoteFunction? = nil\nlocal cancelRemote: RemoteEvent? = nil\nlocal confirmHandler: ((Player, any) -> any)? = nil\nlocal committedListeners: { [any]: (Player, any) -> () } = {}\nlocal committedSequence = 0\n\nlocal function notifyCommitted(player: Player, receipt: any)\n\tcommittedSequence += 1\n\tlocal session = PlayerDataService:GetSessionHandle(player)\n\treceipt.sessionGeneration = if session then session.Generation else nil\n\treceipt.stream = \"Sale\"\n\treceipt.operationSequence = committedSequence\n\tlocal immutable = table.freeze(receipt)\n\tfor _, callback in committedListeners do\n\t\tlocal ok, observerFailure = pcall(callback, player, immutable)\n\t\tif not ok then\n\t\t\twarn(\"[BrainrotSaleSystem] Observer failed: \" .. tostring(observerFailure))\n\t\tend\n\tend\nend\n\nfunction BrainrotSaleSystem.SubscribeCommitted(callback: (Player, any) -> ()): any\n\tlocal connection = {}\n\tcommittedListeners[connection] = callback\n\tfunction connection.Disconnect()\n\t\tcommittedListeners[connection] = nil\n\tend\n\treturn connection\nend\n\nlocal function failure(code: string): any\n\treturn { ok = false, code = code }\nend\n\nlocal function disconnectList(list: { any })\n\tfor _, connection in list do\n\t\tconnection:Disconnect()\n\tend\n\ttable.clear(list)\nend\n\nlocal function disconnectAll()\n\tdisconnectList(connections)\n\tfor player, list in playerConnections do\n\t\tdisconnectList(list)\n\t\tplayerConnections[player] = nil\n\tend\nend\n\nlocal function now(): number\n\tlocal deps = dependencies :: Dependencies\n\treturn if deps.Now then deps.Now() else Workspace:GetServerTimeNow()\nend\n\nlocal function resolveConfiguredSalePoint(): BasePart?\n\tlocal map = Workspace:FindFirstChild(\"MapBlockout\")\n\tlocal patches = if map then map:FindFirstChild(\"ServiceStallPatches\") else nil\n\tlocal sellStall = if patches then patches:FindFirstChild(\"SellStall\") else nil\n\treturn if sellStall and sellStall:IsA(\"BasePart\") then sellStall else nil\nend\n\nlocal function getSalePoint(): BasePart?\n\tlocal deps = dependencies :: Dependencies\n\tlocal point = if deps.ResolveSalePoint\n\t\tthen deps.ResolveSalePoint()\n\t\telse resolveConfiguredSalePoint()\n\treturn if point and point:IsDescendantOf(Workspace) then point else nil\nend\n\nlocal function finitePosition(position: Vector3): boolean\n\treturn position.X == position.X\n\t\tand math.abs(position.X) < math.huge\n\t\tand position.Y == position.Y\n\t\tand math.abs(position.Y) < math.huge\n\t\tand position.Z == position.Z\n\t\tand math.abs(position.Z) < math.huge\nend\n\nlocal function resolvePlayerContext(player: Player): (any?, string?)\n\tlocal deps = dependencies :: Dependencies\n\tif player.Parent ~= Players or not deps.Currency:IsReady(player) then\n\t\treturn nil, \"InvalidSession\"\n\tend\n\tlocal character = player.Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tif\n\t\tnot character\n\t\tor not character:IsDescendantOf(Workspace)\n\t\tor not humanoid\n\t\tor humanoid.Health <= 0\n\t\tor not root\n\t\tor not root:IsA(\"BasePart\")\n\t\tor not finitePosition(root.Position)\n\tthen\n\t\treturn nil, \"InvalidSession\"\n\tend\n\treturn { Character = character, Root = root }, nil\nend\n\nlocal function resolveCarriedForContext(player: Player, context: any): (any?, string?)\n\tlocal deps = dependencies :: Dependencies\n\tlocal state = deps.Carry.GetCarriedState(player)\n\tif state == nil or state.Record == nil then\n\t\treturn nil, \"NothingCarried\"\n\tend\n\tif state.CarrierUserId ~= player.UserId then\n\t\treturn nil, \"NotOwner\"\n\tend\n\tif state.Character ~= context.Character or state.Root ~= context.Root then\n\t\treturn nil, \"NothingCarried\"\n\tend\n\tif state.Busy or state.Returning then\n\t\treturn nil, \"Busy\"\n\tend\n\tlocal record = state.Record\n\tif type(record.ItemId) ~= \"string\" or record.ItemId == \"\" then\n\t\treturn nil, \"NothingCarried\"\n\tend\n\tif type(record.BrainrotId) ~= \"string\" or record.BrainrotId == \"\" then\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\treturn {\n\t\tRecord = record,\n\t\tIndividualId = record.ItemId,\n\t\tCatalogueId = record.BrainrotId,\n\t\tCarrierUserId = state.CarrierUserId,\n\t},\n\t\tnil\nend\n\nlocal function resolveEligibleCarriedBrainrot(player: Player): (any?, string?)\n\tlocal context, reason = resolvePlayerContext(player)\n\tif not context then\n\t\treturn nil, reason\n\tend\n\tlocal carried, carriedReason = resolveCarriedForContext(player, context)\n\tif not carried then\n\t\treturn nil, carriedReason\n\tend\n\tcarried.Context = context\n\treturn carried, nil\nend\n\nlocal function warnInvalidCatalogue(catalogueId: any, reason: string)\n\tlocal key = tostring(catalogueId)\n\tif warnedInvalidCatalogueIds[key] then\n\t\treturn\n\tend\n\twarnedInvalidCatalogueIds[key] = true\n\twarn(\"[BrainrotSaleSystem] Invalid sale catalogue \" .. key .. \": \" .. reason)\nend\n\nlocal function resolveCatalogueSaleData(carriedRecord: any): (any?, string?)\n\tlocal deps = dependencies :: Dependencies\n\tlocal definition, reason = deps.Catalog.GetDefinition(carriedRecord.BrainrotId)\n\tif not definition then\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, tostring(reason or \"missing definition\"))\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\tlocal displayName = definition.displayName\n\tlocal rank = definition.tier\n\tlocal sellValue = definition.sellValue\n\tif type(displayName) ~= \"string\" or not displayName:match(\"%S\") then\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, \"missing display name\")\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\tif type(rank) ~= \"string\" or not rank:match(\"%S\") then\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, \"missing tier\")\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\tif\n\t\ttype(sellValue) ~= \"number\"\n\t\tor sellValue ~= sellValue\n\t\tor math.abs(sellValue) == math.huge\n\t\tor sellValue < 0\n\t\tor sellValue % 1 ~= 0\n\tthen\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, \"invalid non-negative integer sellValue\")\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\treturn {\n\t\tDisplayName = displayName,\n\t\tRank = rank,\n\t\tSellValue = sellValue,\n\t}, nil\nend\n\nlocal function isPlayerWithinSaleRange(context: any): boolean\n\tlocal salePoint = getSalePoint()\n\tif not salePoint then\n\t\treturn false\n\tend\n\tlocal localPosition = salePoint.CFrame:PointToObjectSpace(context.Root.Position)\n\tlocal halfSize = salePoint.Size * 0.5\n\tlocal closestLocal = Vector3.new(\n\t\tmath.clamp(localPosition.X, -halfSize.X, halfSize.X),\n\t\tmath.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),\n\t\tmath.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)\n\t)\n\tlocal closestWorld = salePoint.CFrame:PointToWorldSpace(closestLocal)\n\treturn (context.Root.Position - closestWorld).Magnitude\n\t\t<= InteractionConfig.SELL_INTERACTION_DISTANCE\n\t\t\t+ InteractionConfig.SELL_SERVER_DISTANCE_TOLERANCE\nend\n\nlocal function clearSaleSession(player: Player)\n\tpendingSales[player] = nil\nend\n\nfunction BrainrotSaleSystem:Init(deps: Dependencies)\n\tassert(not started, \"Cannot replace BrainrotSaleSystem dependencies after Start\")\n\tassert(deps and deps.Carry and deps.Currency and deps.Catalog, \"Missing sale dependencies\")\n\tdependencies = deps\nend\n\nfunction BrainrotSaleSystem:CancelPendingSale(player: Player, saleSessionId: any?): boolean\n\tlocal session = pendingSales[player]\n\tif session == nil then\n\t\treturn false\n\tend\n\tif saleSessionId ~= nil and saleSessionId ~= session.SessionId then\n\t\treturn false\n\tend\n\tif saleInProgress[player] then\n\t\treturn false\n\tend\n\tclearSaleSession(player)\n\treturn true\nend\n\nfunction BrainrotSaleSystem:CreatePreview(player: Player): (any?, string?)\n\tclearSaleSession(player)\n\tif not dependencies then\n\t\treturn nil, \"InvalidSession\"\n\tend\n\tlocal carried, reason = resolveEligibleCarriedBrainrot(player)\n\tif not carried then\n\t\treturn nil, reason\n\tend\n\tif not isPlayerWithinSaleRange(carried.Context) then\n\t\treturn nil, \"TooFarAway\"\n\tend\n\tlocal saleData\n\tsaleData, reason = resolveCatalogueSaleData(carried.Record)\n\tif not saleData then\n\t\treturn nil, reason\n\tend\n\tlocal deps = dependencies :: Dependencies\n\tlocal createdAt = now()\n\tlocal sessionId = if deps.GenerateSessionId\n\t\tthen deps.GenerateSessionId()\n\t\telse HttpService:GenerateGUID(false)\n\tlocal session: SaleSession = {\n\t\tSessionId = sessionId,\n\t\tIndividualId = carried.IndividualId,\n\t\tCatalogueId = carried.CatalogueId,\n\t\tDisplayName = saleData.DisplayName,\n\t\tRank = saleData.Rank,\n\t\tSellValue = saleData.SellValue,\n\t\tCreatedAt = createdAt,\n\t}\n\tpendingSales[player] = session\n\tlocal preview = {\n\t\tSaleSessionId = session.SessionId,\n\t\tRuntimeBrainrotId = session.IndividualId,\n\t\tSpeciesId = session.CatalogueId,\n\t\tDisplayName = session.DisplayName,\n\t\tRarity = session.Rank,\n\t\tRank = session.Rank,\n\t\tSellValue = session.SellValue,\n\t\tExpiresAtServerTime = session.CreatedAt + PREVIEW_LIFETIME_SECONDS,\n\t\tTrainAvailable = false,\n\t\tMutationAvailable = false,\n\t}\n\tif openRemote then\n\t\topenRemote:FireClient(player, preview)\n\tend\n\treturn preview, nil\nend\n\nlocal function matchesPreview(session: SaleSession, carried: any, saleData: any): boolean\n\treturn carried.IndividualId == session.IndividualId\n\t\tand carried.CatalogueId == session.CatalogueId\n\t\tand saleData.DisplayName == session.DisplayName\n\t\tand saleData.Rank == session.Rank\n\t\tand saleData.SellValue == session.SellValue\nend\n\nfunction BrainrotSaleSystem:ConfirmSale(player: Player, saleSessionId: any): any\n\tif not dependencies then\n\t\treturn failure(\"InvalidSession\")\n\tend\n\tif type(saleSessionId) ~= \"string\" or saleSessionId == \"\" then\n\t\treturn failure(\"InvalidSession\")\n\tend\n\tlocal session = pendingSales[player]\n\tif not session or session.SessionId ~= saleSessionId then\n\t\treturn failure(\"InvalidSession\")\n\tend\n\tif now() - session.CreatedAt >= PREVIEW_LIFETIME_SECONDS then\n\t\tclearSaleSession(player)\n\t\treturn failure(\"PreviewExpired\")\n\tend\n\tif saleInProgress[player] then\n\t\treturn failure(\"Busy\")\n\tend\n\tlocal context, reason = resolvePlayerContext(player)\n\tif not context then\n\t\treturn failure(reason or \"InvalidSession\")\n\tend\n\tif not isPlayerWithinSaleRange(context) then\n\t\treturn failure(\"TooFarAway\")\n\tend\n\tlocal carried\n\tcarried, reason = resolveCarriedForContext(player, context)\n\tif not carried then\n\t\treturn failure(reason or \"NothingCarried\")\n\tend\n\tif carried.IndividualId ~= session.IndividualId then\n\t\treturn failure(\"NothingCarried\")\n\tend\n\tif carried.CatalogueId ~= session.CatalogueId then\n\t\treturn failure(\"PreviewChanged\")\n\tend\n\tlocal saleData\n\tsaleData, reason = resolveCatalogueSaleData(carried.Record)\n\tif not saleData then\n\t\treturn failure(reason or \"InvalidCatalogue\")\n\tend\n\tif not matchesPreview(session, carried, saleData) then\n\t\tclearSaleSession(player)\n\t\treturn failure(\"PreviewChanged\")\n\tend\n\n\tsaleInProgress[player] = true\n\tlocal result = failure(\"ConsumeFailed\")\n\tlocal committedAward: any = nil\n\tlocal ok, caught = xpcall(function()\n\t\t-- Lock first, then repeat current-character, distance, exact individual,\n\t\t-- ownership and catalogue checks before entering the non-yielding commit.\n\t\tlocal lockedContext, lockedReason = resolvePlayerContext(player)\n\t\tif not lockedContext then\n\t\t\tresult = failure(lockedReason or \"InvalidSession\")\n\t\t\treturn\n\t\tend\n\t\tif not isPlayerWithinSaleRange(lockedContext) then\n\t\t\tresult = failure(\"TooFarAway\")\n\t\t\treturn\n\t\tend\n\t\tlocal lockedCarried\n\t\tlockedCarried, lockedReason = resolveCarriedForContext(player, lockedContext)\n\t\tif not lockedCarried then\n\t\t\tresult = failure(lockedReason or \"NothingCarried\")\n\t\t\treturn\n\t\tend\n\t\tlocal lockedData\n\t\tlockedData, lockedReason = resolveCatalogueSaleData(lockedCarried.Record)\n\t\tif not lockedData then\n\t\t\tresult = failure(lockedReason or \"InvalidCatalogue\")\n\t\t\treturn\n\t\tend\n\t\tif not matchesPreview(session, lockedCarried, lockedData) then\n\t\t\tclearSaleSession(player)\n\t\t\tresult = failure(\"PreviewChanged\")\n\t\t\treturn\n\t\tend\n\n\t\tlocal awardFailed = false\n\t\tlocal consumed, consumeReason = (dependencies :: Dependencies).Carry.ConsumeCarriedBrainrot(\n\t\t\tplayer,\n\t\t\tsession.IndividualId,\n\t\t\t\"BrainrotSale\",\n\t\t\tfunction(record)\n\t\t\t\tif\n\t\t\t\t\trecord ~= lockedCarried.Record\n\t\t\t\t\tor record.ItemId ~= session.IndividualId\n\t\t\t\t\tor record.BrainrotId ~= session.CatalogueId\n\t\t\t\tthen\n\t\t\t\t\treturn false, \"SOURCE_CHANGED\"\n\t\t\t\tend\n\t\t\t\tlocal deps = dependencies :: Dependencies\n\t\t\t\tlocal called, award\n\t\t\t\tif deps.Banked then\n\t\t\t\t\tcalled, award = pcall(\n\t\t\t\t\t\tdeps.Banked.TryCommitSale,\n\t\t\t\t\t\tdeps.Banked,\n\t\t\t\t\t\tplayer,\n\t\t\t\t\t\trecord,\n\t\t\t\t\t\tlockedData.SellValue\n\t\t\t\t\t)\n\t\t\t\telseif lockedData.SellValue == 0 then\n\t\t\t\t\treturn true, nil\n\t\t\t\telse\n\t\t\t\t\tcalled, award = pcall(\n\t\t\t\t\t\tdeps.Currency.AddCash,\n\t\t\t\t\t\tdeps.Currency,\n\t\t\t\t\t\tplayer,\n\t\t\t\t\t\tlockedData.SellValue,\n\t\t\t\t\t\t\"BrainrotSale\"\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\t\tif not called or type(award) ~= \"table\" or award.committed ~= true then\n\t\t\t\t\tawardFailed = true\n\t\t\t\t\treturn false, \"AWARD_FAILED\"\n\t\t\t\tend\n\t\t\t\tcommittedAward = award\n\t\t\t\treturn true, nil\n\t\t\tend\n\t\t)\n\t\tif not consumed then\n\t\t\tresult = failure(if awardFailed then \"AwardFailed\" else \"ConsumeFailed\")\n\t\t\tif consumeReason == \"BUSY\" then\n\t\t\t\tresult = failure(\"Busy\")\n\t\t\tend\n\t\t\treturn\n\t\tend\n\t\tclearSaleSession(player)\n\t\tlocal currency = (dependencies :: Dependencies).Currency\n\t\tif currency.SyncBalance then\n\t\t\tpcall(currency.SyncBalance, currency, player)\n\t\tend\n\t\tresult = {\n\t\t\tok = true,\n\t\t\tcode = \"Sold\",\n\t\t\tDisplayName = lockedData.DisplayName,\n\t\t\tPaid = lockedData.SellValue,\n\t\t}\n\t\tif committedAward and type(committedAward.revision) == \"number\" then\n\t\t\tlocal committedAt = now()\n\t\t\tnotifyCommitted(player, {\n\t\t\t\tkind = \"BrainrotSold\",\n\t\t\t\teventId = \"sale:\" .. session.SessionId,\n\t\t\t\tat = committedAt,\n\t\t\t\tindividualId = session.IndividualId,\n\t\t\t\tspeciesId = session.CatalogueId,\n\t\t\t\tamount = lockedData.SellValue,\n\t\t\t\trevision = committedAward.revision,\n\t\t\t})\n\t\tend\n\tend, debug.traceback)\n\tsaleInProgress[player] = nil\n\tif not ok then\n\t\twarn(\"[BrainrotSaleSystem] Transaction error: \" .. tostring(caught))\n\t\treturn failure(\"AwardFailed\")\n\tend\n\treturn result\nend\n\nlocal function ensureRemote(className: string, remoteName: string): Instance\n\tlocal remotes = ReplicatedStorage:FindFirstChild(\"Remotes\")\n\tif not remotes then\n\t\tremotes = Instance.new(\"Folder\")\n\t\tremotes.Name, remotes.Parent = \"Remotes\", ReplicatedStorage\n\tend\n\tlocal remote = remotes:FindFirstChild(remoteName)\n\tif not remote then\n\t\tremote = Instance.new(className)\n\t\tremote.Name, remote.Parent = remoteName, remotes\n\tend\n\tassert(remote.ClassName == className, remoteName .. \" must be a \" .. className)\n\treturn remote\nend\n\nlocal function bindPlayer(player: Player)\n\tif playerConnections[player] then\n\t\treturn\n\tend\n\tlocal list = {}\n\tplayerConnections[player] = list\n\ttable.insert(\n\t\tlist,\n\t\tplayer.CharacterAdded:Connect(function()\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\tend)\n\t)\n\ttable.insert(\n\t\tlist,\n\t\tplayer.CharacterRemoving:Connect(function()\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\tend)\n\t)\nend\n\nfunction BrainrotSaleSystem:Start()\n\tif started then\n\t\treturn\n\tend\n\tassert(dependencies, \"BrainrotSaleSystem:Init must run before Start\")\n\tstarted = true\n\topenRemote = ensureRemote(\"RemoteEvent\", RemoteNames.OpenBrainrotSaleDialog) :: RemoteEvent\n\tconfirmRemote =\n\t\tensureRemote(\"RemoteFunction\", RemoteNames.ConfirmBrainrotSale) :: RemoteFunction\n\tcancelRemote = ensureRemote(\"RemoteEvent\", RemoteNames.CancelBrainrotSale) :: RemoteEvent\n\tconfirmHandler = function(player, saleSessionId)\n\t\treturn BrainrotSaleSystem:ConfirmSale(player, saleSessionId)\n\tend\n\tconfirmRemote.OnServerInvoke = confirmHandler\n\ttable.insert(\n\t\tconnections,\n\t\t(cancelRemote :: RemoteEvent).OnServerEvent:Connect(function(player, saleSessionId)\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player, saleSessionId)\n\t\tend)\n\t)\n\tfor _, player in Players:GetPlayers() do\n\t\tbindPlayer(player)\n\tend\n\ttable.insert(connections, Players.PlayerAdded:Connect(bindPlayer))\n\ttable.insert(\n\t\tconnections,\n\t\tPlayers.PlayerRemoving:Connect(function(player)\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\t\tlocal list = playerConnections[player]\n\t\t\tif list then\n\t\t\t\tdisconnectList(list)\n\t\t\t\tplayerConnections[player] = nil\n\t\t\tend\n\t\tend)\n\t)\n\tlocal sessionClosingSignal = (dependencies :: Dependencies).SessionClosingSignal\n\tif sessionClosingSignal then\n\t\ttable.insert(\n\t\t\tconnections,\n\t\t\tsessionClosingSignal(function(player)\n\t\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\t\tend)\n\t\t)\n\tend\n\tlocal baseReleasingSignal = (dependencies :: Dependencies).BaseReleasingSignal\n\tif baseReleasingSignal then\n\t\ttable.insert(\n\t\t\tconnections,\n\t\t\tbaseReleasingSignal(function(player)\n\t\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\t\tend)\n\t\t)\n\tend\nend\n\nfunction BrainrotSaleSystem:Stop()\n\tif confirmRemote and confirmRemote.OnServerInvoke == confirmHandler then\n\t\tconfirmRemote.OnServerInvoke = nil\n\tend\n\tdisconnectAll()\n\ttable.clear(pendingSales)\n\ttable.clear(saleInProgress)\n\ttable.clear(warnedInvalidCatalogueIds)\n\topenRemote, confirmRemote, cancelRemote, confirmHandler = nil, nil, nil, nil\n\tstarted = false\n\tdependencies = nil\nend\n\nreturn BrainrotSaleSystem\n","afterSource":"--!strict\n\nlocal Players = game:GetService(\"Players\")\nlocal HttpService = game:GetService(\"HttpService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal InteractionConfig = require(ReplicatedStorage.Shared.Config.BrainrotInteraction)\nlocal CompactMapGeometry = require(ReplicatedStorage.Shared.Utility.CompactMapGeometry)\nlocal RemoteNames = require(ReplicatedStorage.Shared.Constants.RemoteNames)\nlocal PlayerDataService = require(script.Parent.Parent.Services.PlayerDataService)\n\nlocal PREVIEW_LIFETIME_SECONDS = 20\n\ntype Dependencies = {\n\tCarry: any,\n\tCurrency: any,\n\tCatalog: any,\n\tBanked: any?,\n\tResolveSalePoint: (() -> BasePart?)?,\n\tNow: (() -> number)?,\n\tGenerateSessionId: (() -> string)?,\n\tSessionClosingSignal: any?,\n\tBaseReleasingSignal: any?,\n}\n\ntype SaleSession = {\n\tSessionId: string,\n\tIndividualId: string,\n\tCatalogueId: string,\n\tDisplayName: string,\n\tRank: string,\n\tSellValue: number,\n\tCreatedAt: number,\n}\n\nlocal BrainrotSaleSystem = {}\nlocal dependencies: Dependencies? = nil\nlocal started = false\nlocal pendingSales: { [Player]: SaleSession } = {}\nlocal saleInProgress: { [Player]: boolean } = {}\nlocal warnedInvalidCatalogueIds: { [string]: boolean } = {}\nlocal connections: { any } = {}\nlocal playerConnections: { [Player]: { RBXScriptConnection } } = {}\nlocal openRemote: RemoteEvent? = nil\nlocal confirmRemote: RemoteFunction? = nil\nlocal cancelRemote: RemoteEvent? = nil\nlocal confirmHandler: ((Player, any) -> any)? = nil\nlocal committedListeners: { [any]: (Player, any) -> () } = {}\nlocal committedSequence = 0\n\nlocal function notifyCommitted(player: Player, receipt: any)\n\tcommittedSequence += 1\n\tlocal session = PlayerDataService:GetSessionHandle(player)\n\treceipt.sessionGeneration = if session then session.Generation else nil\n\treceipt.stream = \"Sale\"\n\treceipt.operationSequence = committedSequence\n\tlocal immutable = table.freeze(receipt)\n\tfor _, callback in committedListeners do\n\t\tlocal ok, observerFailure = pcall(callback, player, immutable)\n\t\tif not ok then\n\t\t\twarn(\"[BrainrotSaleSystem] Observer failed: \" .. tostring(observerFailure))\n\t\tend\n\tend\nend\n\nfunction BrainrotSaleSystem.SubscribeCommitted(callback: (Player, any) -> ()): any\n\tlocal connection = {}\n\tcommittedListeners[connection] = callback\n\tfunction connection.Disconnect()\n\t\tcommittedListeners[connection] = nil\n\tend\n\treturn connection\nend\n\nlocal function failure(code: string): any\n\treturn { ok = false, code = code }\nend\n\nlocal function disconnectList(list: { any })\n\tfor _, connection in list do\n\t\tconnection:Disconnect()\n\tend\n\ttable.clear(list)\nend\n\nlocal function disconnectAll()\n\tdisconnectList(connections)\n\tfor player, list in playerConnections do\n\t\tdisconnectList(list)\n\t\tplayerConnections[player] = nil\n\tend\nend\n\nlocal function now(): number\n\tlocal deps = dependencies :: Dependencies\n\treturn if deps.Now then deps.Now() else Workspace:GetServerTimeNow()\nend\n\nlocal function resolveConfiguredSalePoint(): BasePart?\n\tlocal map = Workspace:FindFirstChild(\"MapBlockout\")\n\tlocal patches = if map then map:FindFirstChild(\"ServiceStallPatches\") else nil\n\tlocal sellStall = if patches then patches:FindFirstChild(\"SellStall\") else nil\n\treturn if sellStall and sellStall:IsA(\"BasePart\") then sellStall else nil\nend\n\nlocal function getSalePoint(): BasePart?\n\tlocal deps = dependencies :: Dependencies\n\tlocal point = if deps.ResolveSalePoint\n\t\tthen deps.ResolveSalePoint()\n\t\telse resolveConfiguredSalePoint()\n\treturn if point and point:IsDescendantOf(Workspace) then point else nil\nend\n\nlocal function finitePosition(position: Vector3): boolean\n\treturn position.X == position.X\n\t\tand math.abs(position.X) < math.huge\n\t\tand position.Y == position.Y\n\t\tand math.abs(position.Y) < math.huge\n\t\tand position.Z == position.Z\n\t\tand math.abs(position.Z) < math.huge\nend\n\nlocal function resolvePlayerContext(player: Player): (any?, string?)\n\tlocal deps = dependencies :: Dependencies\n\tif player.Parent ~= Players or not deps.Currency:IsReady(player) then\n\t\treturn nil, \"InvalidSession\"\n\tend\n\tlocal character = player.Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tif\n\t\tnot character\n\t\tor not character:IsDescendantOf(Workspace)\n\t\tor not humanoid\n\t\tor humanoid.Health <= 0\n\t\tor not root\n\t\tor not root:IsA(\"BasePart\")\n\t\tor not finitePosition(root.Position)\n\tthen\n\t\treturn nil, \"InvalidSession\"\n\tend\n\treturn { Character = character, Root = root }, nil\nend\n\nlocal function resolveCarriedForContext(player: Player, context: any): (any?, string?)\n\tlocal deps = dependencies :: Dependencies\n\tlocal state = deps.Carry.GetCarriedState(player)\n\tif state == nil or state.Record == nil then\n\t\treturn nil, \"NothingCarried\"\n\tend\n\tif state.CarrierUserId ~= player.UserId then\n\t\treturn nil, \"NotOwner\"\n\tend\n\tif state.Character ~= context.Character or state.Root ~= context.Root then\n\t\treturn nil, \"NothingCarried\"\n\tend\n\tif state.Busy or state.Returning then\n\t\treturn nil, \"Busy\"\n\tend\n\tlocal record = state.Record\n\tif type(record.ItemId) ~= \"string\" or record.ItemId == \"\" then\n\t\treturn nil, \"NothingCarried\"\n\tend\n\tif type(record.BrainrotId) ~= \"string\" or record.BrainrotId == \"\" then\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\treturn {\n\t\tRecord = record,\n\t\tIndividualId = record.ItemId,\n\t\tCatalogueId = record.BrainrotId,\n\t\tCarrierUserId = state.CarrierUserId,\n\t},\n\t\tnil\nend\n\nlocal function resolveEligibleCarriedBrainrot(player: Player): (any?, string?)\n\tlocal context, reason = resolvePlayerContext(player)\n\tif not context then\n\t\treturn nil, reason\n\tend\n\tlocal carried, carriedReason = resolveCarriedForContext(player, context)\n\tif not carried then\n\t\treturn nil, carriedReason\n\tend\n\tcarried.Context = context\n\treturn carried, nil\nend\n\nlocal function warnInvalidCatalogue(catalogueId: any, reason: string)\n\tlocal key = tostring(catalogueId)\n\tif warnedInvalidCatalogueIds[key] then\n\t\treturn\n\tend\n\twarnedInvalidCatalogueIds[key] = true\n\twarn(\"[BrainrotSaleSystem] Invalid sale catalogue \" .. key .. \": \" .. reason)\nend\n\nlocal function resolveCatalogueSaleData(carriedRecord: any): (any?, string?)\n\tlocal deps = dependencies :: Dependencies\n\tlocal definition, reason = deps.Catalog.GetDefinition(carriedRecord.BrainrotId)\n\tif not definition then\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, tostring(reason or \"missing definition\"))\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\tlocal displayName = definition.displayName\n\tlocal rank = definition.tier\n\tlocal sellValue = definition.sellValue\n\tif type(displayName) ~= \"string\" or not displayName:match(\"%S\") then\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, \"missing display name\")\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\tif type(rank) ~= \"string\" or not rank:match(\"%S\") then\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, \"missing tier\")\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\tif\n\t\ttype(sellValue) ~= \"number\"\n\t\tor sellValue ~= sellValue\n\t\tor math.abs(sellValue) == math.huge\n\t\tor sellValue < 0\n\t\tor sellValue % 1 ~= 0\n\tthen\n\t\twarnInvalidCatalogue(carriedRecord.BrainrotId, \"invalid non-negative integer sellValue\")\n\t\treturn nil, \"InvalidCatalogue\"\n\tend\n\treturn {\n\t\tDisplayName = displayName,\n\t\tRank = rank,\n\t\tSellValue = sellValue,\n\t}, nil\nend\n\nlocal function isPlayerWithinSaleRange(context: any): boolean\n\tlocal salePoint = getSalePoint()\n\tif not salePoint then\n\t\treturn false\n\tend\n\tlocal localPosition = salePoint.CFrame:PointToObjectSpace(context.Root.Position)\n\tlocal halfSize = CompactMapGeometry.ResolveInteractionSize(salePoint) * 0.5\n\tlocal closestLocal = Vector3.new(\n\t\tmath.clamp(localPosition.X, -halfSize.X, halfSize.X),\n\t\tmath.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),\n\t\tmath.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)\n\t)\n\tlocal closestWorld = salePoint.CFrame:PointToWorldSpace(closestLocal)\n\treturn (context.Root.Position - closestWorld).Magnitude\n\t\t<= InteractionConfig.SELL_INTERACTION_DISTANCE\n\t\t\t+ InteractionConfig.SELL_SERVER_DISTANCE_TOLERANCE\nend\n\nlocal function clearSaleSession(player: Player)\n\tpendingSales[player] = nil\nend\n\nfunction BrainrotSaleSystem:Init(deps: Dependencies)\n\tassert(not started, \"Cannot replace BrainrotSaleSystem dependencies after Start\")\n\tassert(deps and deps.Carry and deps.Currency and deps.Catalog, \"Missing sale dependencies\")\n\tdependencies = deps\nend\n\nfunction BrainrotSaleSystem:CancelPendingSale(player: Player, saleSessionId: any?): boolean\n\tlocal session = pendingSales[player]\n\tif session == nil then\n\t\treturn false\n\tend\n\tif saleSessionId ~= nil and saleSessionId ~= session.SessionId then\n\t\treturn false\n\tend\n\tif saleInProgress[player] then\n\t\treturn false\n\tend\n\tclearSaleSession(player)\n\treturn true\nend\n\nfunction BrainrotSaleSystem:CreatePreview(player: Player): (any?, string?)\n\tclearSaleSession(player)\n\tif not dependencies then\n\t\treturn nil, \"InvalidSession\"\n\tend\n\tlocal carried, reason = resolveEligibleCarriedBrainrot(player)\n\tif not carried then\n\t\treturn nil, reason\n\tend\n\tif not isPlayerWithinSaleRange(carried.Context) then\n\t\treturn nil, \"TooFarAway\"\n\tend\n\tlocal saleData\n\tsaleData, reason = resolveCatalogueSaleData(carried.Record)\n\tif not saleData then\n\t\treturn nil, reason\n\tend\n\tlocal deps = dependencies :: Dependencies\n\tlocal createdAt = now()\n\tlocal sessionId = if deps.GenerateSessionId\n\t\tthen deps.GenerateSessionId()\n\t\telse HttpService:GenerateGUID(false)\n\tlocal session: SaleSession = {\n\t\tSessionId = sessionId,\n\t\tIndividualId = carried.IndividualId,\n\t\tCatalogueId = carried.CatalogueId,\n\t\tDisplayName = saleData.DisplayName,\n\t\tRank = saleData.Rank,\n\t\tSellValue = saleData.SellValue,\n\t\tCreatedAt = createdAt,\n\t}\n\tpendingSales[player] = session\n\tlocal preview = {\n\t\tSaleSessionId = session.SessionId,\n\t\tRuntimeBrainrotId = session.IndividualId,\n\t\tSpeciesId = session.CatalogueId,\n\t\tDisplayName = session.DisplayName,\n\t\tRarity = session.Rank,\n\t\tRank = session.Rank,\n\t\tSellValue = session.SellValue,\n\t\tExpiresAtServerTime = session.CreatedAt + PREVIEW_LIFETIME_SECONDS,\n\t\tTrainAvailable = false,\n\t\tMutationAvailable = false,\n\t}\n\tif openRemote then\n\t\topenRemote:FireClient(player, preview)\n\tend\n\treturn preview, nil\nend\n\nlocal function matchesPreview(session: SaleSession, carried: any, saleData: any): boolean\n\treturn carried.IndividualId == session.IndividualId\n\t\tand carried.CatalogueId == session.CatalogueId\n\t\tand saleData.DisplayName == session.DisplayName\n\t\tand saleData.Rank == session.Rank\n\t\tand saleData.SellValue == session.SellValue\nend\n\nfunction BrainrotSaleSystem:ConfirmSale(player: Player, saleSessionId: any): any\n\tif not dependencies then\n\t\treturn failure(\"InvalidSession\")\n\tend\n\tif type(saleSessionId) ~= \"string\" or saleSessionId == \"\" then\n\t\treturn failure(\"InvalidSession\")\n\tend\n\tlocal session = pendingSales[player]\n\tif not session or session.SessionId ~= saleSessionId then\n\t\treturn failure(\"InvalidSession\")\n\tend\n\tif now() - session.CreatedAt >= PREVIEW_LIFETIME_SECONDS then\n\t\tclearSaleSession(player)\n\t\treturn failure(\"PreviewExpired\")\n\tend\n\tif saleInProgress[player] then\n\t\treturn failure(\"Busy\")\n\tend\n\tlocal context, reason = resolvePlayerContext(player)\n\tif not context then\n\t\treturn failure(reason or \"InvalidSession\")\n\tend\n\tif not isPlayerWithinSaleRange(context) then\n\t\treturn failure(\"TooFarAway\")\n\tend\n\tlocal carried\n\tcarried, reason = resolveCarriedForContext(player, context)\n\tif not carried then\n\t\treturn failure(reason or \"NothingCarried\")\n\tend\n\tif carried.IndividualId ~= session.IndividualId then\n\t\treturn failure(\"NothingCarried\")\n\tend\n\tif carried.CatalogueId ~= session.CatalogueId then\n\t\treturn failure(\"PreviewChanged\")\n\tend\n\tlocal saleData\n\tsaleData, reason = resolveCatalogueSaleData(carried.Record)\n\tif not saleData then\n\t\treturn failure(reason or \"InvalidCatalogue\")\n\tend\n\tif not matchesPreview(session, carried, saleData) then\n\t\tclearSaleSession(player)\n\t\treturn failure(\"PreviewChanged\")\n\tend\n\n\tsaleInProgress[player] = true\n\tlocal result = failure(\"ConsumeFailed\")\n\tlocal committedAward: any = nil\n\tlocal ok, caught = xpcall(function()\n\t\t-- Lock first, then repeat current-character, distance, exact individual,\n\t\t-- ownership and catalogue checks before entering the non-yielding commit.\n\t\tlocal lockedContext, lockedReason = resolvePlayerContext(player)\n\t\tif not lockedContext then\n\t\t\tresult = failure(lockedReason or \"InvalidSession\")\n\t\t\treturn\n\t\tend\n\t\tif not isPlayerWithinSaleRange(lockedContext) then\n\t\t\tresult = failure(\"TooFarAway\")\n\t\t\treturn\n\t\tend\n\t\tlocal lockedCarried\n\t\tlockedCarried, lockedReason = resolveCarriedForContext(player, lockedContext)\n\t\tif not lockedCarried then\n\t\t\tresult = failure(lockedReason or \"NothingCarried\")\n\t\t\treturn\n\t\tend\n\t\tlocal lockedData\n\t\tlockedData, lockedReason = resolveCatalogueSaleData(lockedCarried.Record)\n\t\tif not lockedData then\n\t\t\tresult = failure(lockedReason or \"InvalidCatalogue\")\n\t\t\treturn\n\t\tend\n\t\tif not matchesPreview(session, lockedCarried, lockedData) then\n\t\t\tclearSaleSession(player)\n\t\t\tresult = failure(\"PreviewChanged\")\n\t\t\treturn\n\t\tend\n\n\t\tlocal awardFailed = false\n\t\tlocal consumed, consumeReason = (dependencies :: Dependencies).Carry.ConsumeCarriedBrainrot(\n\t\t\tplayer,\n\t\t\tsession.IndividualId,\n\t\t\t\"BrainrotSale\",\n\t\t\tfunction(record)\n\t\t\t\tif\n\t\t\t\t\trecord ~= lockedCarried.Record\n\t\t\t\t\tor record.ItemId ~= session.IndividualId\n\t\t\t\t\tor record.BrainrotId ~= session.CatalogueId\n\t\t\t\tthen\n\t\t\t\t\treturn false, \"SOURCE_CHANGED\"\n\t\t\t\tend\n\t\t\t\tlocal deps = dependencies :: Dependencies\n\t\t\t\tlocal called, award\n\t\t\t\tif deps.Banked then\n\t\t\t\t\tcalled, award = pcall(\n\t\t\t\t\t\tdeps.Banked.TryCommitSale,\n\t\t\t\t\t\tdeps.Banked,\n\t\t\t\t\t\tplayer,\n\t\t\t\t\t\trecord,\n\t\t\t\t\t\tlockedData.SellValue\n\t\t\t\t\t)\n\t\t\t\telseif lockedData.SellValue == 0 then\n\t\t\t\t\treturn true, nil\n\t\t\t\telse\n\t\t\t\t\tcalled, award = pcall(\n\t\t\t\t\t\tdeps.Currency.AddCash,\n\t\t\t\t\t\tdeps.Currency,\n\t\t\t\t\t\tplayer,\n\t\t\t\t\t\tlockedData.SellValue,\n\t\t\t\t\t\t\"BrainrotSale\"\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\t\tif not called or type(award) ~= \"table\" or award.committed ~= true then\n\t\t\t\t\tawardFailed = true\n\t\t\t\t\treturn false, \"AWARD_FAILED\"\n\t\t\t\tend\n\t\t\t\tcommittedAward = award\n\t\t\t\treturn true, nil\n\t\t\tend\n\t\t)\n\t\tif not consumed then\n\t\t\tresult = failure(if awardFailed then \"AwardFailed\" else \"ConsumeFailed\")\n\t\t\tif consumeReason == \"BUSY\" then\n\t\t\t\tresult = failure(\"Busy\")\n\t\t\tend\n\t\t\treturn\n\t\tend\n\t\tclearSaleSession(player)\n\t\tlocal currency = (dependencies :: Dependencies).Currency\n\t\tif currency.SyncBalance then\n\t\t\tpcall(currency.SyncBalance, currency, player)\n\t\tend\n\t\tresult = {\n\t\t\tok = true,\n\t\t\tcode = \"Sold\",\n\t\t\tDisplayName = lockedData.DisplayName,\n\t\t\tPaid = lockedData.SellValue,\n\t\t}\n\t\tif committedAward and type(committedAward.revision) == \"number\" then\n\t\t\tlocal committedAt = now()\n\t\t\tnotifyCommitted(player, {\n\t\t\t\tkind = \"BrainrotSold\",\n\t\t\t\teventId = \"sale:\" .. session.SessionId,\n\t\t\t\tat = committedAt,\n\t\t\t\tindividualId = session.IndividualId,\n\t\t\t\tspeciesId = session.CatalogueId,\n\t\t\t\tamount = lockedData.SellValue,\n\t\t\t\trevision = committedAward.revision,\n\t\t\t})\n\t\tend\n\tend, debug.traceback)\n\tsaleInProgress[player] = nil\n\tif not ok then\n\t\twarn(\"[BrainrotSaleSystem] Transaction error: \" .. tostring(caught))\n\t\treturn failure(\"AwardFailed\")\n\tend\n\treturn result\nend\n\nlocal function ensureRemote(className: string, remoteName: string): Instance\n\tlocal remotes = ReplicatedStorage:FindFirstChild(\"Remotes\")\n\tif not remotes then\n\t\tremotes = Instance.new(\"Folder\")\n\t\tremotes.Name, remotes.Parent = \"Remotes\", ReplicatedStorage\n\tend\n\tlocal remote = remotes:FindFirstChild(remoteName)\n\tif not remote then\n\t\tremote = Instance.new(className)\n\t\tremote.Name, remote.Parent = remoteName, remotes\n\tend\n\tassert(remote.ClassName == className, remoteName .. \" must be a \" .. className)\n\treturn remote\nend\n\nlocal function bindPlayer(player: Player)\n\tif playerConnections[player] then\n\t\treturn\n\tend\n\tlocal list = {}\n\tplayerConnections[player] = list\n\ttable.insert(\n\t\tlist,\n\t\tplayer.CharacterAdded:Connect(function()\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\tend)\n\t)\n\ttable.insert(\n\t\tlist,\n\t\tplayer.CharacterRemoving:Connect(function()\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\tend)\n\t)\nend\n\nfunction BrainrotSaleSystem:Start()\n\tif started then\n\t\treturn\n\tend\n\tassert(dependencies, \"BrainrotSaleSystem:Init must run before Start\")\n\tstarted = true\n\topenRemote = ensureRemote(\"RemoteEvent\", RemoteNames.OpenBrainrotSaleDialog) :: RemoteEvent\n\tconfirmRemote =\n\t\tensureRemote(\"RemoteFunction\", RemoteNames.ConfirmBrainrotSale) :: RemoteFunction\n\tcancelRemote = ensureRemote(\"RemoteEvent\", RemoteNames.CancelBrainrotSale) :: RemoteEvent\n\tconfirmHandler = function(player, saleSessionId)\n\t\treturn BrainrotSaleSystem:ConfirmSale(player, saleSessionId)\n\tend\n\tconfirmRemote.OnServerInvoke = confirmHandler\n\ttable.insert(\n\t\tconnections,\n\t\t(cancelRemote :: RemoteEvent).OnServerEvent:Connect(function(player, saleSessionId)\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player, saleSessionId)\n\t\tend)\n\t)\n\tfor _, player in Players:GetPlayers() do\n\t\tbindPlayer(player)\n\tend\n\ttable.insert(connections, Players.PlayerAdded:Connect(bindPlayer))\n\ttable.insert(\n\t\tconnections,\n\t\tPlayers.PlayerRemoving:Connect(function(player)\n\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\t\tlocal list = playerConnections[player]\n\t\t\tif list then\n\t\t\t\tdisconnectList(list)\n\t\t\t\tplayerConnections[player] = nil\n\t\t\tend\n\t\tend)\n\t)\n\tlocal sessionClosingSignal = (dependencies :: Dependencies).SessionClosingSignal\n\tif sessionClosingSignal then\n\t\ttable.insert(\n\t\t\tconnections,\n\t\t\tsessionClosingSignal(function(player)\n\t\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\t\tend)\n\t\t)\n\tend\n\tlocal baseReleasingSignal = (dependencies :: Dependencies).BaseReleasingSignal\n\tif baseReleasingSignal then\n\t\ttable.insert(\n\t\t\tconnections,\n\t\t\tbaseReleasingSignal(function(player)\n\t\t\t\tBrainrotSaleSystem:CancelPendingSale(player)\n\t\t\tend)\n\t\t)\n\tend\nend\n\nfunction BrainrotSaleSystem:Stop()\n\tif confirmRemote and confirmRemote.OnServerInvoke == confirmHandler then\n\t\tconfirmRemote.OnServerInvoke = nil\n\tend\n\tdisconnectAll()\n\ttable.clear(pendingSales)\n\ttable.clear(saleInProgress)\n\ttable.clear(warnedInvalidCatalogueIds)\n\topenRemote, confirmRemote, cancelRemote, confirmHandler = nil, nil, nil, nil\n\tstarted = false\n\tdependencies = nil\nend\n\nreturn BrainrotSaleSystem\n"},{"path":"ServerScriptService.Server.Services.UpgradeService","beforeSHA256":"87535911505d969f75ed22c30df8bb86439e4b1807f121e632ea965c08beea1b","afterSHA256":"6cfd42011a7e5ffc11a36336f7681bf9a2460f1e26a4fd0ce7418a3ee653b5ba","beforeBytes":32560,"afterBytes":32686,"proposal":"docs/map-compaction/source-patches/proposals/ServerScriptService/Server/Services/UpgradeService.lua","diff":"docs/map-compaction/source-patches/diffs/ServerScriptService/Server/Services/UpgradeService.diff","beforeSource":"--!strict\n\n-- Owns the upgrade-shop context and the one coherent purchase commit. Real\n-- catalogue offers remain fail-closed until their 7B-1 scope, persistence and\n-- effect gates are approved. Tests may inject a private ready offer and\n-- ownership adapter without exposing it through the production catalogue.\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal InteractionConfig = require(ReplicatedStorage.Shared.Config.BrainrotInteraction)\nlocal Upgrades = require(ReplicatedStorage.Shared.Config.Upgrades)\nlocal RemoteNames = require(ReplicatedStorage.Shared.Constants.RemoteNames)\nlocal UpgradeEligibility = require(ReplicatedStorage.Shared.Utility.UpgradeEligibility)\nlocal Logger = require(ReplicatedStorage.Shared.Utility.Logger)\nlocal PlayerDataService = require(script.Parent.PlayerDataService)\nlocal CurrencySystem = require(script.Parent.Parent.Systems.CurrencySystem)\n\nlocal CONTEXT_LIFETIME_SECONDS = 120\nlocal MAX_IDENTIFIER_LENGTH = 128\nlocal REQUEST_CACHE_LIMIT = 64\nlocal REQUEST_CACHE_LIFETIME_SECONDS = 180\nlocal RATE_BURST = 6\nlocal RATE_REFILL_PER_SECOND = 3\n\nlocal UpgradeService = {}\nlocal log = Logger.new(\"UpgradeService\")\nlocal started = false\nlocal dependencies: any = nil\nlocal contexts: { [Player]: any } = {}\nlocal requestCaches: { [Player]: any } = {}\nlocal rateStates: { [Player]: any } = {}\nlocal connections: { any } = {}\nlocal openRemote: RemoteEvent? = nil\nlocal requestRemote: RemoteFunction? = nil\nlocal closeRemote: RemoteEvent? = nil\nlocal updateRemote: RemoteEvent? = nil\nlocal requestHandler: ((Player, any) -> any)? = nil\nlocal purchaseCommittedEvent = Instance.new(\"BindableEvent\")\nlocal observationListeners: { [any]: (Player, any) -> () } = {}\nlocal observationOperationSequence = 0\n\nlocal function notifyObservation(player: Player, receipt: any)\n\tlocal immutable = table.freeze(receipt)\n\tfor _, callback in observationListeners do\n\t\tlocal ok, failureMessage = pcall(callback, player, immutable)\n\t\tif not ok then\n\t\t\tlog:Warn(\n\t\t\t\t\"Upgrade observation listener failed userId=%d: %s\",\n\t\t\t\tplayer.UserId,\n\t\t\t\ttostring(failureMessage)\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function defaultDependencies(): any\n\treturn {\n\t\tProfile = PlayerDataService,\n\t\tCurrency = CurrencySystem,\n\t\tCatalogue = Upgrades,\n\t\tEligibility = UpgradeEligibility,\n\t\tReadiness = {\n\t\t\teffectReadyByOfferId = {},\n\t\t\tpersistenceReadyByScope = {},\n\t\t\tcartAcquisitionByTier = {},\n\t\t\trankProviderOperational = false,\n\t\t},\n\t\tWorldReady = function(_player: Player): boolean\n\t\t\treturn false\n\t\tend,\n\t\tResolveTarget = function(_player: Player, _offer: any): (any?, string?)\n\t\t\treturn nil, nil\n\t\tend,\n\t\tBuildPlayerSnapshot = function(player: Player, data: any, _target: any): any\n\t\t\treturn {\n\t\t\t\tstatus = \"Ready\",\n\t\t\t\tuserId = player.UserId,\n\t\t\t\tbalance = if type(data.Economy) == \"table\" then data.Economy.Balance else nil,\n\t\t\t}\n\t\tend,\n\t\tApplyGrant = function(_data: any, _offer: any, _target: any): (boolean, string?)\n\t\t\treturn false, \"OWNERSHIP_PERSISTENCE_UNAVAILABLE\"\n\t\tend,\n\t\tNow = function(): number\n\t\t\treturn Workspace:GetServerTimeNow()\n\t\tend,\n\t\tGenerateId = function(): string\n\t\t\treturn HttpService:GenerateGUID(false)\n\t\tend,\n\t}\nend\n\nlocal function deps(): any\n\tif dependencies then\n\t\treturn dependencies\n\tend\n\tdependencies = defaultDependencies()\n\treturn dependencies\nend\n\nlocal function failure(code: string, requestId: string?): any\n\treturn {\n\t\tok = false,\n\t\toutcome = \"Rejected\",\n\t\tcode = code,\n\t\trequestId = requestId,\n\t}\nend\n\nlocal function nonEmptyBoundedString(value: any): boolean\n\treturn type(value) == \"string\"\n\t\tand #value > 0\n\t\tand #value <= MAX_IDENTIFIER_LENGTH\n\t\tand value:match(\"%c\") == nil\nend\n\nlocal function finiteNonNegative(value: any): boolean\n\treturn type(value) == \"number\" and value == value and value >= 0 and value < math.huge\nend\n\nlocal function sameSession(left: any, right: any): boolean\n\treturn left ~= nil\n\t\tand right ~= nil\n\t\tand left.Player == right.Player\n\t\tand left.UserId == right.UserId\n\t\tand left.Generation == right.Generation\nend\n\nlocal function sessionIsCurrent(player: Player, handle: any): boolean\n\tlocal profile = deps().Profile\n\treturn profile:IsCurrentSessionHandle(handle)\n\t\tand sameSession(profile:GetSessionHandle(player), handle)\nend\n\nlocal function finitePosition(position: Vector3): boolean\n\treturn position.X == position.X\n\t\tand math.abs(position.X) < math.huge\n\t\tand position.Y == position.Y\n\t\tand math.abs(position.Y) < math.huge\n\t\tand position.Z == position.Z\n\t\tand math.abs(position.Z) < math.huge\nend\n\nlocal function playerRoot(player: Player): BasePart?\n\tlocal character = player.Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tif\n\t\tcharacter == nil\n\t\tor not character:IsDescendantOf(Workspace)\n\t\tor humanoid == nil\n\t\tor humanoid.Health <= 0\n\t\tor root == nil\n\t\tor not root:IsA(\"BasePart\")\n\t\tor not finitePosition(root.Position)\n\tthen\n\t\treturn nil\n\tend\n\treturn root\nend\n\nlocal function withinShopRange(player: Player, shop: BasePart): boolean\n\tlocal custom = deps().WithinShopRange\n\tif custom then\n\t\treturn custom(player, shop)\n\tend\n\tlocal root = playerRoot(player)\n\tif root == nil or not shop:IsDescendantOf(Workspace) then\n\t\treturn false\n\tend\n\tlocal localPosition = shop.CFrame:PointToObjectSpace(root.Position)\n\tlocal halfSize = shop.Size * 0.5\n\tlocal closestLocal = Vector3.new(\n\t\tmath.clamp(localPosition.X, -halfSize.X, halfSize.X),\n\t\tmath.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),\n\t\tmath.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)\n\t)\n\tlocal closest = shop.CFrame:PointToWorldSpace(closestLocal)\n\treturn (root.Position - closest).Magnitude\n\t\t<= InteractionConfig.SELL_INTERACTION_DISTANCE\n\t\t\t+ InteractionConfig.SELL_SERVER_DISTANCE_TOLERANCE\nend\n\nlocal function targetIdentity(target: any): string\n\tif type(target) ~= \"table\" then\n\t\treturn \"none\"\n\tend\n\treturn tostring(target.durableCartId or target.equipmentId or \"none\")\nend\n\nlocal function termSignature(offer: any, target: any): string\n\tlocal grant = if type(offer.grant) == \"table\" then offer.grant else {}\n\tlocal scope = if type(offer.ownershipScope) == \"table\" then offer.ownershipScope else {}\n\treturn table.concat({\n\t\ttostring(offer.id),\n\t\ttostring(offer.price),\n\t\ttostring(offer.currencyId),\n\t\ttostring(grant.kind),\n\t\ttostring(grant.trackId or grant.equipmentId),\n\t\ttostring(grant.level),\n\t\ttostring(scope.kind),\n\t\ttargetIdentity(target),\n\t}, \"|\")\nend\n\n-- Canonicalize only static catalogue terms. This is a measurement identity,\n-- independent of the existing purchase-context validation contract.\nlocal function orderedTerms(value: any): any\n\tif type(value) ~= \"table\" then\n\t\treturn value\n\tend\n\tlocal keys = {}\n\tfor key in value do\n\t\ttable.insert(keys, key)\n\tend\n\ttable.sort(keys, function(left, right)\n\t\treturn tostring(left) < tostring(right)\n\tend)\n\tlocal entries = {}\n\tfor _, key in keys do\n\t\ttable.insert(entries, { key, orderedTerms(value[key]) })\n\tend\n\treturn entries\nend\n\nlocal function measurementTermsVersion(offer: any, target: any): string\n\treturn HttpService:JSONEncode(orderedTerms({\n\t\tid = offer.id,\n\t\tprice = offer.price,\n\t\tcurrencyId = offer.currencyId,\n\t\tgrant = offer.grant,\n\t\townershipScope = offer.ownershipScope,\n\t\tapplicability = offer.applicability,\n\t\trequirements = offer.requirements,\n\t\teffect = offer.effect,\n\t\tdefinitionStatus = offer.definitionStatus,\n\t\treleaseStatus = offer.releaseStatus,\n\t\teffectStatus = offer.effectStatus,\n\t\ttargetKey = targetIdentity(target),\n\t}))\nend\n\nlocal function measurementKey(offer: any, target: any): string\n\treturn tostring(offer.id)\n\t\t.. \"|\"\n\t\t.. targetIdentity(target)\n\t\t.. \"|\"\n\t\t.. measurementTermsVersion(offer, target)\nend\n\nlocal function requestSignature(contextId: string, offerId: string, _target: any): string\n\t-- The opaque context ID already binds the server-resolved scope target. This\n\t-- keeps an exact successful retry readable after its menu context closes.\n\treturn contextId .. \"|\" .. offerId\nend\n\nlocal function pruneRequestCache(player: Player, currentTime: number)\n\tlocal cache = requestCaches[player]\n\tif cache == nil then\n\t\treturn\n\tend\n\twhile #cache.Order > 0 do\n\t\tlocal requestId = cache.Order[1]\n\t\tlocal entry = cache.ById[requestId]\n\t\tif\n\t\t\tentry ~= nil\n\t\t\tand currentTime - entry.CreatedAt <= REQUEST_CACHE_LIFETIME_SECONDS\n\t\t\tand #cache.Order <= REQUEST_CACHE_LIMIT\n\t\tthen\n\t\t\tbreak\n\t\tend\n\t\ttable.remove(cache.Order, 1)\n\t\tcache.ById[requestId] = nil\n\tend\nend\n\nlocal function requestCache(player: Player): any\n\tlocal cache = requestCaches[player]\n\tif cache == nil then\n\t\tcache = { ById = {}, Order = {} }\n\t\trequestCaches[player] = cache\n\tend\n\tpruneRequestCache(player, deps().Now())\n\treturn cache\nend\n\nlocal function rememberResult(\n\tplayer: Player,\n\trequestId: string,\n\tsignature: string,\n\tresult: any,\n\tsession: any\n)\n\tlocal cache = requestCache(player)\n\tif cache.ById[requestId] == nil then\n\t\ttable.insert(cache.Order, requestId)\n\tend\n\tcache.ById[requestId] = {\n\t\tSignature = signature,\n\t\tResult = result,\n\t\tCreatedAt = deps().Now(),\n\t\tSession = session,\n\t}\n\tpruneRequestCache(player, deps().Now())\nend\n\nlocal function cachedResult(player: Player, requestId: string, signature: string): any?\n\tlocal entry = requestCache(player).ById[requestId]\n\tif entry == nil then\n\t\treturn nil\n\tend\n\tif entry.Signature ~= signature then\n\t\treturn failure(\"REQUEST_ID_MISMATCH\", requestId)\n\tend\n\tlocal copy = table.clone(entry.Result)\n\tcopy.duplicate = true\n\treturn copy\nend\n\nlocal function consumeRateToken(player: Player): boolean\n\tlocal currentTime = deps().Now()\n\tlocal state = rateStates[player]\n\tif state == nil then\n\t\tstate = { Tokens = RATE_BURST, LastAt = currentTime }\n\t\trateStates[player] = state\n\tend\n\tlocal elapsed = math.max(0, currentTime - state.LastAt)\n\tstate.LastAt = currentTime\n\tstate.Tokens = math.min(RATE_BURST, state.Tokens + elapsed * RATE_REFILL_PER_SECOND)\n\tif state.Tokens < 1 then\n\t\treturn false\n\tend\n\tstate.Tokens -= 1\n\treturn true\nend\n\nlocal function currentOffer(offerId: string): any?\n\treturn deps().Catalogue.Get(offerId)\nend\n\nlocal function buildEvaluation(player: Player, data: any, offer: any, target: any): (any, any)\n\tlocal snapshot = deps().BuildPlayerSnapshot(player, data, target)\n\tlocal evaluation = deps().Eligibility.EvaluateOffer(offer, snapshot, target, deps().Readiness)\n\treturn evaluation, snapshot\nend\n\nlocal function cardFor(player: Player, data: any, offer: any, target: any): any\n\tlocal evaluation = buildEvaluation(player, data, offer, target)\n\tlocal card = deps().Eligibility.DescribeOffer(offer, evaluation, target)\n\treturn {\n\t\tofferId = card.offerId,\n\t\ttitle = card.title,\n\t\teffectSummary = card.effectSummary,\n\t\townershipSummary = card.ownershipSummary,\n\t\tprice = card.price,\n\t\tpriceText = card.priceText,\n\t\tcurrencyId = card.currencyId,\n\t\trequirementLines = table.clone(card.requirementLines),\n\t\tstate = card.state,\n\t\tprimaryExplanation = card.primaryExplanation,\n\t\tactionLabel = card.actionLabel,\n\t\tcanActivate = card.canActivate,\n\t}\nend\n\nlocal function invalidateContext(player: Player, code: string)\n\tlocal context = contexts[player]\n\tif context == nil then\n\t\treturn\n\tend\n\tcontexts[player] = nil\n\tlog:Debug(\n\t\t\"UpgradeContextInvalidated userId=%d contextId=%s code=%s\",\n\t\tplayer.UserId,\n\t\tcontext.Id,\n\t\tcode\n\t)\nend\n\nfunction UpgradeService:OpenShop(player: Player, shop: BasePart): any\n\tlocal d = deps()\n\tif player.Parent ~= Players or not d.Profile:IsWritable(player) then\n\t\treturn failure(\"PROFILE_NOT_READY\")\n\tend\n\tif d.WorldReady(player) ~= true then\n\t\treturn failure(\"WORLD_NOT_READY\")\n\tend\n\tif not shop:IsDescendantOf(Workspace) or not withinShopRange(player, shop) then\n\t\treturn failure(\"TOO_FAR_AWAY\")\n\tend\n\tlocal session = d.Profile:GetSessionHandle(player)\n\tlocal data = d.Profile:GetReadableData(player)\n\tif session == nil or data == nil then\n\t\treturn failure(\"PROFILE_NOT_READY\")\n\tend\n\tlocal contextId = d.GenerateId()\n\tlocal context = {\n\t\tId = contextId,\n\t\tPlayer = player,\n\t\tSession = session,\n\t\tShop = shop,\n\t\tExpiresAt = d.Now() + CONTEXT_LIFETIME_SECONDS,\n\t\tTerms = {},\n\t\tPresentationEvents = {},\n\t\tPresentationCount = 0,\n\t\tPresentationTokens = RATE_BURST,\n\t\tPresentationLastAt = d.Now(),\n\t}\n\tlocal cards = {}\n\tfor _, offer in d.Catalogue.GetAll() do\n\t\tlocal target, targetReason = d.ResolveTarget(player, offer)\n\t\tlocal card = cardFor(player, data, offer, target)\n\t\tif targetReason ~= nil and card.primaryExplanation == nil then\n\t\t\tcard.primaryExplanation = targetReason\n\t\t\tcard.state = \"Unavailable\"\n\t\t\tcard.canActivate = false\n\t\t\tcard.actionLabel = \"Unavailable\"\n\t\tend\n\t\tcontext.Terms[offer.id] = {\n\t\t\tOffer = offer,\n\t\t\tTarget = target,\n\t\t\tSignature = termSignature(offer, target),\n\t\t\tMeasurementKey = measurementKey(offer, target),\n\t\t}\n\t\ttable.insert(cards, card)\n\tend\n\tcontexts[player] = context\n\tlocal balance = data.Economy and data.Economy.Balance\n\tlocal payload = {\n\t\tcontextId = contextId,\n\t\texpiresAtServerTime = context.ExpiresAt,\n\t\tbalance = if finiteNonNegative(balance) then balance else nil,\n\t\toffers = cards,\n\t}\n\tif openRemote then\n\t\topenRemote:FireClient(player, payload)\n\tend\n\tlocal offerKeys = {}\n\tfor _, offer in d.Catalogue.GetAll() do\n\t\tlocal term = context.Terms[offer.id]\n\t\tif term then\n\t\t\ttable.insert(offerKeys, term.MeasurementKey)\n\t\tend\n\tend\n\tnotifyObservation(player, {\n\t\tkind = \"ContextIssued\",\n\t\teventId = contextId,\n\t\tat = d.Now(),\n\t\tcontextId = contextId,\n\t\tsessionGeneration = session.Generation,\n\t\tofferKeys = table.freeze(offerKeys),\n\t})\n\tlog:Info(\"UpgradeShopOpened userId=%d contextId=%s offers=%d\", player.UserId, contextId, #cards)\n\treturn { ok = true, code = \"OPENED\", payload = payload }\nend\n\nfunction UpgradeService:GetMeasurementOffers(player: Player): { any }\n\tlocal d = deps()\n\tlocal data = d.Profile:GetReadableData(player)\n\tif data == nil then\n\t\treturn {}\n\tend\n\tlocal result = {}\n\tfor _, offer in d.Catalogue.GetAll() do\n\t\tlocal target, targetReason = d.ResolveTarget(player, offer)\n\t\tlocal snapshot = d.BuildPlayerSnapshot(player, data, target)\n\t\tlocal decomposition = d.Eligibility.DecomposeOffer(offer, snapshot, target, d.Readiness)\n\t\ttable.insert(\n\t\t\tresult,\n\t\t\ttable.freeze({\n\t\t\t\tofferId = offer.id,\n\t\t\t\ttargetKey = targetIdentity(target),\n\t\t\t\ttermsVersion = measurementTermsVersion(offer, target),\n\t\t\t\tofferKey = measurementKey(offer, target),\n\t\t\t\tprice = offer.price,\n\t\t\t\towned = decomposition.owned,\n\t\t\t\tfundsSufficient = decomposition.fundsSufficient,\n\t\t\t\tready = decomposition.ready and targetReason == nil,\n\t\t\t\tprerequisitesSatisfied = decomposition.prerequisitesSatisfied,\n\t\t\t\tpathBlocked = decomposition.pathBlocked or targetReason ~= nil,\n\t\t\t\tprimaryReason = targetReason or decomposition.primaryReason,\n\t\t\t})\n\t\t)\n\tend\n\treturn result\nend\n\nlocal function validateContext(player: Player, contextId: string): (any?, string?)\n\tlocal context = contexts[player]\n\tif context == nil or context.Id ~= contextId then\n\t\treturn nil, \"INVALID_CONTEXT\"\n\tend\n\tif deps().Now() >= context.ExpiresAt then\n\t\tinvalidateContext(player, \"CONTEXT_EXPIRED\")\n\t\treturn nil, \"CONTEXT_EXPIRED\"\n\tend\n\tif not sessionIsCurrent(player, context.Session) or not deps().Profile:IsWritable(player) then\n\t\tinvalidateContext(player, \"SESSION_CHANGED\")\n\t\treturn nil, \"SESSION_CHANGED\"\n\tend\n\tif deps().WorldReady(player) ~= true then\n\t\tinvalidateContext(player, \"WORLD_NOT_READY\")\n\t\treturn nil, \"WORLD_NOT_READY\"\n\tend\n\tif not context.Shop:IsDescendantOf(Workspace) or not withinShopRange(player, context.Shop) then\n\t\treturn nil, \"TOO_FAR_AWAY\"\n\tend\n\treturn context, nil\nend\n\nlocal function rejectionFromEvaluation(evaluation: any): string\n\tif evaluation.outcome == \"Owned\" then\n\t\treturn \"ALREADY_OWNED\"\n\telseif evaluation.outcome == \"InsufficientFunds\" then\n\t\treturn \"INSUFFICIENT_FUNDS\"\n\telseif evaluation.primaryReason and evaluation.primaryReason.code then\n\t\treturn evaluation.primaryReason.code\n\tend\n\treturn string.upper(tostring(evaluation.outcome or \"UNAVAILABLE\"))\nend\n\nfunction UpgradeService:Purchase(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal contextId = payload.contextId\n\tlocal requestId = payload.requestId\n\tlocal offerId = payload.offerId\n\tif\n\t\tnot nonEmptyBoundedString(contextId)\n\t\tor not nonEmptyBoundedString(requestId)\n\t\tor not nonEmptyBoundedString(offerId)\n\tthen\n\t\treturn failure(\"INVALID_REQUEST\", if type(requestId) == \"string\" then requestId else nil)\n\tend\n\tlocal contextForSignature = contexts[player]\n\tlocal target = if contextForSignature and contextForSignature.Terms[offerId]\n\t\tthen contextForSignature.Terms[offerId].Target\n\t\telse nil\n\tlocal signature = requestSignature(contextId, offerId, target)\n\tlocal duplicate = cachedResult(player, requestId, signature)\n\tif duplicate then\n\t\tlog:Debug(\n\t\t\t\"UpgradePurchaseDuplicate userId=%d offerId=%s requestId=%s\",\n\t\t\tplayer.UserId,\n\t\t\tofferId,\n\t\t\trequestId\n\t\t)\n\t\treturn duplicate\n\tend\n\tif not consumeRateToken(player) then\n\t\tlocal result = failure(\"RATE_LIMITED\", requestId)\n\t\trememberResult(player, requestId, signature, result, nil)\n\t\treturn result\n\tend\n\tlocal context, contextReason = validateContext(player, contextId)\n\tif context == nil then\n\t\tlocal result = failure(contextReason or \"INVALID_CONTEXT\", requestId)\n\t\trememberResult(player, requestId, signature, result, nil)\n\t\treturn result\n\tend\n\tlocal presented = context.Terms[offerId]\n\tlocal offer = currentOffer(offerId)\n\tif presented == nil or offer == nil then\n\t\tlocal result = failure(\"UNKNOWN_OFFER\", requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\tif termSignature(offer, presented.Target) ~= presented.Signature then\n\t\tlocal result = failure(\"OFFER_CHANGED\", requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\n\tlocal d = deps()\n\tlocal data = d.Profile:GetWritableData(player)\n\tif data == nil then\n\t\tlocal result = failure(\"PROFILE_NOT_READY\", requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\tlocal evaluation = buildEvaluation(player, data, offer, presented.Target)\n\tif evaluation.outcome ~= \"Available\" then\n\t\tlocal result = failure(rejectionFromEvaluation(evaluation), requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\tlog:Info(\n\t\t\t\"UpgradePurchaseRejected userId=%d offerId=%s requestId=%s code=%s\",\n\t\t\tplayer.UserId,\n\t\t\tofferId,\n\t\t\trequestId,\n\t\t\tresult.code\n\t\t)\n\t\treturn result\n\tend\n\n\tlocal balanceBefore: number? = nil\n\tlocal committedAt: number? = nil\n\tlocal commit = d.Profile:CommitMutation(player, function(currentData)\n\t\tlocal currentEvaluation = buildEvaluation(player, currentData, offer, presented.Target)\n\t\tif currentEvaluation.outcome ~= \"Available\" then\n\t\t\treturn false, failure(rejectionFromEvaluation(currentEvaluation), requestId)\n\t\tend\n\t\tlocal prepared = d.Currency:PrepareSpend(currentData, offer.price)\n\t\tif prepared.ok ~= true then\n\t\t\treturn false, failure(prepared.code or \"INVALID_COST\", requestId)\n\t\tend\n\t\tbalanceBefore = currentData.Economy.Balance\n\t\tlocal granted, grantReason = d.ApplyGrant(currentData, offer, presented.Target)\n\t\tif granted ~= true then\n\t\t\treturn false, failure(grantReason or \"GRANT_REJECTED\", requestId)\n\t\tend\n\t\tcurrentData.Economy.Balance = prepared.balance\n\t\tcommittedAt = d.Now()\n\t\treturn true,\n\t\t\t{\n\t\t\t\tok = true,\n\t\t\t\toutcome = \"Accepted\",\n\t\t\t\tcode = \"PURCHASE_ACCEPTED\",\n\t\t\t\trequestId = requestId,\n\t\t\t\tofferId = offer.id,\n\t\t\t\tchargedAmount = offer.price,\n\t\t\t\tbalance = prepared.balance,\n\t\t\t\tpersistence = \"Pending\",\n\t\t\t}\n\tend)\n\tif type(commit) ~= \"table\" or commit.ok ~= true or commit.committed ~= true then\n\t\tlocal result = if type(commit) == \"table\"\n\t\t\tthen commit\n\t\t\telse failure(\"MUTATION_FAILED\", requestId)\n\t\tresult.requestId = requestId\n\t\tresult.outcome = result.outcome or \"Rejected\"\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\tcommit.commitRevision = commit.revision\n\tcommit.persistence = \"Pending\"\n\trememberResult(player, requestId, signature, commit, context.Session)\n\tobservationOperationSequence += 1\n\tlocal committedMeasurementKey = measurementKey(offer, presented.Target)\n\tlocal remembered = requestCaches[player] and requestCaches[player].ById[requestId]\n\tif remembered then\n\t\tremembered.MeasurementKey = committedMeasurementKey\n\t\tremembered.CommittedAt = committedAt\n\t\tremembered.OperationSequence = observationOperationSequence\n\tend\n\t-- Capture committed values before any effect listener or save can run. Direct\n\t-- server purchases and client requests use this same canonical receipt.\n\tnotifyObservation(player, {\n\t\tkind = \"PurchaseCommitted\",\n\t\teventId = requestId,\n\t\tat = committedAt,\n\t\tcontextId = context.Id,\n\t\trequestId = requestId,\n\t\tofferId = offer.id,\n\t\tofferKey = committedMeasurementKey,\n\t\ttargetKey = targetIdentity(presented.Target),\n\t\ttermsVersion = measurementTermsVersion(offer, presented.Target),\n\t\tprice = offer.price,\n\t\tcurrencyId = offer.currencyId,\n\t\townershipScope = offer.ownershipScope.kind,\n\t\tchargedAmount = commit.chargedAmount,\n\t\tbalanceBefore = balanceBefore,\n\t\tbalanceAfter = commit.balance,\n\t\tcommitRevision = commit.revision,\n\t\tsessionGeneration = context.Session.Generation,\n\t\toperationSequence = observationOperationSequence,\n\t\tready = true,\n\t\tprerequisitesSatisfied = true,\n\t\tfundsSufficient = true,\n\t\taccepted = true,\n\t\tpersistence = \"Pending\",\n\t})\n\tpcall(d.Currency.SyncBalance, d.Currency, player)\n\t-- Effects rederive from committed ownership outside the profile mutation. A\n\t-- listener failure cannot repeat, roll back, or partially re-run the purchase.\n\tpurchaseCommittedEvent:Fire(player, offer, presented.Target, commit.revision)\n\tlocal saveRequest = d.Profile:RequestSave(player, \"UpgradePurchase:\" .. offer.id)\n\tif type(saveRequest) ~= \"table\" or saveRequest.ok ~= true then\n\t\tcommit.persistence = \"Delayed\"\n\tend\n\tlog:Info(\n\t\t\"UpgradePurchaseCommitted userId=%d offerId=%s requestId=%s revision=%d\",\n\t\tplayer.UserId,\n\t\toffer.id,\n\t\trequestId,\n\t\tcommit.revision\n\t)\n\treturn table.clone(commit)\nend\n\nfunction UpgradeService:GetRequestStatus(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal contextId, requestId, offerId = payload.contextId, payload.requestId, payload.offerId\n\tif\n\t\tnot nonEmptyBoundedString(contextId)\n\t\tor not nonEmptyBoundedString(requestId)\n\t\tor not nonEmptyBoundedString(offerId)\n\tthen\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal context = contexts[player]\n\tlocal target = if context and context.Terms[offerId] then context.Terms[offerId].Target else nil\n\tlocal signature = requestSignature(contextId, offerId, target)\n\tlocal cached = cachedResult(player, requestId, signature)\n\treturn cached or failure(\"REQUEST_STATUS_UNKNOWN\", requestId)\nend\n\nfunction UpgradeService:SubscribePurchaseCommitted(\n\tcallback: (Player, any, any, number) -> ()\n): RBXScriptConnection\n\treturn purchaseCommittedEvent.Event:Connect(callback)\nend\n\nfunction UpgradeService:SubscribeObservations(callback: (Player, any) -> ()): any\n\tlocal connection = {}\n\tobservationListeners[connection] = callback\n\tfunction connection.Disconnect()\n\t\tobservationListeners[connection] = nil\n\tend\n\treturn connection\nend\n\nfunction UpgradeService:ObservePresentation(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" or not nonEmptyBoundedString(payload.contextId) then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tfor key in payload do\n\t\tif\n\t\t\tkey ~= \"operation\"\n\t\t\tand key ~= \"contextId\"\n\t\t\tand key ~= \"kind\"\n\t\t\tand key ~= \"inputCategory\"\n\t\t\tand key ~= \"offerId\"\n\t\tthen\n\t\t\treturn failure(\"INVALID_REQUEST\")\n\t\tend\n\tend\n\tif payload.operation ~= nil and payload.operation ~= \"Presentation\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal kind = payload.kind\n\tif kind ~= \"MenuRendered\" and kind ~= \"OfferInspected\" then\n\t\treturn failure(\"INVALID_PRESENTATION_EVENT\")\n\tend\n\tif\n\t\t(kind == \"MenuRendered\" and payload.offerId ~= nil)\n\t\tor (kind == \"OfferInspected\" and not nonEmptyBoundedString(payload.offerId))\n\tthen\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal inputCategory = payload.inputCategory\n\tlocal validInput = inputCategory == \"Desktop\"\n\t\tor inputCategory == \"Touch\"\n\t\tor inputCategory == \"Gamepad\"\n\t\tor inputCategory == \"Hybrid\"\n\t\tor inputCategory == \"Unknown\"\n\tif not validInput then\n\t\treturn failure(\"INVALID_INPUT_CATEGORY\")\n\tend\n\tlocal context = contexts[player]\n\tif context == nil or context.Id ~= payload.contextId then\n\t\treturn failure(\"INVALID_CONTEXT\")\n\tend\n\t-- Presentation has its own bounded budget; an analytics burst cannot consume\n\t-- the player's gameplay purchase tokens. Duplicates still consume this budget.\n\tlocal currentTime = deps().Now()\n\tlocal elapsed = math.max(0, currentTime - context.PresentationLastAt)\n\tcontext.PresentationLastAt = currentTime\n\tcontext.PresentationTokens =\n\t\tmath.min(RATE_BURST, context.PresentationTokens + elapsed * RATE_REFILL_PER_SECOND)\n\tif context.PresentationTokens < 1 or context.PresentationCount >= 64 then\n\t\treturn failure(\"RATE_LIMITED\")\n\tend\n\tcontext.PresentationTokens -= 1\n\tcontext.PresentationCount += 1\n\tlocal validatedContext, contextReason = validateContext(player, payload.contextId)\n\tif validatedContext == nil then\n\t\treturn failure(contextReason or \"INVALID_CONTEXT\")\n\tend\n\tlocal term = nil\n\tif kind == \"OfferInspected\" then\n\t\tterm = context.Terms[payload.offerId]\n\t\tif term == nil then\n\t\t\treturn failure(\"UNKNOWN_OFFER\")\n\t\tend\n\tend\n\tlocal dedupKey = kind .. \":\" .. tostring(payload.offerId or \"menu\")\n\tif not context.PresentationEvents[dedupKey] then\n\t\tcontext.PresentationEvents[dedupKey] = true\n\t\tnotifyObservation(player, {\n\t\t\tkind = kind,\n\t\t\teventId = context.Id .. \":\" .. dedupKey,\n\t\t\tat = deps().Now(),\n\t\t\tcontextId = context.Id,\n\t\t\tsessionGeneration = context.Session.Generation,\n\t\t\tofferId = payload.offerId,\n\t\t\tofferKey = if term then term.MeasurementKey else nil,\n\t\t\tinputCategory = inputCategory,\n\t\t})\n\tend\n\treturn { ok = true, code = \"RECORDED\" }\nend\n\nfunction UpgradeService:HandleRequest(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tif payload.operation == \"Purchase\" then\n\t\tlocal context = contexts[player]\n\t\tlocal validObservation = context ~= nil\n\t\t\tand context.Id == payload.contextId\n\t\t\tand nonEmptyBoundedString(payload.contextId)\n\t\t\tand nonEmptyBoundedString(payload.requestId)\n\t\t\tand nonEmptyBoundedString(payload.offerId)\n\t\t\tand sessionIsCurrent(player, context.Session)\n\t\tlocal term = if validObservation then context.Terms[payload.offerId] else nil\n\t\tlocal cache = requestCaches[player]\n\t\tlocal replayed = cache ~= nil and cache.ById[payload.requestId] ~= nil\n\t\tif term and not replayed then\n\t\t\tnotifyObservation(player, {\n\t\t\t\tkind = \"PurchaseAttempt\",\n\t\t\t\teventId = payload.requestId,\n\t\t\t\tat = deps().Now(),\n\t\t\t\tcontextId = payload.contextId,\n\t\t\t\trequestId = payload.requestId,\n\t\t\t\tofferId = payload.offerId,\n\t\t\t\tofferKey = term.MeasurementKey,\n\t\t\t\tsessionGeneration = context.Session.Generation,\n\t\t\t})\n\t\tend\n\t\tlocal result = self:Purchase(player, payload)\n\t\tif term and not replayed and result.outcome ~= \"Accepted\" then\n\t\t\tnotifyObservation(player, {\n\t\t\t\tkind = \"PurchaseResult\",\n\t\t\t\teventId = payload.requestId,\n\t\t\t\tat = deps().Now(),\n\t\t\t\tcontextId = payload.contextId,\n\t\t\t\trequestId = payload.requestId,\n\t\t\t\tofferId = payload.offerId,\n\t\t\t\tofferKey = term.MeasurementKey,\n\t\t\t\taccepted = false,\n\t\t\t\tcode = result.code,\n\t\t\t\tsessionGeneration = context.Session.Generation,\n\t\t\t})\n\t\tend\n\t\treturn result\n\telseif payload.operation == \"Status\" then\n\t\treturn self:GetRequestStatus(player, payload)\n\telseif payload.operation == \"Presentation\" then\n\t\treturn self:ObservePresentation(player, payload)\n\tend\n\treturn failure(\"INVALID_OPERATION\")\nend\n\nfunction UpgradeService:CloseShop(player: Player, contextId: any): boolean\n\tlocal context = contexts[player]\n\tif context == nil then\n\t\treturn false\n\tend\n\tif contextId ~= nil and contextId ~= context.Id then\n\t\treturn false\n\tend\n\tinvalidateContext(player, \"CLIENT_CLOSED\")\n\treturn true\nend\n\nlocal function ensureRemote(className: string, name: string): Instance\n\tlocal remotes = ReplicatedStorage:FindFirstChild(\"Remotes\")\n\tif not remotes then\n\t\tremotes = Instance.new(\"Folder\")\n\t\tremotes.Name = \"Remotes\"\n\t\tremotes.Parent = ReplicatedStorage\n\tend\n\tlocal remote = remotes:FindFirstChild(name)\n\tif not remote then\n\t\tremote = Instance.new(className)\n\t\tremote.Name = name\n\t\tremote.Parent = remotes\n\tend\n\tassert(remote.ClassName == className, name .. \" must be a \" .. className)\n\treturn remote\nend\n\nlocal function onSaveConfirmed(player: Player, savedRevision: number, _currentRevision: number)\n\tlocal cache = requestCaches[player]\n\tif cache == nil then\n\t\treturn\n\tend\n\tlocal currentSession = deps().Profile:GetSessionHandle(player)\n\tfor _, entry in cache.ById do\n\t\tlocal result = entry.Result\n\t\tif\n\t\t\tsameSession(entry.Session, currentSession)\n\t\t\tand result.outcome == \"Accepted\"\n\t\t\tand type(result.commitRevision) == \"number\"\n\t\t\tand savedRevision >= result.commitRevision\n\t\t\tand result.persistence ~= \"Confirmed\"\n\t\tthen\n\t\t\tresult.persistence = \"Confirmed\"\n\t\t\tif updateRemote then\n\t\t\t\tupdateRemote:FireClient(player, {\n\t\t\t\t\tkind = \"PurchasePersistence\",\n\t\t\t\t\trequestId = result.requestId,\n\t\t\t\t\tofferId = result.offerId,\n\t\t\t\t\tcommitRevision = result.commitRevision,\n\t\t\t\t\tpersistence = \"Confirmed\",\n\t\t\t\t})\n\t\t\tend\n\t\t\tlog:Info(\n\t\t\t\t\"UpgradePurchaseSaveConfirmed userId=%d offerId=%s requestId=%s revision=%d\",\n\t\t\t\tplayer.UserId,\n\t\t\t\tresult.offerId,\n\t\t\t\tresult.requestId,\n\t\t\t\tresult.commitRevision\n\t\t\t)\n\t\t\tif entry.MeasurementKey then\n\t\t\t\t-- Cache iteration is not purchase order. Sequence this observation at\n\t\t\t\t-- delivery so a covering save can confirm every committed purchase.\n\t\t\t\tobservationOperationSequence += 1\n\t\t\t\tnotifyObservation(player, {\n\t\t\t\t\tkind = \"PurchaseSaveConfirmed\",\n\t\t\t\t\teventId = tostring(result.requestId) .. \":saved\",\n\t\t\t\t\tat = deps().Now(),\n\t\t\t\t\trequestId = result.requestId,\n\t\t\t\t\tofferId = result.offerId,\n\t\t\t\t\tofferKey = entry.MeasurementKey,\n\t\t\t\t\tcommitRevision = result.commitRevision,\n\t\t\t\t\tsessionGeneration = entry.Session.Generation,\n\t\t\t\t\toperationSequence = observationOperationSequence,\n\t\t\t\t\tpurchaseOperationSequence = entry.OperationSequence,\n\t\t\t\t\tcommittedAt = entry.CommittedAt,\n\t\t\t\t})\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction UpgradeService:Init(options: any?)\n\tassert(not started, \"Cannot replace UpgradeService dependencies after Start\")\n\tlocal base = defaultDependencies()\n\tfor key, value in options or {} do\n\t\tbase[key] = value\n\tend\n\tdependencies = base\nend\n\nfunction UpgradeService:Start(options: any?): boolean\n\tif started then\n\t\treturn false\n\tend\n\tif options or dependencies == nil then\n\t\tself:Init(options)\n\tend\n\tstarted = true\n\topenRemote = ensureRemote(\"RemoteEvent\", RemoteNames.OpenCartUpgradeShop) :: RemoteEvent\n\trequestRemote =\n\t\tensureRemote(\"RemoteFunction\", RemoteNames.CartUpgradeShopRequest) :: RemoteFunction\n\tcloseRemote = ensureRemote(\"RemoteEvent\", RemoteNames.CloseCartUpgradeShop) :: RemoteEvent\n\tupdateRemote = ensureRemote(\"RemoteEvent\", RemoteNames.CartUpgradeShopUpdate) :: RemoteEvent\n\trequestHandler = function(player, payload)\n\t\treturn UpgradeService:HandleRequest(player, payload)\n\tend\n\trequestRemote.OnServerInvoke = requestHandler\n\ttable.insert(\n\t\tconnections,\n\t\t(closeRemote :: RemoteEvent).OnServerEvent:Connect(function(player, contextId)\n\t\t\tUpgradeService:CloseShop(player, contextId)\n\t\tend)\n\t)\n\ttable.insert(\n\t\tconnections,\n\t\tPlayers.PlayerRemoving:Connect(function(player)\n\t\t\tinvalidateContext(player, \"PLAYER_REMOVING\")\n\t\t\trequestCaches[player] = nil\n\t\t\trateStates[player] = nil\n\t\tend)\n\t)\n\tlocal saveSignal = deps().Profile.SubscribeSaveConfirmed\n\tif saveSignal then\n\t\ttable.insert(connections, deps().Profile:SubscribeSaveConfirmed(onSaveConfirmed))\n\tend\n\treturn true\nend\n\nfunction UpgradeService:Stop()\n\tif requestRemote and requestRemote.OnServerInvoke == requestHandler then\n\t\trequestRemote.OnServerInvoke = nil\n\tend\n\tfor _, connection in connections do\n\t\tconnection:Disconnect()\n\tend\n\ttable.clear(connections)\n\ttable.clear(contexts)\n\ttable.clear(requestCaches)\n\ttable.clear(rateStates)\n\topenRemote, requestRemote, closeRemote, updateRemote, requestHandler = nil, nil, nil, nil, nil\n\tdependencies = nil\n\tstarted = false\n\tobservationOperationSequence = 0\nend\n\nfunction UpgradeService:_TestConfirmSave(player: Player, savedRevision: number)\n\tonSaveConfirmed(player, savedRevision, savedRevision)\nend\n\nfunction UpgradeService:_TestGetContext(player: Player): any?\n\treturn contexts[player]\nend\n\nreturn UpgradeService\n","afterSource":"--!strict\n\n-- Owns the upgrade-shop context and the one coherent purchase commit. Real\n-- catalogue offers remain fail-closed until their 7B-1 scope, persistence and\n-- effect gates are approved. Tests may inject a private ready offer and\n-- ownership adapter without exposing it through the production catalogue.\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal InteractionConfig = require(ReplicatedStorage.Shared.Config.BrainrotInteraction)\nlocal CompactMapGeometry = require(ReplicatedStorage.Shared.Utility.CompactMapGeometry)\nlocal Upgrades = require(ReplicatedStorage.Shared.Config.Upgrades)\nlocal RemoteNames = require(ReplicatedStorage.Shared.Constants.RemoteNames)\nlocal UpgradeEligibility = require(ReplicatedStorage.Shared.Utility.UpgradeEligibility)\nlocal Logger = require(ReplicatedStorage.Shared.Utility.Logger)\nlocal PlayerDataService = require(script.Parent.PlayerDataService)\nlocal CurrencySystem = require(script.Parent.Parent.Systems.CurrencySystem)\n\nlocal CONTEXT_LIFETIME_SECONDS = 120\nlocal MAX_IDENTIFIER_LENGTH = 128\nlocal REQUEST_CACHE_LIMIT = 64\nlocal REQUEST_CACHE_LIFETIME_SECONDS = 180\nlocal RATE_BURST = 6\nlocal RATE_REFILL_PER_SECOND = 3\n\nlocal UpgradeService = {}\nlocal log = Logger.new(\"UpgradeService\")\nlocal started = false\nlocal dependencies: any = nil\nlocal contexts: { [Player]: any } = {}\nlocal requestCaches: { [Player]: any } = {}\nlocal rateStates: { [Player]: any } = {}\nlocal connections: { any } = {}\nlocal openRemote: RemoteEvent? = nil\nlocal requestRemote: RemoteFunction? = nil\nlocal closeRemote: RemoteEvent? = nil\nlocal updateRemote: RemoteEvent? = nil\nlocal requestHandler: ((Player, any) -> any)? = nil\nlocal purchaseCommittedEvent = Instance.new(\"BindableEvent\")\nlocal observationListeners: { [any]: (Player, any) -> () } = {}\nlocal observationOperationSequence = 0\n\nlocal function notifyObservation(player: Player, receipt: any)\n\tlocal immutable = table.freeze(receipt)\n\tfor _, callback in observationListeners do\n\t\tlocal ok, failureMessage = pcall(callback, player, immutable)\n\t\tif not ok then\n\t\t\tlog:Warn(\n\t\t\t\t\"Upgrade observation listener failed userId=%d: %s\",\n\t\t\t\tplayer.UserId,\n\t\t\t\ttostring(failureMessage)\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function defaultDependencies(): any\n\treturn {\n\t\tProfile = PlayerDataService,\n\t\tCurrency = CurrencySystem,\n\t\tCatalogue = Upgrades,\n\t\tEligibility = UpgradeEligibility,\n\t\tReadiness = {\n\t\t\teffectReadyByOfferId = {},\n\t\t\tpersistenceReadyByScope = {},\n\t\t\tcartAcquisitionByTier = {},\n\t\t\trankProviderOperational = false,\n\t\t},\n\t\tWorldReady = function(_player: Player): boolean\n\t\t\treturn false\n\t\tend,\n\t\tResolveTarget = function(_player: Player, _offer: any): (any?, string?)\n\t\t\treturn nil, nil\n\t\tend,\n\t\tBuildPlayerSnapshot = function(player: Player, data: any, _target: any): any\n\t\t\treturn {\n\t\t\t\tstatus = \"Ready\",\n\t\t\t\tuserId = player.UserId,\n\t\t\t\tbalance = if type(data.Economy) == \"table\" then data.Economy.Balance else nil,\n\t\t\t}\n\t\tend,\n\t\tApplyGrant = function(_data: any, _offer: any, _target: any): (boolean, string?)\n\t\t\treturn false, \"OWNERSHIP_PERSISTENCE_UNAVAILABLE\"\n\t\tend,\n\t\tNow = function(): number\n\t\t\treturn Workspace:GetServerTimeNow()\n\t\tend,\n\t\tGenerateId = function(): string\n\t\t\treturn HttpService:GenerateGUID(false)\n\t\tend,\n\t}\nend\n\nlocal function deps(): any\n\tif dependencies then\n\t\treturn dependencies\n\tend\n\tdependencies = defaultDependencies()\n\treturn dependencies\nend\n\nlocal function failure(code: string, requestId: string?): any\n\treturn {\n\t\tok = false,\n\t\toutcome = \"Rejected\",\n\t\tcode = code,\n\t\trequestId = requestId,\n\t}\nend\n\nlocal function nonEmptyBoundedString(value: any): boolean\n\treturn type(value) == \"string\"\n\t\tand #value > 0\n\t\tand #value <= MAX_IDENTIFIER_LENGTH\n\t\tand value:match(\"%c\") == nil\nend\n\nlocal function finiteNonNegative(value: any): boolean\n\treturn type(value) == \"number\" and value == value and value >= 0 and value < math.huge\nend\n\nlocal function sameSession(left: any, right: any): boolean\n\treturn left ~= nil\n\t\tand right ~= nil\n\t\tand left.Player == right.Player\n\t\tand left.UserId == right.UserId\n\t\tand left.Generation == right.Generation\nend\n\nlocal function sessionIsCurrent(player: Player, handle: any): boolean\n\tlocal profile = deps().Profile\n\treturn profile:IsCurrentSessionHandle(handle)\n\t\tand sameSession(profile:GetSessionHandle(player), handle)\nend\n\nlocal function finitePosition(position: Vector3): boolean\n\treturn position.X == position.X\n\t\tand math.abs(position.X) < math.huge\n\t\tand position.Y == position.Y\n\t\tand math.abs(position.Y) < math.huge\n\t\tand position.Z == position.Z\n\t\tand math.abs(position.Z) < math.huge\nend\n\nlocal function playerRoot(player: Player): BasePart?\n\tlocal character = player.Character\n\tlocal humanoid = if character then character:FindFirstChildOfClass(\"Humanoid\") else nil\n\tlocal root = if character then character:FindFirstChild(\"HumanoidRootPart\") else nil\n\tif\n\t\tcharacter == nil\n\t\tor not character:IsDescendantOf(Workspace)\n\t\tor humanoid == nil\n\t\tor humanoid.Health <= 0\n\t\tor root == nil\n\t\tor not root:IsA(\"BasePart\")\n\t\tor not finitePosition(root.Position)\n\tthen\n\t\treturn nil\n\tend\n\treturn root\nend\n\nlocal function withinShopRange(player: Player, shop: BasePart): boolean\n\tlocal custom = deps().WithinShopRange\n\tif custom then\n\t\treturn custom(player, shop)\n\tend\n\tlocal root = playerRoot(player)\n\tif root == nil or not shop:IsDescendantOf(Workspace) then\n\t\treturn false\n\tend\n\tlocal localPosition = shop.CFrame:PointToObjectSpace(root.Position)\n\tlocal halfSize = CompactMapGeometry.ResolveInteractionSize(shop) * 0.5\n\tlocal closestLocal = Vector3.new(\n\t\tmath.clamp(localPosition.X, -halfSize.X, halfSize.X),\n\t\tmath.clamp(localPosition.Y, -halfSize.Y, halfSize.Y),\n\t\tmath.clamp(localPosition.Z, -halfSize.Z, halfSize.Z)\n\t)\n\tlocal closest = shop.CFrame:PointToWorldSpace(closestLocal)\n\treturn (root.Position - closest).Magnitude\n\t\t<= InteractionConfig.SELL_INTERACTION_DISTANCE\n\t\t\t+ InteractionConfig.SELL_SERVER_DISTANCE_TOLERANCE\nend\n\nlocal function targetIdentity(target: any): string\n\tif type(target) ~= \"table\" then\n\t\treturn \"none\"\n\tend\n\treturn tostring(target.durableCartId or target.equipmentId or \"none\")\nend\n\nlocal function termSignature(offer: any, target: any): string\n\tlocal grant = if type(offer.grant) == \"table\" then offer.grant else {}\n\tlocal scope = if type(offer.ownershipScope) == \"table\" then offer.ownershipScope else {}\n\treturn table.concat({\n\t\ttostring(offer.id),\n\t\ttostring(offer.price),\n\t\ttostring(offer.currencyId),\n\t\ttostring(grant.kind),\n\t\ttostring(grant.trackId or grant.equipmentId),\n\t\ttostring(grant.level),\n\t\ttostring(scope.kind),\n\t\ttargetIdentity(target),\n\t}, \"|\")\nend\n\n-- Canonicalize only static catalogue terms. This is a measurement identity,\n-- independent of the existing purchase-context validation contract.\nlocal function orderedTerms(value: any): any\n\tif type(value) ~= \"table\" then\n\t\treturn value\n\tend\n\tlocal keys = {}\n\tfor key in value do\n\t\ttable.insert(keys, key)\n\tend\n\ttable.sort(keys, function(left, right)\n\t\treturn tostring(left) < tostring(right)\n\tend)\n\tlocal entries = {}\n\tfor _, key in keys do\n\t\ttable.insert(entries, { key, orderedTerms(value[key]) })\n\tend\n\treturn entries\nend\n\nlocal function measurementTermsVersion(offer: any, target: any): string\n\treturn HttpService:JSONEncode(orderedTerms({\n\t\tid = offer.id,\n\t\tprice = offer.price,\n\t\tcurrencyId = offer.currencyId,\n\t\tgrant = offer.grant,\n\t\townershipScope = offer.ownershipScope,\n\t\tapplicability = offer.applicability,\n\t\trequirements = offer.requirements,\n\t\teffect = offer.effect,\n\t\tdefinitionStatus = offer.definitionStatus,\n\t\treleaseStatus = offer.releaseStatus,\n\t\teffectStatus = offer.effectStatus,\n\t\ttargetKey = targetIdentity(target),\n\t}))\nend\n\nlocal function measurementKey(offer: any, target: any): string\n\treturn tostring(offer.id)\n\t\t.. \"|\"\n\t\t.. targetIdentity(target)\n\t\t.. \"|\"\n\t\t.. measurementTermsVersion(offer, target)\nend\n\nlocal function requestSignature(contextId: string, offerId: string, _target: any): string\n\t-- The opaque context ID already binds the server-resolved scope target. This\n\t-- keeps an exact successful retry readable after its menu context closes.\n\treturn contextId .. \"|\" .. offerId\nend\n\nlocal function pruneRequestCache(player: Player, currentTime: number)\n\tlocal cache = requestCaches[player]\n\tif cache == nil then\n\t\treturn\n\tend\n\twhile #cache.Order > 0 do\n\t\tlocal requestId = cache.Order[1]\n\t\tlocal entry = cache.ById[requestId]\n\t\tif\n\t\t\tentry ~= nil\n\t\t\tand currentTime - entry.CreatedAt <= REQUEST_CACHE_LIFETIME_SECONDS\n\t\t\tand #cache.Order <= REQUEST_CACHE_LIMIT\n\t\tthen\n\t\t\tbreak\n\t\tend\n\t\ttable.remove(cache.Order, 1)\n\t\tcache.ById[requestId] = nil\n\tend\nend\n\nlocal function requestCache(player: Player): any\n\tlocal cache = requestCaches[player]\n\tif cache == nil then\n\t\tcache = { ById = {}, Order = {} }\n\t\trequestCaches[player] = cache\n\tend\n\tpruneRequestCache(player, deps().Now())\n\treturn cache\nend\n\nlocal function rememberResult(\n\tplayer: Player,\n\trequestId: string,\n\tsignature: string,\n\tresult: any,\n\tsession: any\n)\n\tlocal cache = requestCache(player)\n\tif cache.ById[requestId] == nil then\n\t\ttable.insert(cache.Order, requestId)\n\tend\n\tcache.ById[requestId] = {\n\t\tSignature = signature,\n\t\tResult = result,\n\t\tCreatedAt = deps().Now(),\n\t\tSession = session,\n\t}\n\tpruneRequestCache(player, deps().Now())\nend\n\nlocal function cachedResult(player: Player, requestId: string, signature: string): any?\n\tlocal entry = requestCache(player).ById[requestId]\n\tif entry == nil then\n\t\treturn nil\n\tend\n\tif entry.Signature ~= signature then\n\t\treturn failure(\"REQUEST_ID_MISMATCH\", requestId)\n\tend\n\tlocal copy = table.clone(entry.Result)\n\tcopy.duplicate = true\n\treturn copy\nend\n\nlocal function consumeRateToken(player: Player): boolean\n\tlocal currentTime = deps().Now()\n\tlocal state = rateStates[player]\n\tif state == nil then\n\t\tstate = { Tokens = RATE_BURST, LastAt = currentTime }\n\t\trateStates[player] = state\n\tend\n\tlocal elapsed = math.max(0, currentTime - state.LastAt)\n\tstate.LastAt = currentTime\n\tstate.Tokens = math.min(RATE_BURST, state.Tokens + elapsed * RATE_REFILL_PER_SECOND)\n\tif state.Tokens < 1 then\n\t\treturn false\n\tend\n\tstate.Tokens -= 1\n\treturn true\nend\n\nlocal function currentOffer(offerId: string): any?\n\treturn deps().Catalogue.Get(offerId)\nend\n\nlocal function buildEvaluation(player: Player, data: any, offer: any, target: any): (any, any)\n\tlocal snapshot = deps().BuildPlayerSnapshot(player, data, target)\n\tlocal evaluation = deps().Eligibility.EvaluateOffer(offer, snapshot, target, deps().Readiness)\n\treturn evaluation, snapshot\nend\n\nlocal function cardFor(player: Player, data: any, offer: any, target: any): any\n\tlocal evaluation = buildEvaluation(player, data, offer, target)\n\tlocal card = deps().Eligibility.DescribeOffer(offer, evaluation, target)\n\treturn {\n\t\tofferId = card.offerId,\n\t\ttitle = card.title,\n\t\teffectSummary = card.effectSummary,\n\t\townershipSummary = card.ownershipSummary,\n\t\tprice = card.price,\n\t\tpriceText = card.priceText,\n\t\tcurrencyId = card.currencyId,\n\t\trequirementLines = table.clone(card.requirementLines),\n\t\tstate = card.state,\n\t\tprimaryExplanation = card.primaryExplanation,\n\t\tactionLabel = card.actionLabel,\n\t\tcanActivate = card.canActivate,\n\t}\nend\n\nlocal function invalidateContext(player: Player, code: string)\n\tlocal context = contexts[player]\n\tif context == nil then\n\t\treturn\n\tend\n\tcontexts[player] = nil\n\tlog:Debug(\n\t\t\"UpgradeContextInvalidated userId=%d contextId=%s code=%s\",\n\t\tplayer.UserId,\n\t\tcontext.Id,\n\t\tcode\n\t)\nend\n\nfunction UpgradeService:OpenShop(player: Player, shop: BasePart): any\n\tlocal d = deps()\n\tif player.Parent ~= Players or not d.Profile:IsWritable(player) then\n\t\treturn failure(\"PROFILE_NOT_READY\")\n\tend\n\tif d.WorldReady(player) ~= true then\n\t\treturn failure(\"WORLD_NOT_READY\")\n\tend\n\tif not shop:IsDescendantOf(Workspace) or not withinShopRange(player, shop) then\n\t\treturn failure(\"TOO_FAR_AWAY\")\n\tend\n\tlocal session = d.Profile:GetSessionHandle(player)\n\tlocal data = d.Profile:GetReadableData(player)\n\tif session == nil or data == nil then\n\t\treturn failure(\"PROFILE_NOT_READY\")\n\tend\n\tlocal contextId = d.GenerateId()\n\tlocal context = {\n\t\tId = contextId,\n\t\tPlayer = player,\n\t\tSession = session,\n\t\tShop = shop,\n\t\tExpiresAt = d.Now() + CONTEXT_LIFETIME_SECONDS,\n\t\tTerms = {},\n\t\tPresentationEvents = {},\n\t\tPresentationCount = 0,\n\t\tPresentationTokens = RATE_BURST,\n\t\tPresentationLastAt = d.Now(),\n\t}\n\tlocal cards = {}\n\tfor _, offer in d.Catalogue.GetAll() do\n\t\tlocal target, targetReason = d.ResolveTarget(player, offer)\n\t\tlocal card = cardFor(player, data, offer, target)\n\t\tif targetReason ~= nil and card.primaryExplanation == nil then\n\t\t\tcard.primaryExplanation = targetReason\n\t\t\tcard.state = \"Unavailable\"\n\t\t\tcard.canActivate = false\n\t\t\tcard.actionLabel = \"Unavailable\"\n\t\tend\n\t\tcontext.Terms[offer.id] = {\n\t\t\tOffer = offer,\n\t\t\tTarget = target,\n\t\t\tSignature = termSignature(offer, target),\n\t\t\tMeasurementKey = measurementKey(offer, target),\n\t\t}\n\t\ttable.insert(cards, card)\n\tend\n\tcontexts[player] = context\n\tlocal balance = data.Economy and data.Economy.Balance\n\tlocal payload = {\n\t\tcontextId = contextId,\n\t\texpiresAtServerTime = context.ExpiresAt,\n\t\tbalance = if finiteNonNegative(balance) then balance else nil,\n\t\toffers = cards,\n\t}\n\tif openRemote then\n\t\topenRemote:FireClient(player, payload)\n\tend\n\tlocal offerKeys = {}\n\tfor _, offer in d.Catalogue.GetAll() do\n\t\tlocal term = context.Terms[offer.id]\n\t\tif term then\n\t\t\ttable.insert(offerKeys, term.MeasurementKey)\n\t\tend\n\tend\n\tnotifyObservation(player, {\n\t\tkind = \"ContextIssued\",\n\t\teventId = contextId,\n\t\tat = d.Now(),\n\t\tcontextId = contextId,\n\t\tsessionGeneration = session.Generation,\n\t\tofferKeys = table.freeze(offerKeys),\n\t})\n\tlog:Info(\"UpgradeShopOpened userId=%d contextId=%s offers=%d\", player.UserId, contextId, #cards)\n\treturn { ok = true, code = \"OPENED\", payload = payload }\nend\n\nfunction UpgradeService:GetMeasurementOffers(player: Player): { any }\n\tlocal d = deps()\n\tlocal data = d.Profile:GetReadableData(player)\n\tif data == nil then\n\t\treturn {}\n\tend\n\tlocal result = {}\n\tfor _, offer in d.Catalogue.GetAll() do\n\t\tlocal target, targetReason = d.ResolveTarget(player, offer)\n\t\tlocal snapshot = d.BuildPlayerSnapshot(player, data, target)\n\t\tlocal decomposition = d.Eligibility.DecomposeOffer(offer, snapshot, target, d.Readiness)\n\t\ttable.insert(\n\t\t\tresult,\n\t\t\ttable.freeze({\n\t\t\t\tofferId = offer.id,\n\t\t\t\ttargetKey = targetIdentity(target),\n\t\t\t\ttermsVersion = measurementTermsVersion(offer, target),\n\t\t\t\tofferKey = measurementKey(offer, target),\n\t\t\t\tprice = offer.price,\n\t\t\t\towned = decomposition.owned,\n\t\t\t\tfundsSufficient = decomposition.fundsSufficient,\n\t\t\t\tready = decomposition.ready and targetReason == nil,\n\t\t\t\tprerequisitesSatisfied = decomposition.prerequisitesSatisfied,\n\t\t\t\tpathBlocked = decomposition.pathBlocked or targetReason ~= nil,\n\t\t\t\tprimaryReason = targetReason or decomposition.primaryReason,\n\t\t\t})\n\t\t)\n\tend\n\treturn result\nend\n\nlocal function validateContext(player: Player, contextId: string): (any?, string?)\n\tlocal context = contexts[player]\n\tif context == nil or context.Id ~= contextId then\n\t\treturn nil, \"INVALID_CONTEXT\"\n\tend\n\tif deps().Now() >= context.ExpiresAt then\n\t\tinvalidateContext(player, \"CONTEXT_EXPIRED\")\n\t\treturn nil, \"CONTEXT_EXPIRED\"\n\tend\n\tif not sessionIsCurrent(player, context.Session) or not deps().Profile:IsWritable(player) then\n\t\tinvalidateContext(player, \"SESSION_CHANGED\")\n\t\treturn nil, \"SESSION_CHANGED\"\n\tend\n\tif deps().WorldReady(player) ~= true then\n\t\tinvalidateContext(player, \"WORLD_NOT_READY\")\n\t\treturn nil, \"WORLD_NOT_READY\"\n\tend\n\tif not context.Shop:IsDescendantOf(Workspace) or not withinShopRange(player, context.Shop) then\n\t\treturn nil, \"TOO_FAR_AWAY\"\n\tend\n\treturn context, nil\nend\n\nlocal function rejectionFromEvaluation(evaluation: any): string\n\tif evaluation.outcome == \"Owned\" then\n\t\treturn \"ALREADY_OWNED\"\n\telseif evaluation.outcome == \"InsufficientFunds\" then\n\t\treturn \"INSUFFICIENT_FUNDS\"\n\telseif evaluation.primaryReason and evaluation.primaryReason.code then\n\t\treturn evaluation.primaryReason.code\n\tend\n\treturn string.upper(tostring(evaluation.outcome or \"UNAVAILABLE\"))\nend\n\nfunction UpgradeService:Purchase(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal contextId = payload.contextId\n\tlocal requestId = payload.requestId\n\tlocal offerId = payload.offerId\n\tif\n\t\tnot nonEmptyBoundedString(contextId)\n\t\tor not nonEmptyBoundedString(requestId)\n\t\tor not nonEmptyBoundedString(offerId)\n\tthen\n\t\treturn failure(\"INVALID_REQUEST\", if type(requestId) == \"string\" then requestId else nil)\n\tend\n\tlocal contextForSignature = contexts[player]\n\tlocal target = if contextForSignature and contextForSignature.Terms[offerId]\n\t\tthen contextForSignature.Terms[offerId].Target\n\t\telse nil\n\tlocal signature = requestSignature(contextId, offerId, target)\n\tlocal duplicate = cachedResult(player, requestId, signature)\n\tif duplicate then\n\t\tlog:Debug(\n\t\t\t\"UpgradePurchaseDuplicate userId=%d offerId=%s requestId=%s\",\n\t\t\tplayer.UserId,\n\t\t\tofferId,\n\t\t\trequestId\n\t\t)\n\t\treturn duplicate\n\tend\n\tif not consumeRateToken(player) then\n\t\tlocal result = failure(\"RATE_LIMITED\", requestId)\n\t\trememberResult(player, requestId, signature, result, nil)\n\t\treturn result\n\tend\n\tlocal context, contextReason = validateContext(player, contextId)\n\tif context == nil then\n\t\tlocal result = failure(contextReason or \"INVALID_CONTEXT\", requestId)\n\t\trememberResult(player, requestId, signature, result, nil)\n\t\treturn result\n\tend\n\tlocal presented = context.Terms[offerId]\n\tlocal offer = currentOffer(offerId)\n\tif presented == nil or offer == nil then\n\t\tlocal result = failure(\"UNKNOWN_OFFER\", requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\tif termSignature(offer, presented.Target) ~= presented.Signature then\n\t\tlocal result = failure(\"OFFER_CHANGED\", requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\n\tlocal d = deps()\n\tlocal data = d.Profile:GetWritableData(player)\n\tif data == nil then\n\t\tlocal result = failure(\"PROFILE_NOT_READY\", requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\tlocal evaluation = buildEvaluation(player, data, offer, presented.Target)\n\tif evaluation.outcome ~= \"Available\" then\n\t\tlocal result = failure(rejectionFromEvaluation(evaluation), requestId)\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\tlog:Info(\n\t\t\t\"UpgradePurchaseRejected userId=%d offerId=%s requestId=%s code=%s\",\n\t\t\tplayer.UserId,\n\t\t\tofferId,\n\t\t\trequestId,\n\t\t\tresult.code\n\t\t)\n\t\treturn result\n\tend\n\n\tlocal balanceBefore: number? = nil\n\tlocal committedAt: number? = nil\n\tlocal commit = d.Profile:CommitMutation(player, function(currentData)\n\t\tlocal currentEvaluation = buildEvaluation(player, currentData, offer, presented.Target)\n\t\tif currentEvaluation.outcome ~= \"Available\" then\n\t\t\treturn false, failure(rejectionFromEvaluation(currentEvaluation), requestId)\n\t\tend\n\t\tlocal prepared = d.Currency:PrepareSpend(currentData, offer.price)\n\t\tif prepared.ok ~= true then\n\t\t\treturn false, failure(prepared.code or \"INVALID_COST\", requestId)\n\t\tend\n\t\tbalanceBefore = currentData.Economy.Balance\n\t\tlocal granted, grantReason = d.ApplyGrant(currentData, offer, presented.Target)\n\t\tif granted ~= true then\n\t\t\treturn false, failure(grantReason or \"GRANT_REJECTED\", requestId)\n\t\tend\n\t\tcurrentData.Economy.Balance = prepared.balance\n\t\tcommittedAt = d.Now()\n\t\treturn true,\n\t\t\t{\n\t\t\t\tok = true,\n\t\t\t\toutcome = \"Accepted\",\n\t\t\t\tcode = \"PURCHASE_ACCEPTED\",\n\t\t\t\trequestId = requestId,\n\t\t\t\tofferId = offer.id,\n\t\t\t\tchargedAmount = offer.price,\n\t\t\t\tbalance = prepared.balance,\n\t\t\t\tpersistence = \"Pending\",\n\t\t\t}\n\tend)\n\tif type(commit) ~= \"table\" or commit.ok ~= true or commit.committed ~= true then\n\t\tlocal result = if type(commit) == \"table\"\n\t\t\tthen commit\n\t\t\telse failure(\"MUTATION_FAILED\", requestId)\n\t\tresult.requestId = requestId\n\t\tresult.outcome = result.outcome or \"Rejected\"\n\t\trememberResult(player, requestId, signature, result, context.Session)\n\t\treturn result\n\tend\n\tcommit.commitRevision = commit.revision\n\tcommit.persistence = \"Pending\"\n\trememberResult(player, requestId, signature, commit, context.Session)\n\tobservationOperationSequence += 1\n\tlocal committedMeasurementKey = measurementKey(offer, presented.Target)\n\tlocal remembered = requestCaches[player] and requestCaches[player].ById[requestId]\n\tif remembered then\n\t\tremembered.MeasurementKey = committedMeasurementKey\n\t\tremembered.CommittedAt = committedAt\n\t\tremembered.OperationSequence = observationOperationSequence\n\tend\n\t-- Capture committed values before any effect listener or save can run. Direct\n\t-- server purchases and client requests use this same canonical receipt.\n\tnotifyObservation(player, {\n\t\tkind = \"PurchaseCommitted\",\n\t\teventId = requestId,\n\t\tat = committedAt,\n\t\tcontextId = context.Id,\n\t\trequestId = requestId,\n\t\tofferId = offer.id,\n\t\tofferKey = committedMeasurementKey,\n\t\ttargetKey = targetIdentity(presented.Target),\n\t\ttermsVersion = measurementTermsVersion(offer, presented.Target),\n\t\tprice = offer.price,\n\t\tcurrencyId = offer.currencyId,\n\t\townershipScope = offer.ownershipScope.kind,\n\t\tchargedAmount = commit.chargedAmount,\n\t\tbalanceBefore = balanceBefore,\n\t\tbalanceAfter = commit.balance,\n\t\tcommitRevision = commit.revision,\n\t\tsessionGeneration = context.Session.Generation,\n\t\toperationSequence = observationOperationSequence,\n\t\tready = true,\n\t\tprerequisitesSatisfied = true,\n\t\tfundsSufficient = true,\n\t\taccepted = true,\n\t\tpersistence = \"Pending\",\n\t})\n\tpcall(d.Currency.SyncBalance, d.Currency, player)\n\t-- Effects rederive from committed ownership outside the profile mutation. A\n\t-- listener failure cannot repeat, roll back, or partially re-run the purchase.\n\tpurchaseCommittedEvent:Fire(player, offer, presented.Target, commit.revision)\n\tlocal saveRequest = d.Profile:RequestSave(player, \"UpgradePurchase:\" .. offer.id)\n\tif type(saveRequest) ~= \"table\" or saveRequest.ok ~= true then\n\t\tcommit.persistence = \"Delayed\"\n\tend\n\tlog:Info(\n\t\t\"UpgradePurchaseCommitted userId=%d offerId=%s requestId=%s revision=%d\",\n\t\tplayer.UserId,\n\t\toffer.id,\n\t\trequestId,\n\t\tcommit.revision\n\t)\n\treturn table.clone(commit)\nend\n\nfunction UpgradeService:GetRequestStatus(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal contextId, requestId, offerId = payload.contextId, payload.requestId, payload.offerId\n\tif\n\t\tnot nonEmptyBoundedString(contextId)\n\t\tor not nonEmptyBoundedString(requestId)\n\t\tor not nonEmptyBoundedString(offerId)\n\tthen\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal context = contexts[player]\n\tlocal target = if context and context.Terms[offerId] then context.Terms[offerId].Target else nil\n\tlocal signature = requestSignature(contextId, offerId, target)\n\tlocal cached = cachedResult(player, requestId, signature)\n\treturn cached or failure(\"REQUEST_STATUS_UNKNOWN\", requestId)\nend\n\nfunction UpgradeService:SubscribePurchaseCommitted(\n\tcallback: (Player, any, any, number) -> ()\n): RBXScriptConnection\n\treturn purchaseCommittedEvent.Event:Connect(callback)\nend\n\nfunction UpgradeService:SubscribeObservations(callback: (Player, any) -> ()): any\n\tlocal connection = {}\n\tobservationListeners[connection] = callback\n\tfunction connection.Disconnect()\n\t\tobservationListeners[connection] = nil\n\tend\n\treturn connection\nend\n\nfunction UpgradeService:ObservePresentation(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" or not nonEmptyBoundedString(payload.contextId) then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tfor key in payload do\n\t\tif\n\t\t\tkey ~= \"operation\"\n\t\t\tand key ~= \"contextId\"\n\t\t\tand key ~= \"kind\"\n\t\t\tand key ~= \"inputCategory\"\n\t\t\tand key ~= \"offerId\"\n\t\tthen\n\t\t\treturn failure(\"INVALID_REQUEST\")\n\t\tend\n\tend\n\tif payload.operation ~= nil and payload.operation ~= \"Presentation\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal kind = payload.kind\n\tif kind ~= \"MenuRendered\" and kind ~= \"OfferInspected\" then\n\t\treturn failure(\"INVALID_PRESENTATION_EVENT\")\n\tend\n\tif\n\t\t(kind == \"MenuRendered\" and payload.offerId ~= nil)\n\t\tor (kind == \"OfferInspected\" and not nonEmptyBoundedString(payload.offerId))\n\tthen\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tlocal inputCategory = payload.inputCategory\n\tlocal validInput = inputCategory == \"Desktop\"\n\t\tor inputCategory == \"Touch\"\n\t\tor inputCategory == \"Gamepad\"\n\t\tor inputCategory == \"Hybrid\"\n\t\tor inputCategory == \"Unknown\"\n\tif not validInput then\n\t\treturn failure(\"INVALID_INPUT_CATEGORY\")\n\tend\n\tlocal context = contexts[player]\n\tif context == nil or context.Id ~= payload.contextId then\n\t\treturn failure(\"INVALID_CONTEXT\")\n\tend\n\t-- Presentation has its own bounded budget; an analytics burst cannot consume\n\t-- the player's gameplay purchase tokens. Duplicates still consume this budget.\n\tlocal currentTime = deps().Now()\n\tlocal elapsed = math.max(0, currentTime - context.PresentationLastAt)\n\tcontext.PresentationLastAt = currentTime\n\tcontext.PresentationTokens =\n\t\tmath.min(RATE_BURST, context.PresentationTokens + elapsed * RATE_REFILL_PER_SECOND)\n\tif context.PresentationTokens < 1 or context.PresentationCount >= 64 then\n\t\treturn failure(\"RATE_LIMITED\")\n\tend\n\tcontext.PresentationTokens -= 1\n\tcontext.PresentationCount += 1\n\tlocal validatedContext, contextReason = validateContext(player, payload.contextId)\n\tif validatedContext == nil then\n\t\treturn failure(contextReason or \"INVALID_CONTEXT\")\n\tend\n\tlocal term = nil\n\tif kind == \"OfferInspected\" then\n\t\tterm = context.Terms[payload.offerId]\n\t\tif term == nil then\n\t\t\treturn failure(\"UNKNOWN_OFFER\")\n\t\tend\n\tend\n\tlocal dedupKey = kind .. \":\" .. tostring(payload.offerId or \"menu\")\n\tif not context.PresentationEvents[dedupKey] then\n\t\tcontext.PresentationEvents[dedupKey] = true\n\t\tnotifyObservation(player, {\n\t\t\tkind = kind,\n\t\t\teventId = context.Id .. \":\" .. dedupKey,\n\t\t\tat = deps().Now(),\n\t\t\tcontextId = context.Id,\n\t\t\tsessionGeneration = context.Session.Generation,\n\t\t\tofferId = payload.offerId,\n\t\t\tofferKey = if term then term.MeasurementKey else nil,\n\t\t\tinputCategory = inputCategory,\n\t\t})\n\tend\n\treturn { ok = true, code = \"RECORDED\" }\nend\n\nfunction UpgradeService:HandleRequest(player: Player, payload: any): any\n\tif type(payload) ~= \"table\" then\n\t\treturn failure(\"INVALID_REQUEST\")\n\tend\n\tif payload.operation == \"Purchase\" then\n\t\tlocal context = contexts[player]\n\t\tlocal validObservation = context ~= nil\n\t\t\tand context.Id == payload.contextId\n\t\t\tand nonEmptyBoundedString(payload.contextId)\n\t\t\tand nonEmptyBoundedString(payload.requestId)\n\t\t\tand nonEmptyBoundedString(payload.offerId)\n\t\t\tand sessionIsCurrent(player, context.Session)\n\t\tlocal term = if validObservation then context.Terms[payload.offerId] else nil\n\t\tlocal cache = requestCaches[player]\n\t\tlocal replayed = cache ~= nil and cache.ById[payload.requestId] ~= nil\n\t\tif term and not replayed then\n\t\t\tnotifyObservation(player, {\n\t\t\t\tkind = \"PurchaseAttempt\",\n\t\t\t\teventId = payload.requestId,\n\t\t\t\tat = deps().Now(),\n\t\t\t\tcontextId = payload.contextId,\n\t\t\t\trequestId = payload.requestId,\n\t\t\t\tofferId = payload.offerId,\n\t\t\t\tofferKey = term.MeasurementKey,\n\t\t\t\tsessionGeneration = context.Session.Generation,\n\t\t\t})\n\t\tend\n\t\tlocal result = self:Purchase(player, payload)\n\t\tif term and not replayed and result.outcome ~= \"Accepted\" then\n\t\t\tnotifyObservation(player, {\n\t\t\t\tkind = \"PurchaseResult\",\n\t\t\t\teventId = payload.requestId,\n\t\t\t\tat = deps().Now(),\n\t\t\t\tcontextId = payload.contextId,\n\t\t\t\trequestId = payload.requestId,\n\t\t\t\tofferId = payload.offerId,\n\t\t\t\tofferKey = term.MeasurementKey,\n\t\t\t\taccepted = false,\n\t\t\t\tcode = result.code,\n\t\t\t\tsessionGeneration = context.Session.Generation,\n\t\t\t})\n\t\tend\n\t\treturn result\n\telseif payload.operation == \"Status\" then\n\t\treturn self:GetRequestStatus(player, payload)\n\telseif payload.operation == \"Presentation\" then\n\t\treturn self:ObservePresentation(player, payload)\n\tend\n\treturn failure(\"INVALID_OPERATION\")\nend\n\nfunction UpgradeService:CloseShop(player: Player, contextId: any): boolean\n\tlocal context = contexts[player]\n\tif context == nil then\n\t\treturn false\n\tend\n\tif contextId ~= nil and contextId ~= context.Id then\n\t\treturn false\n\tend\n\tinvalidateContext(player, \"CLIENT_CLOSED\")\n\treturn true\nend\n\nlocal function ensureRemote(className: string, name: string): Instance\n\tlocal remotes = ReplicatedStorage:FindFirstChild(\"Remotes\")\n\tif not remotes then\n\t\tremotes = Instance.new(\"Folder\")\n\t\tremotes.Name = \"Remotes\"\n\t\tremotes.Parent = ReplicatedStorage\n\tend\n\tlocal remote = remotes:FindFirstChild(name)\n\tif not remote then\n\t\tremote = Instance.new(className)\n\t\tremote.Name = name\n\t\tremote.Parent = remotes\n\tend\n\tassert(remote.ClassName == className, name .. \" must be a \" .. className)\n\treturn remote\nend\n\nlocal function onSaveConfirmed(player: Player, savedRevision: number, _currentRevision: number)\n\tlocal cache = requestCaches[player]\n\tif cache == nil then\n\t\treturn\n\tend\n\tlocal currentSession = deps().Profile:GetSessionHandle(player)\n\tfor _, entry in cache.ById do\n\t\tlocal result = entry.Result\n\t\tif\n\t\t\tsameSession(entry.Session, currentSession)\n\t\t\tand result.outcome == \"Accepted\"\n\t\t\tand type(result.commitRevision) == \"number\"\n\t\t\tand savedRevision >= result.commitRevision\n\t\t\tand result.persistence ~= \"Confirmed\"\n\t\tthen\n\t\t\tresult.persistence = \"Confirmed\"\n\t\t\tif updateRemote then\n\t\t\t\tupdateRemote:FireClient(player, {\n\t\t\t\t\tkind = \"PurchasePersistence\",\n\t\t\t\t\trequestId = result.requestId,\n\t\t\t\t\tofferId = result.offerId,\n\t\t\t\t\tcommitRevision = result.commitRevision,\n\t\t\t\t\tpersistence = \"Confirmed\",\n\t\t\t\t})\n\t\t\tend\n\t\t\tlog:Info(\n\t\t\t\t\"UpgradePurchaseSaveConfirmed userId=%d offerId=%s requestId=%s revision=%d\",\n\t\t\t\tplayer.UserId,\n\t\t\t\tresult.offerId,\n\t\t\t\tresult.requestId,\n\t\t\t\tresult.commitRevision\n\t\t\t)\n\t\t\tif entry.MeasurementKey then\n\t\t\t\t-- Cache iteration is not purchase order. Sequence this observation at\n\t\t\t\t-- delivery so a covering save can confirm every committed purchase.\n\t\t\t\tobservationOperationSequence += 1\n\t\t\t\tnotifyObservation(player, {\n\t\t\t\t\tkind = \"PurchaseSaveConfirmed\",\n\t\t\t\t\teventId = tostring(result.requestId) .. \":saved\",\n\t\t\t\t\tat = deps().Now(),\n\t\t\t\t\trequestId = result.requestId,\n\t\t\t\t\tofferId = result.offerId,\n\t\t\t\t\tofferKey = entry.MeasurementKey,\n\t\t\t\t\tcommitRevision = result.commitRevision,\n\t\t\t\t\tsessionGeneration = entry.Session.Generation,\n\t\t\t\t\toperationSequence = observationOperationSequence,\n\t\t\t\t\tpurchaseOperationSequence = entry.OperationSequence,\n\t\t\t\t\tcommittedAt = entry.CommittedAt,\n\t\t\t\t})\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction UpgradeService:Init(options: any?)\n\tassert(not started, \"Cannot replace UpgradeService dependencies after Start\")\n\tlocal base = defaultDependencies()\n\tfor key, value in options or {} do\n\t\tbase[key] = value\n\tend\n\tdependencies = base\nend\n\nfunction UpgradeService:Start(options: any?): boolean\n\tif started then\n\t\treturn false\n\tend\n\tif options or dependencies == nil then\n\t\tself:Init(options)\n\tend\n\tstarted = true\n\topenRemote = ensureRemote(\"RemoteEvent\", RemoteNames.OpenCartUpgradeShop) :: RemoteEvent\n\trequestRemote =\n\t\tensureRemote(\"RemoteFunction\", RemoteNames.CartUpgradeShopRequest) :: RemoteFunction\n\tcloseRemote = ensureRemote(\"RemoteEvent\", RemoteNames.CloseCartUpgradeShop) :: RemoteEvent\n\tupdateRemote = ensureRemote(\"RemoteEvent\", RemoteNames.CartUpgradeShopUpdate) :: RemoteEvent\n\trequestHandler = function(player, payload)\n\t\treturn UpgradeService:HandleRequest(player, payload)\n\tend\n\trequestRemote.OnServerInvoke = requestHandler\n\ttable.insert(\n\t\tconnections,\n\t\t(closeRemote :: RemoteEvent).OnServerEvent:Connect(function(player, contextId)\n\t\t\tUpgradeService:CloseShop(player, contextId)\n\t\tend)\n\t)\n\ttable.insert(\n\t\tconnections,\n\t\tPlayers.PlayerRemoving:Connect(function(player)\n\t\t\tinvalidateContext(player, \"PLAYER_REMOVING\")\n\t\t\trequestCaches[player] = nil\n\t\t\trateStates[player] = nil\n\t\tend)\n\t)\n\tlocal saveSignal = deps().Profile.SubscribeSaveConfirmed\n\tif saveSignal then\n\t\ttable.insert(connections, deps().Profile:SubscribeSaveConfirmed(onSaveConfirmed))\n\tend\n\treturn true\nend\n\nfunction UpgradeService:Stop()\n\tif requestRemote and requestRemote.OnServerInvoke == requestHandler then\n\t\trequestRemote.OnServerInvoke = nil\n\tend\n\tfor _, connection in connections do\n\t\tconnection:Disconnect()\n\tend\n\ttable.clear(connections)\n\ttable.clear(contexts)\n\ttable.clear(requestCaches)\n\ttable.clear(rateStates)\n\topenRemote, requestRemote, closeRemote, updateRemote, requestHandler = nil, nil, nil, nil, nil\n\tdependencies = nil\n\tstarted = false\n\tobservationOperationSequence = 0\nend\n\nfunction UpgradeService:_TestConfirmSave(player: Player, savedRevision: number)\n\tonSaveConfirmed(player, savedRevision, savedRevision)\nend\n\nfunction UpgradeService:_TestGetContext(player: Player): any?\n\treturn contexts[player]\nend\n\nreturn UpgradeService\n"}],"newModule":{"path":"ReplicatedStorage.Shared.Utility.CompactMapGeometry","class":"ModuleScript","afterSHA256":"b01607e4734d92dff22452b6f92cac104cb00e9d1436bb562331f1f9c7801c8f","afterBytes":12840,"proposal":"docs/map-compaction/source-patches/proposals/ReplicatedStorage/Shared/Utility/CompactMapGeometry.lua","source":"--!strict\n-- Read-only CompactMap_V1 runtime geometry. Values are final locals, never scaled again.\nlocal HttpService = game:GetService(\"HttpService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Geometry = {}\nlocal MIGRATION = \"CompactMap_V1\"\nlocal MAX_BYTES, MAX_WALLS, CELL_SIZE, MAX_CELLS = 200000, 512