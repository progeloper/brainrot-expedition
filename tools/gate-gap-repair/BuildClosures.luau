assert(game.PlaceId==91958083796436 and game.GameId==10548905405 and not game.RunService:IsRunning(),'DEV Edit only')
local B=assert(shared.GateGapRepairBaseline,'Capture reviewed baseline first')
local map=workspace.MapBlockout
local old=map:FindFirstChild('GateApertureClosures')
if old then assert(old:GetAttribute('Revision')==1,'Unexpected existing closure group');return {alreadyInstalled=true,changes=0} end
local Materials=require(game.ReplicatedStorage.Shared.Utility.EnvironmentStudMaterialPolicy)
local History=game.ChangeHistoryService local recording=History:TryBeginRecording('SealRegionGateApertures')
local backup=Instance.new('Folder') backup.Name='GateApertureRepair_Backup_v1' backup:SetAttribute('NoRuntimeUse',true) backup:SetAttribute('CreatedAt',B.createdAt) backup.Parent=game.ServerStorage
for _,gate in map.ProgressionGates:GetChildren() do
 local copy=gate:Clone() copy.Name='Before_'..gate.Name copy:SetAttribute('NoRuntimeUse',true)
 local all=copy:GetDescendants() table.insert(all,copy)
 for _,n in all do for _,tag in game.CollectionService:GetTags(n) do game.CollectionService:RemoveTag(n,tag) end end
 copy.Parent=backup
end
local provenance=Instance.new('StringValue') provenance.Name='BaselineDigests' provenance.Value=game.HttpService:JSONEncode({sourceDigest=B.sourceDigest,sourceCount=B.sourceCount,protectedDigest=B.protected.digest,worldDigest=B.world.digest,worldInstances=B.world.count,createdAt=B.createdAt}) provenance.Parent=backup
local metadata=Instance.new('StringValue') metadata.Name='CompactMapRuntimeGeometry_Before' metadata.Value=B.runtimeValue metadata.Parent=backup
local root=Instance.new('Folder') root.Name='GateApertureClosures' root:SetAttribute('Revision',1) root:SetAttribute('GeneratedBy','GateApertureRepair_v1') root.Parent=map
local manifest=Instance.new('StringValue') manifest.Name='ClosureManifest' manifest.Value=game.HttpService:JSONEncode(plans) manifest.Parent=backup
local result={envelopes=0,collisionCores=0,visibleBricks=0,rows={}}
local function partitions(lo,hi,maximum,shift)
 local out={} local current=lo local first=true
 while current<hi-1e-7 do
  local step=if first and shift>0 then shift else maximum
  local nextValue=math.min(hi,current+step)
  table.insert(out,{current,nextValue}) current=nextValue first=false
 end
 return out
end
for _,spec in plans do
 local gate=assert(map.ProgressionGates:FindFirstChild(spec.gate))
 local header=assert(map.EnvironmentArt_V2:FindFirstChild('Gate_'..spec.gate..'_Header_01'))
 local style=assert(header:FindFirstChild('GateLintel_A'))
 local group=Instance.new('Model') group.Name=spec.id group:SetAttribute('GateName',spec.gate) group:SetAttribute('ClosureKind',spec.kind) group:SetAttribute('GeneratedBy','GateApertureRepair_v1') group:SetAttribute('EnvelopeCFrame',CFrame.new(table.unpack(spec.nativeCFrame))) group:SetAttribute('EnvelopeSize',Vector3.new(table.unpack(spec.worldSize)))
 local center=Vector3.new(table.unpack(spec.worldPosition)) local size=Vector3.new(table.unpack(spec.worldSize))
 local core=Instance.new('Part') core.Name='CollisionCore' core.Size=size core.CFrame=CFrame.new(table.unpack(spec.nativeCFrame)) core.Anchored=true core.CanCollide=true core.CanQuery=true core.CanTouch=false core.Transparency=1 core.CastShadow=false core.CollisionGroup='Default' core:SetAttribute('EnvironmentRole','Collider') core:SetAttribute('EnvironmentColliderId','GateApertureRepair_'..spec.id) core.Parent=group
 local lo=center-size/2 local hi=center+size/2
 local ys=partitions(lo.Y,hi.Y,4,0)
 local bricks=0
 for yi,y in ys do
  local xs=partitions(lo.X,hi.X,8,if yi%2==0 then 4 else 0)
  local zs=partitions(lo.Z,hi.Z,8,if yi%2==0 then 4 else 0)
  for xi,x in xs do for zi,z in zs do
   local brick=Instance.new('Part') brick.Name=string.format('Brick_%02d_%02d_%02d',yi,xi,zi)
   brick.Size=Vector3.new(x[2]-x[1],y[2]-y[1],z[2]-z[1]) brick.CFrame=CFrame.new((x[1]+x[2])/2,(y[1]+y[2])/2,(z[1]+z[2])/2)
   brick.Anchored=true brick.CanCollide=false brick.CanQuery=false brick.CanTouch=false brick.CastShadow=true
   local tint=if (xi+zi+yi)%3==0 then .96 else 1
   brick.Color=Color3.new(style.Color.R*tint,style.Color.G*tint,style.Color.B*tint)
   brick.TopSurface=Enum.SurfaceType.Smooth brick.BottomSurface=Enum.SurfaceType.Smooth
   assert(Materials.Apply(brick,Enum.Material.SmoothPlastic),'Saved studs must apply on each visible brick')
   brick:SetAttribute('EnvironmentRole','VisibleBrick') brick:SetAttribute('GeneratedBy','GateApertureRepair_v1') brick.Parent=group bricks+=1
  end end
 end
 assert(#group:GetDescendants()<1000,'Keep each native insertion bounded')
 group.Parent=root
 result.envelopes+=1 result.collisionCores+=1 result.visibleBricks+=bricks
 table.insert(result.rows,{id=spec.id,gate=spec.gate,kind=spec.kind,bricks=bricks,size=spec.worldSize,frame=spec.nativeCFrame})
 task.wait()
end
if recording then History:FinishRecording(recording,Enum.FinishRecordingOperation.Commit) end
B.installed=root B.backup=backup B.buildResult=result
assert(result.envelopes==22,'Expected12jambs+4returns+6upperbridges')
